          "on_death": "query.last_hit_by_player ? math.random(1, 3) : 0"
        },
        "minecraft:breedable": {
          "require_tame": false,
          "breed_items": [
            "wheat"
          ],
          "breeds_with": {
            "mate_type": "alexsmobs:rain_frog",
