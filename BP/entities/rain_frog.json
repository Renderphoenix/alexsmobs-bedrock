              "event": "minecraft:entity_born",
              "target": "baby"
            }
          }
        },
        "minecraft:behavior.breed": {
          "priority": 2,
          "speed_multiplier": 1
        }
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 0.55,
        "height": 0.5
      },
      "minecraft:health": {
        "value": 6,
        "max": 6
      },
      "minecraft:movement": {
        "value": 0.2
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:physics": {},
