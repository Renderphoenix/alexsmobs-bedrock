{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:farseer",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/farseer/farseer",
        "glow": "textures/entity/alexsmobs/farseer/farseer_eye"
      },
      "geometry": {
        "default": "geometry.alexsmobs.farseer"
      },
      "animations": {
        "idle": "animation.alexsmobs.farseer.idle",
        "breathe": "animation.alexsmobs.farseer.breathe",
        "fly": "animation.alexsmobs.farseer.fly",
        "look": "animation.alexsmobs.farseer.look",
        "baby": "animation.alexsmobs.farseer.baby",
        "emerge": "animation.alexsmobs.farseer.emerge",
        "attack_bite": "animation.alexsmobs.farseer.attack_bite",
        "death_0": "animation.alexsmobs.farseer.death_0",
        "death_1": "animation.alexsmobs.farseer.death_1",
        "hurt": "animation.alexsmobs.farseer.hurt",
        "idle_look": "animation.alexsmobs.farseer.idle_look",
        "idle_sniff": "animation.alexsmobs.farseer.idle_sniff",
        "idle_shake": "animation.alexsmobs.farseer.idle_shake",
        "ctrl_move": "controller.animation.alexsmobs.farseer.move",
        "ctrl_attack": "controller.animation.alexsmobs.farseer.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.farseer.hurt",
        "ctrl_death": "controller.animation.alexsmobs.farseer.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.56;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.314999994635582, 0.35, 2.4);",
          "v.am_flying = 1;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.farseer",
        "controller.render.alexsmobs.farseer.glow"
      ],
      "spawn_egg": {
        "base_color": "#33374f",
        "overlay_color": "#91ff59"
      },
      "enable_attachables": false
    }
  }
}
