{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:bone_serpent",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/bone_serpent_head"
      },
      "geometry": {
        "default": "geometry.alexsmobs.bone_serpent"
      },
      "animations": {
        "idle": "animation.alexsmobs.bone_serpent.idle",
        "breathe": "animation.alexsmobs.bone_serpent.breathe",
        "walk": "animation.alexsmobs.bone_serpent.walk",
        "run": "animation.alexsmobs.bone_serpent.run",
        "look": "animation.alexsmobs.bone_serpent.look",
        "baby": "animation.alexsmobs.bone_serpent.baby",
        "attack_bite": "animation.alexsmobs.bone_serpent.attack_bite",
        "death_0": "animation.alexsmobs.bone_serpent.death_0",
        "death_1": "animation.alexsmobs.bone_serpent.death_1",
        "hurt": "animation.alexsmobs.bone_serpent.hurt",
        "idle_look": "animation.alexsmobs.bone_serpent.idle_look",
        "idle_sniff": "animation.alexsmobs.bone_serpent.idle_sniff",
        "ctrl_move": "controller.animation.alexsmobs.bone_serpent.move",
        "ctrl_idles": "controller.animation.alexsmobs.bone_serpent.idles",
        "ctrl_attack": "controller.animation.alexsmobs.bone_serpent.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.bone_serpent.hurt",
        "ctrl_death": "controller.animation.alexsmobs.bone_serpent.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.9;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.6, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.bone_serpent"
      ],
      "spawn_egg": {
        "base_color": "#e5d9c4",
        "overlay_color": "#ff6038"
      },
      "enable_attachables": false
    }
  }
}
