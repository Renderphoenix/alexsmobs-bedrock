        "idle_shake": "animation.alexsmobs.flutter.idle_shake",
        "ctrl_move": "controller.animation.alexsmobs.flutter.move",
        "ctrl_attack": "controller.animation.alexsmobs.flutter.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.flutter.hurt",
        "ctrl_death": "controller.animation.alexsmobs.flutter.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.073;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18899999409914017, 0.35, 2.4);",
          "v.am_flying = 1;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.flutter",
        "controller.render.alexsmobs.flutter.glow"
      ],
      "spawn_egg": {
