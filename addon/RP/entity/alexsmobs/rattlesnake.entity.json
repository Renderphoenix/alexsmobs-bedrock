{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:rattlesnake",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/rattlesnake"
      },
      "geometry": {
        "default": "geometry.alexsmobs.rattlesnake"
      },
      "animations": {
        "idle": "animation.alexsmobs.rattlesnake.idle",
        "breathe": "animation.alexsmobs.rattlesnake.breathe",
        "walk": "animation.alexsmobs.rattlesnake.walk",
        "run": "animation.alexsmobs.rattlesnake.run",
        "look": "animation.alexsmobs.rattlesnake.look",
        "baby": "animation.alexsmobs.rattlesnake.baby",
        "bite": "animation.alexsmobs.rattlesnake.bite",
        "death_0": "animation.alexsmobs.rattlesnake.death_0",
        "death_1": "animation.alexsmobs.rattlesnake.death_1",
        "hurt": "animation.alexsmobs.rattlesnake.hurt",
        "idle_look": "animation.alexsmobs.rattlesnake.idle_look",
        "idle_sniff": "animation.alexsmobs.rattlesnake.idle_sniff",
        "idle_tail": "animation.alexsmobs.rattlesnake.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.rattlesnake.move",
        "ctrl_idles": "controller.animation.alexsmobs.rattlesnake.idles",
        "ctrl_attack": "controller.animation.alexsmobs.rattlesnake.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.rattlesnake.hurt",
        "ctrl_death": "controller.animation.alexsmobs.rattlesnake.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.098;",
          "v.is_sprinting = q.modified_move_speed >= 0.448;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.2520000010728836, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.rattlesnake"
      ],
      "spawn_egg": {
        "base_color": "#ceb994",
        "overlay_color": "#937a5b"
      },
      "enable_attachables": false
    }
  }
}
