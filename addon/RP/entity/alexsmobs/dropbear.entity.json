        "glow": "textures/entity/alexsmobs/dropbear_eyes"
      },
      "geometry": {
        "default": "geometry.alexsmobs.dropbear"
      },
      "animations": {
        "pose": "animation.alexsmobs.dropbear.pose",
        "bite": "animation.alexsmobs.dropbear.bite",
        "swipe_l": "animation.alexsmobs.dropbear.swipe_l",
        "swipe_r": "animation.alexsmobs.dropbear.swipe_r",
        "jumpup": "animation.alexsmobs.dropbear.jumpup",
        "death_0": "animation.alexsmobs.dropbear.death_0",
        "death_1": "animation.alexsmobs.dropbear.death_1",
        "hurt": "animation.alexsmobs.dropbear.hurt",
        "idle_look": "animation.alexsmobs.dropbear.idle_look",
        "idle_sniff": "animation.alexsmobs.dropbear.idle_sniff",
        "idle_shake": "animation.alexsmobs.dropbear.idle_shake",
        "ctrl_attack": "controller.animation.alexsmobs.dropbear.attack",
        "ctrl_idle": "controller.animation.alexsmobs.dropbear.idle",
        "ctrl_death": "controller.animation.alexsmobs.dropbear.death",
        "ctrl_hurt": "controller.animation.alexsmobs.dropbear.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 0;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;",
          "v.p_upsidedownprogress = math.clamp((v.p_upsidedownprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);"
        ],
        "animate": [
          "pose",
          "ctrl_attack",
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.dropbear",
        "controller.render.alexsmobs.dropbear.glow"
      ],
      "spawn_egg": {
        "base_color": "#8a2d35",
        "overlay_color": "#60a3a3"
      },
      "enable_attachables": false
    }
