{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:dropbear",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/dropbear",
        "glow": "textures/entity/alexsmobs/dropbear_eyes"
      },
      "geometry": {
        "default": "geometry.alexsmobs.dropbear"
      },
      "animations": {
        "idle": "animation.alexsmobs.dropbear.idle",
        "breathe": "animation.alexsmobs.dropbear.breathe",
        "walk": "animation.alexsmobs.dropbear.walk",
        "run": "animation.alexsmobs.dropbear.run",
        "look": "animation.alexsmobs.dropbear.look",
        "baby": "animation.alexsmobs.dropbear.baby",
        "bite": "animation.alexsmobs.dropbear.bite",
        "swipe_l": "animation.alexsmobs.dropbear.swipe_l",
        "swipe_r": "animation.alexsmobs.dropbear.swipe_r",
        "jumpup": "animation.alexsmobs.dropbear.jumpup",
        "death_0": "animation.alexsmobs.dropbear.death_0",
        "death_1": "animation.alexsmobs.dropbear.death_1",
        "hurt": "animation.alexsmobs.dropbear.hurt",
        "idle_look": "animation.alexsmobs.dropbear.idle_look",
        "idle_sniff": "animation.alexsmobs.dropbear.idle_sniff",
        "idle_shake": "animation.alexsmobs.dropbear.idle_shake",
        "air_jump": "animation.alexsmobs.dropbear.air_jump",
        "air_fall": "animation.alexsmobs.dropbear.air_fall",
        "air_land": "animation.alexsmobs.dropbear.air_land",
        "ctrl_move": "controller.animation.alexsmobs.dropbear.move",
        "ctrl_air": "controller.animation.alexsmobs.dropbear.air",
        "ctrl_idles": "controller.animation.alexsmobs.dropbear.idles",
        "ctrl_attack": "controller.animation.alexsmobs.dropbear.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.dropbear.hurt",
        "ctrl_death": "controller.animation.alexsmobs.dropbear.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.dropbear",
        "controller.render.alexsmobs.dropbear.glow"
      ],
      "spawn_egg": {
        "base_color": "#8a2d35",
        "overlay_color": "#60a3a3"
      },
      "enable_attachables": false
    }
  }
}
