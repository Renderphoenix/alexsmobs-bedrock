{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:soul_vulture",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/soul_vulture/soul_vulture",
        "glow": "textures/entity/alexsmobs/soul_vulture/soul_vulture_glow"
      },
      "geometry": {
        "default": "geometry.alexsmobs.soul_vulture"
      },
      "animations": {
        "idle": "animation.alexsmobs.soul_vulture.idle",
        "breathe": "animation.alexsmobs.soul_vulture.breathe",
        "walk": "animation.alexsmobs.soul_vulture.walk",
        "run": "animation.alexsmobs.soul_vulture.run",
        "fly": "animation.alexsmobs.soul_vulture.fly",
        "look": "animation.alexsmobs.soul_vulture.look",
        "baby": "animation.alexsmobs.soul_vulture.baby",
        "attack_bite": "animation.alexsmobs.soul_vulture.attack_bite",
        "death_0": "animation.alexsmobs.soul_vulture.death_0",
        "death_1": "animation.alexsmobs.soul_vulture.death_1",
        "hurt": "animation.alexsmobs.soul_vulture.hurt",
        "idle_look": "animation.alexsmobs.soul_vulture.idle_look",
        "idle_sniff": "animation.alexsmobs.soul_vulture.idle_sniff",
        "idle_shake": "animation.alexsmobs.soul_vulture.idle_shake",
        "idle_wings": "animation.alexsmobs.soul_vulture.idle_wings",
        "ctrl_move": "controller.animation.alexsmobs.soul_vulture.move",
        "ctrl_idles": "controller.animation.alexsmobs.soul_vulture.idles",
        "ctrl_attack": "controller.animation.alexsmobs.soul_vulture.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.soul_vulture.hurt",
        "ctrl_death": "controller.animation.alexsmobs.soul_vulture.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.soul_vulture",
        "controller.render.alexsmobs.soul_vulture.glow"
      ],
      "spawn_egg": {
        "base_color": "#23262d",
        "overlay_color": "#57f4ff"
      },
      "enable_attachables": false
    }
  }
}
