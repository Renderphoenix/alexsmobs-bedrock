{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:catfish",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/catfish_small",
        "v1": "textures/entity/alexsmobs/catfish_medium",
        "v2": "textures/entity/alexsmobs/catfish_large"
      },
      "geometry": {
        "default": "geometry.alexsmobs.catfish"
      },
      "animations": {
        "idle": "animation.alexsmobs.catfish.idle",
        "breathe": "animation.alexsmobs.catfish.breathe",
        "swim": "animation.alexsmobs.catfish.swim",
        "death_0": "animation.alexsmobs.catfish.death_0",
        "death_1": "animation.alexsmobs.catfish.death_1",
        "hurt": "animation.alexsmobs.catfish.hurt",
        "ctrl_move": "controller.animation.alexsmobs.catfish.move",
        "ctrl_hurt": "controller.animation.alexsmobs.catfish.hurt",
        "ctrl_death": "controller.animation.alexsmobs.catfish.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_hurt",
          "ctrl_death"
        ],
        "scale": "q.variant == 1 ? 1.45 : (q.variant == 2 ? 2.1 : 1)"
      },
      "render_controllers": [
        "controller.render.alexsmobs.catfish"
      ],
      "spawn_egg": {
        "base_color": "#807757",
        "overlay_color": "#8a7466"
      },
      "enable_attachables": false
    }
  }
}
