{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:catfish",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/catfish_small",
        "v1": "textures/entity/alexsmobs/catfish_medium",
        "v2": "textures/entity/alexsmobs/catfish_large"
      },
      "geometry": {
        "default": "geometry.alexsmobs.catfish",
        "v1": "geometry.alexsmobs.catfish.v1",
        "v2": "geometry.alexsmobs.catfish.v2"
      },
      "animations": {
        "pose": "animation.alexsmobs.catfish.pose",
        "pose_v1": "animation.alexsmobs.catfish.pose_v1",
        "pose_v2": "animation.alexsmobs.catfish.pose_v2",
        "death_0": "animation.alexsmobs.catfish.death_0",
        "death_1": "animation.alexsmobs.catfish.death_1",
        "hurt": "animation.alexsmobs.catfish.hurt",
        "ctrl_death": "controller.animation.alexsmobs.catfish.death",
        "ctrl_hurt": "controller.animation.alexsmobs.catfish.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 0;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && q.ground_speed < 0.05;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;"
        ],
        "animate": [
          {
            "pose": "q.variant == 0"
          },
          {
            "pose_v1": "q.variant == 1"
          },
          {
            "pose_v2": "q.variant == 2"
          },
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.catfish"
      ],
      "spawn_egg": {
        "base_color": "#807757",
        "overlay_color": "#8a7466"
      },
      "enable_attachables": false
    }
  }
}
