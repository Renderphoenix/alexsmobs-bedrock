{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:orca",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/orca_ne",
        "v1": "textures/entity/alexsmobs/orca_nw",
        "v2": "textures/entity/alexsmobs/orca_se",
        "v3": "textures/entity/alexsmobs/orca_sw"
      },
      "geometry": {
        "default": "geometry.alexsmobs.orca"
      },
      "animations": {
        "breathe": "animation.alexsmobs.orca.breathe",
        "swim": "animation.alexsmobs.orca.swim",
        "look": "animation.alexsmobs.orca.look",
        "baby": "animation.alexsmobs.orca.baby",
        "bite": "animation.alexsmobs.orca.bite",
        "tailswing": "animation.alexsmobs.orca.tailswing",
        "death_0": "animation.alexsmobs.orca.death_0",
        "death_1": "animation.alexsmobs.orca.death_1",
        "hurt": "animation.alexsmobs.orca.hurt",
        "idle_look": "animation.alexsmobs.orca.idle_look",
        "idle_sniff": "animation.alexsmobs.orca.idle_sniff",
        "idle_shake": "animation.alexsmobs.orca.idle_shake",
        "idle_tail": "animation.alexsmobs.orca.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.orca.move",
        "ctrl_attack": "controller.animation.alexsmobs.orca.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.orca.hurt",
        "ctrl_death": "controller.animation.alexsmobs.orca.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.9;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.6, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.orca"
      ],
      "spawn_egg": {
        "base_color": "#2c2c2c",
        "overlay_color": "#d6d8e4"
      },
      "enable_attachables": false
    }
  }
}
