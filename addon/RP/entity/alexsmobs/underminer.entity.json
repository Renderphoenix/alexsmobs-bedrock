{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:underminer",
      "materials": {
        "default": "entity_alphablend",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/underminer_dwarf"
      },
      "geometry": {
        "default": "geometry.alexsmobs.underminer"
      },
      "animations": {
        "breathe": "animation.alexsmobs.underminer.breathe",
        "walk": "animation.alexsmobs.underminer.walk",
        "run": "animation.alexsmobs.underminer.run",
        "look": "animation.alexsmobs.underminer.look",
        "baby": "animation.alexsmobs.underminer.baby",
        "attack_bite": "animation.alexsmobs.underminer.attack_bite",
        "death_0": "animation.alexsmobs.underminer.death_0",
        "death_1": "animation.alexsmobs.underminer.death_1",
        "hurt": "animation.alexsmobs.underminer.hurt",
        "idle_look": "animation.alexsmobs.underminer.idle_look",
        "idle_sniff": "animation.alexsmobs.underminer.idle_sniff",
        "air_jump": "animation.alexsmobs.underminer.air_jump",
        "air_fall": "animation.alexsmobs.underminer.air_fall",
        "air_land": "animation.alexsmobs.underminer.air_land",
        "ctrl_move": "controller.animation.alexsmobs.underminer.move",
        "ctrl_air": "controller.animation.alexsmobs.underminer.air",
        "ctrl_idles": "controller.animation.alexsmobs.underminer.idles",
        "ctrl_attack": "controller.animation.alexsmobs.underminer.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.underminer.hurt",
        "ctrl_death": "controller.animation.alexsmobs.underminer.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.underminer"
      ],
      "spawn_egg": {
        "base_color": "#d6e2ff",
        "overlay_color": "#6c84c4"
      },
      "enable_attachables": false
    }
  }
}
