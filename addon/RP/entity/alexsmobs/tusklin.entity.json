      },
      "animations": {
        "idle": "animation.alexsmobs.tusklin.idle",
        "breathe": "animation.alexsmobs.tusklin.breathe",
        "walk": "animation.alexsmobs.tusklin.walk",
        "run": "animation.alexsmobs.tusklin.run",
        "look": "animation.alexsmobs.tusklin.look",
        "baby": "animation.alexsmobs.tusklin.baby",
        "rut": "animation.alexsmobs.tusklin.rut",
        "gore_l": "animation.alexsmobs.tusklin.gore_l",
        "gore_r": "animation.alexsmobs.tusklin.gore_r",
        "fling": "animation.alexsmobs.tusklin.fling",
        "buck": "animation.alexsmobs.tusklin.buck",
        "death_0": "animation.alexsmobs.tusklin.death_0",
        "death_1": "animation.alexsmobs.tusklin.death_1",
        "hurt": "animation.alexsmobs.tusklin.hurt",
        "idle_look": "animation.alexsmobs.tusklin.idle_look",
        "idle_sniff": "animation.alexsmobs.tusklin.idle_sniff",
        "idle_shake": "animation.alexsmobs.tusklin.idle_shake",
        "air_jump": "animation.alexsmobs.tusklin.air_jump",
        "air_fall": "animation.alexsmobs.tusklin.air_fall",
        "air_land": "animation.alexsmobs.tusklin.air_land",
        "ctrl_move": "controller.animation.alexsmobs.tusklin.move",
        "ctrl_air": "controller.animation.alexsmobs.tusklin.air",
        "ctrl_idles": "controller.animation.alexsmobs.tusklin.idles",
        "ctrl_attack": "controller.animation.alexsmobs.tusklin.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.tusklin.hurt",
        "ctrl_death": "controller.animation.alexsmobs.tusklin.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.48;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.27000001072883606, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.tusklin"
      ],
      "spawn_egg": {
        "base_color": "#735841",
        "overlay_color": "#e8e2d5"
      },
      "enable_attachables": false
    }
  }
