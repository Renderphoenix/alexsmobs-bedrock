{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:crocodile",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/crocodile_0",
        "v1": "textures/entity/alexsmobs/crocodile_1"
      },
      "geometry": {
        "default": "geometry.alexsmobs.crocodile"
      },
      "animations": {
        "breathe": "animation.alexsmobs.crocodile.breathe",
        "walk": "animation.alexsmobs.crocodile.walk",
        "run": "animation.alexsmobs.crocodile.run",
        "swim": "animation.alexsmobs.crocodile.swim",
        "look": "animation.alexsmobs.crocodile.look",
        "baby": "animation.alexsmobs.crocodile.baby",
        "lunge": "animation.alexsmobs.crocodile.lunge",
        "deathroll": "animation.alexsmobs.crocodile.deathroll",
        "death_0": "animation.alexsmobs.crocodile.death_0",
        "death_1": "animation.alexsmobs.crocodile.death_1",
        "hurt": "animation.alexsmobs.crocodile.hurt",
        "idle_look": "animation.alexsmobs.crocodile.idle_look",
        "idle_sniff": "animation.alexsmobs.crocodile.idle_sniff",
        "idle_shake": "animation.alexsmobs.crocodile.idle_shake",
        "idle_tail": "animation.alexsmobs.crocodile.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.crocodile.move",
        "ctrl_idles": "controller.animation.alexsmobs.crocodile.idles",
        "ctrl_attack": "controller.animation.alexsmobs.crocodile.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.crocodile.hurt",
        "ctrl_death": "controller.animation.alexsmobs.crocodile.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.crocodile"
      ],
      "spawn_egg": {
        "base_color": "#738940",
        "overlay_color": "#a6a15e"
      },
      "enable_attachables": false
    }
  }
}
