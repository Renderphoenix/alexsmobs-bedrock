{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:skreecher",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/skreecher",
        "glow": "textures/entity/alexsmobs/skreecher_glow"
      },
      "geometry": {
        "default": "geometry.alexsmobs.skreecher"
      },
      "animations": {
        "idle": "animation.alexsmobs.skreecher.idle",
        "breathe": "animation.alexsmobs.skreecher.breathe",
        "walk": "animation.alexsmobs.skreecher.walk",
        "run": "animation.alexsmobs.skreecher.run",
        "look": "animation.alexsmobs.skreecher.look",
        "baby": "animation.alexsmobs.skreecher.baby",
        "attack_bite": "animation.alexsmobs.skreecher.attack_bite",
        "death_0": "animation.alexsmobs.skreecher.death_0",
        "death_1": "animation.alexsmobs.skreecher.death_1",
        "hurt": "animation.alexsmobs.skreecher.hurt",
        "idle_look": "animation.alexsmobs.skreecher.idle_look",
        "idle_sniff": "animation.alexsmobs.skreecher.idle_sniff",
        "idle_shake": "animation.alexsmobs.skreecher.idle_shake",
        "ctrl_move": "controller.animation.alexsmobs.skreecher.move",
        "ctrl_idles": "controller.animation.alexsmobs.skreecher.idles",
        "ctrl_attack": "controller.animation.alexsmobs.skreecher.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.skreecher.hurt",
        "ctrl_death": "controller.animation.alexsmobs.skreecher.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.skreecher",
        "controller.render.alexsmobs.skreecher.glow"
      ],
      "spawn_egg": {
        "base_color": "#074857",
        "overlay_color": "#7ff8ff"
      },
      "enable_attachables": false
    }
  }
}
