{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:alligator_snapping_turtle",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/alligator_snapping_turtle"
      },
      "geometry": {
        "default": "geometry.alexsmobs.alligator_snapping_turtle"
      },
      "animations": {
        "idle": "animation.alexsmobs.alligator_snapping_turtle.idle",
        "breathe": "animation.alexsmobs.alligator_snapping_turtle.breathe",
        "walk": "animation.alexsmobs.alligator_snapping_turtle.walk",
        "run": "animation.alexsmobs.alligator_snapping_turtle.run",
        "look": "animation.alexsmobs.alligator_snapping_turtle.look",
        "baby": "animation.alexsmobs.alligator_snapping_turtle.baby",
        "attack_bite": "animation.alexsmobs.alligator_snapping_turtle.attack_bite",
        "death_0": "animation.alexsmobs.alligator_snapping_turtle.death_0",
        "death_1": "animation.alexsmobs.alligator_snapping_turtle.death_1",
        "hurt": "animation.alexsmobs.alligator_snapping_turtle.hurt",
        "idle_look": "animation.alexsmobs.alligator_snapping_turtle.idle_look",
        "idle_sniff": "animation.alexsmobs.alligator_snapping_turtle.idle_sniff",
        "idle_shake": "animation.alexsmobs.alligator_snapping_turtle.idle_shake",
        "idle_tail": "animation.alexsmobs.alligator_snapping_turtle.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.alligator_snapping_turtle.move",
        "ctrl_idles": "controller.animation.alexsmobs.alligator_snapping_turtle.idles",
        "ctrl_attack": "controller.animation.alexsmobs.alligator_snapping_turtle.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.alligator_snapping_turtle.hurt",
        "ctrl_death": "controller.animation.alexsmobs.alligator_snapping_turtle.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.alligator_snapping_turtle"
      ],
      "spawn_egg": {
        "base_color": "#6c5c52",
        "overlay_color": "#456926"
      },
      "enable_attachables": false
    }
  }
}
