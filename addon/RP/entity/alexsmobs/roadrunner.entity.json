{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:roadrunner",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/roadrunner"
      },
      "geometry": {
        "default": "geometry.alexsmobs.roadrunner"
      },
      "animations": {
        "idle": "animation.alexsmobs.roadrunner.idle",
        "breathe": "animation.alexsmobs.roadrunner.breathe",
        "walk": "animation.alexsmobs.roadrunner.walk",
        "run": "animation.alexsmobs.roadrunner.run",
        "look": "animation.alexsmobs.roadrunner.look",
        "death_0": "animation.alexsmobs.roadrunner.death_0",
        "death_1": "animation.alexsmobs.roadrunner.death_1",
        "hurt": "animation.alexsmobs.roadrunner.hurt",
        "idle_look": "animation.alexsmobs.roadrunner.idle_look",
        "idle_sniff": "animation.alexsmobs.roadrunner.idle_sniff",
        "idle_shake": "animation.alexsmobs.roadrunner.idle_shake",
        "idle_wings": "animation.alexsmobs.roadrunner.idle_wings",
        "idle_tail": "animation.alexsmobs.roadrunner.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.roadrunner.move",
        "ctrl_idles": "controller.animation.alexsmobs.roadrunner.idles",
        "ctrl_hurt": "controller.animation.alexsmobs.roadrunner.hurt",
        "ctrl_death": "controller.animation.alexsmobs.roadrunner.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.72;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.40499998927116393, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_hurt",
          "ctrl_death"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.roadrunner"
      ],
      "spawn_egg": {
        "base_color": "#3a2e26",
        "overlay_color": "#fbe9ce"
      },
      "enable_attachables": false
    }
  }
}
