{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:mudskipper",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/mudskipper"
      },
      "geometry": {
        "default": "geometry.alexsmobs.mudskipper"
      },
      "animations": {
        "idle": "animation.alexsmobs.mudskipper.idle",
        "breathe": "animation.alexsmobs.mudskipper.breathe",
        "walk": "animation.alexsmobs.mudskipper.walk",
        "run": "animation.alexsmobs.mudskipper.run",
        "swim": "animation.alexsmobs.mudskipper.swim",
        "pose_sit": "animation.alexsmobs.mudskipper.pose_sit",
        "look": "animation.alexsmobs.mudskipper.look",
        "baby": "animation.alexsmobs.mudskipper.baby",
        "attack_bite": "animation.alexsmobs.mudskipper.attack_bite",
        "death_0": "animation.alexsmobs.mudskipper.death_0",
        "death_1": "animation.alexsmobs.mudskipper.death_1",
        "hurt": "animation.alexsmobs.mudskipper.hurt",
        "idle_look": "animation.alexsmobs.mudskipper.idle_look",
        "idle_sniff": "animation.alexsmobs.mudskipper.idle_sniff",
        "idle_tail": "animation.alexsmobs.mudskipper.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.mudskipper.move",
        "ctrl_idles": "controller.animation.alexsmobs.mudskipper.idles",
        "ctrl_attack": "controller.animation.alexsmobs.mudskipper.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.mudskipper.hurt",
        "ctrl_death": "controller.animation.alexsmobs.mudskipper.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.mudskipper"
      ],
      "spawn_egg": {
        "base_color": "#60704a",
        "overlay_color": "#49806c"
      },
      "enable_attachables": false
    }
  }
}
