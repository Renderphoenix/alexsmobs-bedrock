{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:platypus",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/platypus"
      },
      "geometry": {
        "default": "geometry.alexsmobs.platypus"
      },
      "animations": {
        "idle": "animation.alexsmobs.platypus.idle",
        "breathe": "animation.alexsmobs.platypus.breathe",
        "walk": "animation.alexsmobs.platypus.walk",
        "run": "animation.alexsmobs.platypus.run",
        "swim": "animation.alexsmobs.platypus.swim",
        "look": "animation.alexsmobs.platypus.look",
        "baby": "animation.alexsmobs.platypus.baby",
        "death_0": "animation.alexsmobs.platypus.death_0",
        "death_1": "animation.alexsmobs.platypus.death_1",
        "hurt": "animation.alexsmobs.platypus.hurt",
        "idle_look": "animation.alexsmobs.platypus.idle_look",
        "idle_sniff": "animation.alexsmobs.platypus.idle_sniff",
        "idle_shake": "animation.alexsmobs.platypus.idle_shake",
        "idle_tail": "animation.alexsmobs.platypus.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.platypus.move",
        "ctrl_idles": "controller.animation.alexsmobs.platypus.idles",
        "ctrl_hurt": "controller.animation.alexsmobs.platypus.hurt",
        "ctrl_death": "controller.animation.alexsmobs.platypus.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.platypus"
      ],
      "spawn_egg": {
        "base_color": "#7d503e",
        "overlay_color": "#363b43"
      },
      "enable_attachables": false
    }
  }
}
