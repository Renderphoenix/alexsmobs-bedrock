{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:warped_toad",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/warped_toad",
        "glow": "textures/entity/alexsmobs/warped_toad_glow"
      },
      "geometry": {
        "default": "geometry.alexsmobs.warped_toad"
      },
      "animations": {
        "breathe": "animation.alexsmobs.warped_toad.breathe",
        "walk": "animation.alexsmobs.warped_toad.walk",
        "run": "animation.alexsmobs.warped_toad.run",
        "swim": "animation.alexsmobs.warped_toad.swim",
        "pose_sit": "animation.alexsmobs.warped_toad.pose_sit",
        "look": "animation.alexsmobs.warped_toad.look",
        "baby": "animation.alexsmobs.warped_toad.baby",
        "attack_bite": "animation.alexsmobs.warped_toad.attack_bite",
        "death_0": "animation.alexsmobs.warped_toad.death_0",
        "death_1": "animation.alexsmobs.warped_toad.death_1",
        "hurt": "animation.alexsmobs.warped_toad.hurt",
        "idle_look": "animation.alexsmobs.warped_toad.idle_look",
        "idle_sniff": "animation.alexsmobs.warped_toad.idle_sniff",
        "idle_shake": "animation.alexsmobs.warped_toad.idle_shake",
        "air_jump": "animation.alexsmobs.warped_toad.air_jump",
        "air_fall": "animation.alexsmobs.warped_toad.air_fall",
        "air_land": "animation.alexsmobs.warped_toad.air_land",
        "ctrl_move": "controller.animation.alexsmobs.warped_toad.move",
        "ctrl_air": "controller.animation.alexsmobs.warped_toad.air",
        "ctrl_idles": "controller.animation.alexsmobs.warped_toad.idles",
        "ctrl_attack": "controller.animation.alexsmobs.warped_toad.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.warped_toad.hurt",
        "ctrl_death": "controller.animation.alexsmobs.warped_toad.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.warped_toad",
        "controller.render.alexsmobs.warped_toad.glow"
      ],
      "spawn_egg": {
        "base_color": "#1f968e",
        "overlay_color": "#feac6d"
      },
      "enable_attachables": false
    }
  }
}
