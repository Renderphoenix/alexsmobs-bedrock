{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:sunbird",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/sunbird",
        "glow": "textures/entity/alexsmobs/sunbird_glow"
      },
      "geometry": {
        "default": "geometry.alexsmobs.sunbird"
      },
      "animations": {
        "idle": "animation.alexsmobs.sunbird.idle",
        "breathe": "animation.alexsmobs.sunbird.breathe",
        "fly": "animation.alexsmobs.sunbird.fly",
        "look": "animation.alexsmobs.sunbird.look",
        "baby": "animation.alexsmobs.sunbird.baby",
        "attack_bite": "animation.alexsmobs.sunbird.attack_bite",
        "death_0": "animation.alexsmobs.sunbird.death_0",
        "death_1": "animation.alexsmobs.sunbird.death_1",
        "hurt": "animation.alexsmobs.sunbird.hurt",
        "idle_look": "animation.alexsmobs.sunbird.idle_look",
        "idle_sniff": "animation.alexsmobs.sunbird.idle_sniff",
        "idle_shake": "animation.alexsmobs.sunbird.idle_shake",
        "idle_wings": "animation.alexsmobs.sunbird.idle_wings",
        "idle_tail": "animation.alexsmobs.sunbird.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.sunbird.move",
        "ctrl_attack": "controller.animation.alexsmobs.sunbird.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.sunbird.hurt",
        "ctrl_death": "controller.animation.alexsmobs.sunbird.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.9;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.6, 0.35, 2.4);",
          "v.am_flying = 1;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.sunbird",
        "controller.render.alexsmobs.sunbird.glow"
      ],
      "spawn_egg": {
        "base_color": "#f6694f",
        "overlay_color": "#ffdda0"
      },
      "enable_attachables": false
    }
  }
}
