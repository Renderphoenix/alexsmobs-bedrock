{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:anaconda",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/anaconda",
        "v1": "textures/entity/alexsmobs/anaconda_yellow"
      },
      "geometry": {
        "default": "geometry.alexsmobs.anaconda"
      },
      "animations": {
        "idle": "animation.alexsmobs.anaconda.idle",
        "walk": "animation.alexsmobs.anaconda.walk",
        "run": "animation.alexsmobs.anaconda.run",
        "death_0": "animation.alexsmobs.anaconda.death_0",
        "death_1": "animation.alexsmobs.anaconda.death_1",
        "hurt": "animation.alexsmobs.anaconda.hurt",
        "ctrl_move": "controller.animation.alexsmobs.anaconda.move",
        "ctrl_hurt": "controller.animation.alexsmobs.anaconda.hurt",
        "ctrl_death": "controller.animation.alexsmobs.anaconda.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.053;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.13500000536441803, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_hurt",
          "ctrl_death"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.anaconda"
      ],
      "spawn_egg": {
        "base_color": "#565c22",
        "overlay_color": "#d3763f"
      },
      "enable_attachables": false
    }
  }
}
