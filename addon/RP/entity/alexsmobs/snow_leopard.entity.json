      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.56;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.314999994635582, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = q.property('alexsmobs:sleeping');",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ],
        "scale": "0.9"
      },
      "render_controllers": [
        "controller.render.alexsmobs.snow_leopard"
      ],
      "spawn_egg": {
        "base_color": "#aca293",
        "overlay_color": "#26201d"
      },
      "enable_attachables": false
