{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:maned_wolf",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/maned_wolf"
      },
      "geometry": {
        "default": "geometry.alexsmobs.maned_wolf"
      },
      "animations": {
        "idle": "animation.alexsmobs.maned_wolf.idle",
        "breathe": "animation.alexsmobs.maned_wolf.breathe",
        "walk": "animation.alexsmobs.maned_wolf.walk",
        "run": "animation.alexsmobs.maned_wolf.run",
        "look": "animation.alexsmobs.maned_wolf.look",
        "baby": "animation.alexsmobs.maned_wolf.baby",
        "lg_idle_sniff": "animation.alexsmobs.maned_wolf.lg_idle_sniff",
        "lg_idle_howl": "animation.alexsmobs.maned_wolf.lg_idle_howl",
        "lg_pounce": "animation.alexsmobs.maned_wolf.lg_pounce",
        "death_0": "animation.alexsmobs.maned_wolf.death_0",
        "death_1": "animation.alexsmobs.maned_wolf.death_1",
        "hurt": "animation.alexsmobs.maned_wolf.hurt",
        "idle_look": "animation.alexsmobs.maned_wolf.idle_look",
        "idle_sniff": "animation.alexsmobs.maned_wolf.idle_sniff",
        "idle_shake": "animation.alexsmobs.maned_wolf.idle_shake",
        "idle_tail": "animation.alexsmobs.maned_wolf.idle_tail",
        "air_jump": "animation.alexsmobs.maned_wolf.air_jump",
        "air_fall": "animation.alexsmobs.maned_wolf.air_fall",
        "air_land": "animation.alexsmobs.maned_wolf.air_land",
        "ctrl_move": "controller.animation.alexsmobs.maned_wolf.move",
        "ctrl_air": "controller.animation.alexsmobs.maned_wolf.air",
        "ctrl_idles": "controller.animation.alexsmobs.maned_wolf.idles",
        "ctrl_attack": "controller.animation.alexsmobs.maned_wolf.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.maned_wolf.hurt",
        "ctrl_death": "controller.animation.alexsmobs.maned_wolf.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.48;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.27000001072883606, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ],
        "scale": "0.85"
      },
      "render_controllers": [
        "controller.render.alexsmobs.maned_wolf"
      ],
      "spawn_egg": {
        "base_color": "#bb7a47",
        "overlay_color": "#40271a"
      },
      "enable_attachables": false
    }
  }
}
