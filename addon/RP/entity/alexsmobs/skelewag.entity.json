{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:skelewag",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/skelewag_0",
        "v1": "textures/entity/alexsmobs/skelewag_1"
      },
      "geometry": {
        "default": "geometry.alexsmobs.skelewag"
      },
      "animations": {
        "idle": "animation.alexsmobs.skelewag.idle",
        "breathe": "animation.alexsmobs.skelewag.breathe",
        "swim": "animation.alexsmobs.skelewag.swim",
        "look": "animation.alexsmobs.skelewag.look",
        "baby": "animation.alexsmobs.skelewag.baby",
        "stab": "animation.alexsmobs.skelewag.stab",
        "slash": "animation.alexsmobs.skelewag.slash",
        "death_0": "animation.alexsmobs.skelewag.death_0",
        "death_1": "animation.alexsmobs.skelewag.death_1",
        "hurt": "animation.alexsmobs.skelewag.hurt",
        "idle_look": "animation.alexsmobs.skelewag.idle_look",
        "idle_sniff": "animation.alexsmobs.skelewag.idle_sniff",
        "ctrl_move": "controller.animation.alexsmobs.skelewag.move",
        "ctrl_attack": "controller.animation.alexsmobs.skelewag.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.skelewag.hurt",
        "ctrl_death": "controller.animation.alexsmobs.skelewag.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.72;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.405, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.skelewag"
      ],
      "spawn_egg": {
        "base_color": "#d9fcb1",
        "overlay_color": "#3a4f30"
      },
      "enable_attachables": false
    }
  }
}
