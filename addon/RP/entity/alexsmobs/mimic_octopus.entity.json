        "breathe": "animation.alexsmobs.mimic_octopus.breathe",
        "walk": "animation.alexsmobs.mimic_octopus.walk",
        "run": "animation.alexsmobs.mimic_octopus.run",
        "pose_sit": "animation.alexsmobs.mimic_octopus.pose_sit",
        "attack_bite": "animation.alexsmobs.mimic_octopus.attack_bite",
        "death_0": "animation.alexsmobs.mimic_octopus.death_0",
        "death_1": "animation.alexsmobs.mimic_octopus.death_1",
        "hurt": "animation.alexsmobs.mimic_octopus.hurt",
        "idle_shake": "animation.alexsmobs.mimic_octopus.idle_shake",
        "air_jump": "animation.alexsmobs.mimic_octopus.air_jump",
        "air_fall": "animation.alexsmobs.mimic_octopus.air_fall",
        "air_land": "animation.alexsmobs.mimic_octopus.air_land",
        "ctrl_move": "controller.animation.alexsmobs.mimic_octopus.move",
        "ctrl_air": "controller.animation.alexsmobs.mimic_octopus.air",
        "ctrl_idles": "controller.animation.alexsmobs.mimic_octopus.idles",
        "ctrl_attack": "controller.animation.alexsmobs.mimic_octopus.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.mimic_octopus.hurt",
        "ctrl_death": "controller.animation.alexsmobs.mimic_octopus.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death"
        ],
        "scale": "0.9"
      },
      "render_controllers": [
        "controller.render.alexsmobs.mimic_octopus",
        "controller.render.alexsmobs.mimic_octopus.glow"
      ],
      "spawn_egg": {
        "base_color": "#ffebdc",
        "overlay_color": "#1d1c1f"
      },
      "enable_attachables": false
    }
  }
