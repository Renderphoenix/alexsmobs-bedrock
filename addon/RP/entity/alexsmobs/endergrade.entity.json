{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:endergrade",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/endergrade"
      },
      "geometry": {
        "default": "geometry.alexsmobs.endergrade"
      },
      "animations": {
        "pose": "animation.alexsmobs.endergrade.pose",
        "death_0": "animation.alexsmobs.endergrade.death_0",
        "death_1": "animation.alexsmobs.endergrade.death_1",
        "hurt": "animation.alexsmobs.endergrade.hurt",
        "idle_look": "animation.alexsmobs.endergrade.idle_look",
        "idle_sniff": "animation.alexsmobs.endergrade.idle_sniff",
        "idle_shake": "animation.alexsmobs.endergrade.idle_shake",
        "idle_tail": "animation.alexsmobs.endergrade.idle_tail",
        "ctrl_idle": "controller.animation.alexsmobs.endergrade.idle",
        "ctrl_death": "controller.animation.alexsmobs.endergrade.death",
        "ctrl_hurt": "controller.animation.alexsmobs.endergrade.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && q.ground_speed < 0.05;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;",
          "v.p_biteprogress = math.clamp((v.p_biteprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);"
        ],
        "animate": [
          "pose",
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.endergrade"
      ],
      "spawn_egg": {
        "base_color": "#7862b3",
        "overlay_color": "#81bdeb"
      },
      "enable_attachables": false
    }
  }
}
