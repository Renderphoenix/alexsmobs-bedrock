{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:endergrade",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/endergrade"
      },
      "geometry": {
        "default": "geometry.alexsmobs.endergrade"
      },
      "animations": {
        "breathe": "animation.alexsmobs.endergrade.breathe",
        "fly": "animation.alexsmobs.endergrade.fly",
        "look": "animation.alexsmobs.endergrade.look",
        "baby": "animation.alexsmobs.endergrade.baby",
        "attack_bite": "animation.alexsmobs.endergrade.attack_bite",
        "death_0": "animation.alexsmobs.endergrade.death_0",
        "death_1": "animation.alexsmobs.endergrade.death_1",
        "hurt": "animation.alexsmobs.endergrade.hurt",
        "idle_look": "animation.alexsmobs.endergrade.idle_look",
        "idle_sniff": "animation.alexsmobs.endergrade.idle_sniff",
        "idle_shake": "animation.alexsmobs.endergrade.idle_shake",
        "idle_tail": "animation.alexsmobs.endergrade.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.endergrade.move",
        "ctrl_attack": "controller.animation.alexsmobs.endergrade.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.endergrade.hurt",
        "ctrl_death": "controller.animation.alexsmobs.endergrade.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.053;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.13500000536441803, 0.35, 2.4);",
          "v.am_flying = 1;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.endergrade"
      ],
      "spawn_egg": {
        "base_color": "#7862b3",
        "overlay_color": "#81bdeb"
      },
      "enable_attachables": false
    }
  }
}
