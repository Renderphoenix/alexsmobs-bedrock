{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:grizzly_bear",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/grizzly_bear"
      },
      "geometry": {
        "default": "geometry.alexsmobs.grizzly_bear"
      },
      "animations": {
        "breathe": "animation.alexsmobs.grizzly_bear.breathe",
        "walk": "animation.alexsmobs.grizzly_bear.walk",
        "run": "animation.alexsmobs.grizzly_bear.run",
        "pose_sit": "animation.alexsmobs.grizzly_bear.pose_sit",
        "pose_stand": "animation.alexsmobs.grizzly_bear.pose_stand",
        "look": "animation.alexsmobs.grizzly_bear.look",
        "baby": "animation.alexsmobs.grizzly_bear.baby",
        "maul": "animation.alexsmobs.grizzly_bear.maul",
        "swipe_r": "animation.alexsmobs.grizzly_bear.swipe_r",
        "swipe_l": "animation.alexsmobs.grizzly_bear.swipe_l",
        "sniff": "animation.alexsmobs.grizzly_bear.sniff",
        "death_0": "animation.alexsmobs.grizzly_bear.death_0",
        "death_1": "animation.alexsmobs.grizzly_bear.death_1",
        "hurt": "animation.alexsmobs.grizzly_bear.hurt",
        "idle_look": "animation.alexsmobs.grizzly_bear.idle_look",
        "idle_sniff": "animation.alexsmobs.grizzly_bear.idle_sniff",
        "idle_shake": "animation.alexsmobs.grizzly_bear.idle_shake",
        "ctrl_move": "controller.animation.alexsmobs.grizzly_bear.move",
        "ctrl_idles": "controller.animation.alexsmobs.grizzly_bear.idles",
        "ctrl_attack": "controller.animation.alexsmobs.grizzly_bear.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.grizzly_bear.hurt",
        "ctrl_death": "controller.animation.alexsmobs.grizzly_bear.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && !v.is_moving && q.is_on_ground;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.grizzly_bear"
      ],
      "spawn_egg": {
        "base_color": "#693a2c",
        "overlay_color": "#976144"
      },
      "enable_attachables": false
    }
  }
}
