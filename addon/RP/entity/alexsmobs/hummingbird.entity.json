{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:hummingbird",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/hummingbird_0",
        "v1": "textures/entity/alexsmobs/hummingbird_1",
        "v2": "textures/entity/alexsmobs/hummingbird_2"
      },
      "geometry": {
        "default": "geometry.alexsmobs.hummingbird"
      },
      "animations": {
        "idle": "animation.alexsmobs.hummingbird.idle",
        "breathe": "animation.alexsmobs.hummingbird.breathe",
        "fly": "animation.alexsmobs.hummingbird.fly",
        "look": "animation.alexsmobs.hummingbird.look",
        "baby": "animation.alexsmobs.hummingbird.baby",
        "death_0": "animation.alexsmobs.hummingbird.death_0",
        "death_1": "animation.alexsmobs.hummingbird.death_1",
        "hurt": "animation.alexsmobs.hummingbird.hurt",
        "idle_look": "animation.alexsmobs.hummingbird.idle_look",
        "idle_sniff": "animation.alexsmobs.hummingbird.idle_sniff",
        "idle_shake": "animation.alexsmobs.hummingbird.idle_shake",
        "idle_wings": "animation.alexsmobs.hummingbird.idle_wings",
        "idle_tail": "animation.alexsmobs.hummingbird.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.hummingbird.move",
        "ctrl_hurt": "controller.animation.alexsmobs.hummingbird.hurt",
        "ctrl_death": "controller.animation.alexsmobs.hummingbird.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.72;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.40499998927116393, 0.35, 2.4);",
          "v.am_flying = 1;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.hummingbird"
      ],
      "spawn_egg": {
        "base_color": "#325e7f",
        "overlay_color": "#44a75f"
      },
      "enable_attachables": false
    }
  }
}
