{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:straddler",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/straddler"
      },
      "geometry": {
        "default": "geometry.alexsmobs.straddler"
      },
      "animations": {
        "idle": "animation.alexsmobs.straddler.idle",
        "breathe": "animation.alexsmobs.straddler.breathe",
        "walk": "animation.alexsmobs.straddler.walk",
        "run": "animation.alexsmobs.straddler.run",
        "launch": "animation.alexsmobs.straddler.launch",
        "death_0": "animation.alexsmobs.straddler.death_0",
        "death_1": "animation.alexsmobs.straddler.death_1",
        "hurt": "animation.alexsmobs.straddler.hurt",
        "idle_shake": "animation.alexsmobs.straddler.idle_shake",
        "air_jump": "animation.alexsmobs.straddler.air_jump",
        "air_fall": "animation.alexsmobs.straddler.air_fall",
        "air_land": "animation.alexsmobs.straddler.air_land",
        "ctrl_move": "controller.animation.alexsmobs.straddler.move",
        "ctrl_air": "controller.animation.alexsmobs.straddler.air",
        "ctrl_idles": "controller.animation.alexsmobs.straddler.idles",
        "ctrl_attack": "controller.animation.alexsmobs.straddler.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.straddler.hurt",
        "ctrl_death": "controller.animation.alexsmobs.straddler.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.48;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.27000001072883606, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.straddler"
      ],
      "spawn_egg": {
        "base_color": "#5d5f6e",
        "overlay_color": "#cda886"
      },
      "enable_attachables": false
    }
  }
}
