{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:jerboa",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/jerboa",
        "sleep0": "textures/entity/alexsmobs/jerboa_sleeping"
      },
      "geometry": {
        "default": "geometry.alexsmobs.jerboa"
      },
      "animations": {
        "pose": "animation.alexsmobs.jerboa.pose",
        "death_0": "animation.alexsmobs.jerboa.death_0",
        "death_1": "animation.alexsmobs.jerboa.death_1",
        "hurt": "animation.alexsmobs.jerboa.hurt",
        "idle_shake": "animation.alexsmobs.jerboa.idle_shake",
        "idle_tail": "animation.alexsmobs.jerboa.idle_tail",
        "ctrl_idle": "controller.animation.alexsmobs.jerboa.idle",
        "ctrl_death": "controller.animation.alexsmobs.jerboa.death",
        "ctrl_hurt": "controller.animation.alexsmobs.jerboa.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 0;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = q.property('alexsmobs:sleeping');",
          "v.am_standing = q.property('alexsmobs:angry') && q.ground_speed < 0.05;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;",
          "v.p_sleepprogress = math.clamp((v.p_sleepprogress ?? 0) + ((v.am_sleeping) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_reboundprogress = math.clamp((v.p_reboundprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_jumpprogress = math.clamp((v.p_jumpprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_begprogress = math.clamp((v.p_begprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);"
        ],
        "animate": [
          "pose",
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.jerboa"
      ],
      "spawn_egg": {
        "base_color": "#dec58a",
        "overlay_color": "#de9d90"
      },
      "enable_attachables": false
    }
  }
}
