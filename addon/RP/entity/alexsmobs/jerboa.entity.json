        "sleep0": "textures/entity/alexsmobs/jerboa_sleeping"
      },
      "geometry": {
        "default": "geometry.alexsmobs.jerboa"
      },
      "animations": {
        "idle": "animation.alexsmobs.jerboa.idle",
        "breathe": "animation.alexsmobs.jerboa.breathe",
        "walk": "animation.alexsmobs.jerboa.walk",
        "run": "animation.alexsmobs.jerboa.run",
        "pose_sleep": "animation.alexsmobs.jerboa.pose_sleep",
        "death_0": "animation.alexsmobs.jerboa.death_0",
        "death_1": "animation.alexsmobs.jerboa.death_1",
        "hurt": "animation.alexsmobs.jerboa.hurt",
        "idle_shake": "animation.alexsmobs.jerboa.idle_shake",
        "idle_tail": "animation.alexsmobs.jerboa.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.jerboa.move",
        "ctrl_idles": "controller.animation.alexsmobs.jerboa.idles",
        "ctrl_hurt": "controller.animation.alexsmobs.jerboa.hurt",
        "ctrl_death": "controller.animation.alexsmobs.jerboa.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.72;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.40499998927116393, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = q.property('alexsmobs:sleeping');",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_idles",
          "ctrl_hurt",
          "ctrl_death"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.jerboa"
      ],
      "spawn_egg": {
        "base_color": "#dec58a",
        "overlay_color": "#de9d90"
      },
      "enable_attachables": false
    }
