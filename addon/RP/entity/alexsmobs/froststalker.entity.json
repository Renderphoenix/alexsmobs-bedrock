{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:froststalker",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/froststalker"
      },
      "geometry": {
        "default": "geometry.alexsmobs.froststalker"
      },
      "animations": {
        "idle": "animation.alexsmobs.froststalker.idle",
        "breathe": "animation.alexsmobs.froststalker.breathe",
        "walk": "animation.alexsmobs.froststalker.walk",
        "run": "animation.alexsmobs.froststalker.run",
        "look": "animation.alexsmobs.froststalker.look",
        "baby": "animation.alexsmobs.froststalker.baby",
        "bite": "animation.alexsmobs.froststalker.bite",
        "speak": "animation.alexsmobs.froststalker.speak",
        "slash_l": "animation.alexsmobs.froststalker.slash_l",
        "slash_r": "animation.alexsmobs.froststalker.slash_r",
        "shove": "animation.alexsmobs.froststalker.shove",
        "death_0": "animation.alexsmobs.froststalker.death_0",
        "death_1": "animation.alexsmobs.froststalker.death_1",
        "hurt": "animation.alexsmobs.froststalker.hurt",
        "idle_look": "animation.alexsmobs.froststalker.idle_look",
        "idle_sniff": "animation.alexsmobs.froststalker.idle_sniff",
        "idle_shake": "animation.alexsmobs.froststalker.idle_shake",
        "idle_tail": "animation.alexsmobs.froststalker.idle_tail",
        "air_jump": "animation.alexsmobs.froststalker.air_jump",
        "air_fall": "animation.alexsmobs.froststalker.air_fall",
        "air_land": "animation.alexsmobs.froststalker.air_land",
        "ctrl_move": "controller.animation.alexsmobs.froststalker.move",
        "ctrl_air": "controller.animation.alexsmobs.froststalker.air",
        "ctrl_idles": "controller.animation.alexsmobs.froststalker.idles",
        "ctrl_attack": "controller.animation.alexsmobs.froststalker.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.froststalker.hurt",
        "ctrl_death": "controller.animation.alexsmobs.froststalker.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.48;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.27000001072883606, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.froststalker"
      ],
      "spawn_egg": {
        "base_color": "#788ac1",
        "overlay_color": "#a1c3ff"
      },
      "enable_attachables": false
    }
  }
}
