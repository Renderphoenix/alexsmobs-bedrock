{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:void_worm",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/void_worm/void_worm_head",
        "glow": "textures/entity/alexsmobs/void_worm/void_worm_head_glow"
      },
      "geometry": {
        "default": "geometry.alexsmobs.void_worm"
      },
      "animations": {
        "breathe": "animation.alexsmobs.void_worm.breathe",
        "fly": "animation.alexsmobs.void_worm.fly",
        "look": "animation.alexsmobs.void_worm.look",
        "baby": "animation.alexsmobs.void_worm.baby",
        "attack_bite": "animation.alexsmobs.void_worm.attack_bite",
        "death_0": "animation.alexsmobs.void_worm.death_0",
        "death_1": "animation.alexsmobs.void_worm.death_1",
        "hurt": "animation.alexsmobs.void_worm.hurt",
        "idle_look": "animation.alexsmobs.void_worm.idle_look",
        "idle_sniff": "animation.alexsmobs.void_worm.idle_sniff",
        "ctrl_move": "controller.animation.alexsmobs.void_worm.move",
        "ctrl_attack": "controller.animation.alexsmobs.void_worm.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.void_worm.hurt",
        "ctrl_death": "controller.animation.alexsmobs.void_worm.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.48;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.27000001072883606, 0.35, 2.4);",
          "v.am_flying = 1;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.void_worm",
        "controller.render.alexsmobs.void_worm.glow"
      ],
      "spawn_egg": {
        "base_color": "#0f1026",
        "overlay_color": "#1699ab"
      },
      "enable_attachables": false
    }
  }
}
