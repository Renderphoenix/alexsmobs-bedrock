        "default": "geometry.alexsmobs.shoebill"
      },
      "animations": {
        "idle": "animation.alexsmobs.shoebill.idle",
        "breathe": "animation.alexsmobs.shoebill.breathe",
        "walk": "animation.alexsmobs.shoebill.walk",
        "run": "animation.alexsmobs.shoebill.run",
        "fly": "animation.alexsmobs.shoebill.fly",
        "look": "animation.alexsmobs.shoebill.look",
        "baby": "animation.alexsmobs.shoebill.baby",
        "fish": "animation.alexsmobs.shoebill.fish",
        "beakshake": "animation.alexsmobs.shoebill.beakshake",
        "attack": "animation.alexsmobs.shoebill.attack",
        "death_0": "animation.alexsmobs.shoebill.death_0",
        "death_1": "animation.alexsmobs.shoebill.death_1",
        "hurt": "animation.alexsmobs.shoebill.hurt",
        "idle_look": "animation.alexsmobs.shoebill.idle_look",
        "idle_sniff": "animation.alexsmobs.shoebill.idle_sniff",
        "idle_shake": "animation.alexsmobs.shoebill.idle_shake",
        "idle_wings": "animation.alexsmobs.shoebill.idle_wings",
        "idle_tail": "animation.alexsmobs.shoebill.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.shoebill.move",
        "ctrl_idles": "controller.animation.alexsmobs.shoebill.idles",
        "ctrl_attack": "controller.animation.alexsmobs.shoebill.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.shoebill.hurt",
        "ctrl_death": "controller.animation.alexsmobs.shoebill.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.shoebill"
      ],
      "spawn_egg": {
        "base_color": "#828282",
        "overlay_color": "#d5b48a"
      },
      "enable_attachables": false
    }
  }
