{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:spectre",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/spectre",
        "glow": "textures/entity/alexsmobs/spectre_glow"
      },
      "geometry": {
        "default": "geometry.alexsmobs.spectre"
      },
      "animations": {
        "pose": "animation.alexsmobs.spectre.pose",
        "death_0": "animation.alexsmobs.spectre.death_0",
        "death_1": "animation.alexsmobs.spectre.death_1",
        "hurt": "animation.alexsmobs.spectre.hurt",
        "idle_shake": "animation.alexsmobs.spectre.idle_shake",
        "idle_wings": "animation.alexsmobs.spectre.idle_wings",
        "idle_tail": "animation.alexsmobs.spectre.idle_tail",
        "ctrl_idle": "controller.animation.alexsmobs.spectre.idle",
        "ctrl_death": "controller.animation.alexsmobs.spectre.death",
        "ctrl_hurt": "controller.animation.alexsmobs.spectre.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 1;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && q.ground_speed < 0.05;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;"
        ],
        "animate": [
          "pose",
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.spectre",
        "controller.render.alexsmobs.spectre.glow"
      ],
      "spawn_egg": {
        "base_color": "#c8d0ef",
        "overlay_color": "#8791ef"
      },
      "enable_attachables": false
    }
  }
}
