{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:sea_bear",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/sea_bear"
      },
      "geometry": {
        "default": "geometry.alexsmobs.sea_bear"
      },
      "animations": {
        "idle": "animation.alexsmobs.sea_bear.idle",
        "breathe": "animation.alexsmobs.sea_bear.breathe",
        "swim": "animation.alexsmobs.sea_bear.swim",
        "look": "animation.alexsmobs.sea_bear.look",
        "baby": "animation.alexsmobs.sea_bear.baby",
        "point": "animation.alexsmobs.sea_bear.point",
        "attack": "animation.alexsmobs.sea_bear.attack",
        "death_0": "animation.alexsmobs.sea_bear.death_0",
        "death_1": "animation.alexsmobs.sea_bear.death_1",
        "hurt": "animation.alexsmobs.sea_bear.hurt",
        "idle_look": "animation.alexsmobs.sea_bear.idle_look",
        "idle_sniff": "animation.alexsmobs.sea_bear.idle_sniff",
        "ctrl_move": "controller.animation.alexsmobs.sea_bear.move",
        "ctrl_attack": "controller.animation.alexsmobs.sea_bear.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.sea_bear.hurt",
        "ctrl_death": "controller.animation.alexsmobs.sea_bear.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.52;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.29249998927116394, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.sea_bear"
      ],
      "spawn_egg": {
        "base_color": "#7a5a3a",
        "overlay_color": "#d8b98a"
      },
      "enable_attachables": false
    }
  }
}
