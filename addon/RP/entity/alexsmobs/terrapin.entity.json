{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:terrapin",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/terrapin/terrapin_green",
        "v1": "textures/entity/alexsmobs/terrapin/terrapin_brown",
        "v2": "textures/entity/alexsmobs/terrapin/terrapin_black",
        "v3": "textures/entity/alexsmobs/terrapin/terrapin_red_eared",
        "v4": "textures/entity/alexsmobs/terrapin/terrapin_painted",
        "v5": "textures/entity/alexsmobs/terrapin/terrapin_koopa"
      },
      "geometry": {
        "default": "geometry.alexsmobs.terrapin"
      },
      "animations": {
        "idle": "animation.alexsmobs.terrapin.idle",
        "breathe": "animation.alexsmobs.terrapin.breathe",
        "walk": "animation.alexsmobs.terrapin.walk",
        "run": "animation.alexsmobs.terrapin.run",
        "swim": "animation.alexsmobs.terrapin.swim",
        "look": "animation.alexsmobs.terrapin.look",
        "baby": "animation.alexsmobs.terrapin.baby",
        "death_0": "animation.alexsmobs.terrapin.death_0",
        "death_1": "animation.alexsmobs.terrapin.death_1",
        "hurt": "animation.alexsmobs.terrapin.hurt",
        "idle_look": "animation.alexsmobs.terrapin.idle_look",
        "idle_sniff": "animation.alexsmobs.terrapin.idle_sniff",
        "idle_shake": "animation.alexsmobs.terrapin.idle_shake",
        "idle_tail": "animation.alexsmobs.terrapin.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.terrapin.move",
        "ctrl_idles": "controller.animation.alexsmobs.terrapin.idles",
        "ctrl_hurt": "controller.animation.alexsmobs.terrapin.hurt",
        "ctrl_death": "controller.animation.alexsmobs.terrapin.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.035;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.12, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.terrapin"
      ],
      "spawn_egg": {
        "base_color": "#6e6e30",
        "overlay_color": "#929647"
      },
      "enable_attachables": false
    }
  }
}
