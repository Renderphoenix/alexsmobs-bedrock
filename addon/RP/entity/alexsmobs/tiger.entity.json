{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:tiger",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/tiger/tiger",
        "v1": "textures/entity/alexsmobs/tiger/tiger_white",
        "sleep0": "textures/entity/alexsmobs/tiger/tiger_sleeping",
        "sleep1": "textures/entity/alexsmobs/tiger/tiger_white_sleeping",
        "angry0": "textures/entity/alexsmobs/tiger/tiger_angry",
        "angry1": "textures/entity/alexsmobs/tiger/tiger_white_angry",
        "glow": "textures/entity/alexsmobs/tiger/tiger_eyes"
      },
      "geometry": {
        "default": "geometry.alexsmobs.tiger"
      },
      "animations": {
        "idle": "animation.alexsmobs.tiger.idle",
        "breathe": "animation.alexsmobs.tiger.breathe",
        "walk": "animation.alexsmobs.tiger.walk",
        "run": "animation.alexsmobs.tiger.run",
        "pose_sit": "animation.alexsmobs.tiger.pose_sit",
        "pose_sleep": "animation.alexsmobs.tiger.pose_sleep",
        "look": "animation.alexsmobs.tiger.look",
        "baby": "animation.alexsmobs.tiger.baby",
        "paw_r": "animation.alexsmobs.tiger.paw_r",
        "paw_l": "animation.alexsmobs.tiger.paw_l",
        "tail_flick": "animation.alexsmobs.tiger.tail_flick",
        "leap": "animation.alexsmobs.tiger.leap",
        "lg_idle_stalk": "animation.alexsmobs.tiger.lg_idle_stalk",
        "lg_idle_sit": "animation.alexsmobs.tiger.lg_idle_sit",
        "lg_idle_roar": "animation.alexsmobs.tiger.lg_idle_roar",
        "lg_pounce": "animation.alexsmobs.tiger.lg_pounce",
        "death_0": "animation.alexsmobs.tiger.death_0",
        "death_1": "animation.alexsmobs.tiger.death_1",
        "hurt": "animation.alexsmobs.tiger.hurt",
        "idle_look": "animation.alexsmobs.tiger.idle_look",
        "idle_sniff": "animation.alexsmobs.tiger.idle_sniff",
        "idle_shake": "animation.alexsmobs.tiger.idle_shake",
        "idle_tail": "animation.alexsmobs.tiger.idle_tail",
        "air_jump": "animation.alexsmobs.tiger.air_jump",
        "air_fall": "animation.alexsmobs.tiger.air_fall",
        "air_land": "animation.alexsmobs.tiger.air_land",
        "ctrl_move": "controller.animation.alexsmobs.tiger.move",
        "ctrl_air": "controller.animation.alexsmobs.tiger.air",
        "ctrl_idles": "controller.animation.alexsmobs.tiger.idles",
        "ctrl_attack": "controller.animation.alexsmobs.tiger.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.tiger.hurt",
        "ctrl_death": "controller.animation.alexsmobs.tiger.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = q.property('alexsmobs:sleeping');",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.tiger",
        {
          "controller.render.alexsmobs.tiger.glow": "!v.am_sleeping"
        }
      ],
      "spawn_egg": {
        "base_color": "#c7612e",
        "overlay_color": "#2a3233"
      },
      "enable_attachables": false
    }
  }
}
