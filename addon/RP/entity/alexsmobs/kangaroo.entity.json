{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:kangaroo",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/kangaroo"
      },
      "geometry": {
        "default": "geometry.alexsmobs.kangaroo"
      },
      "animations": {
        "idle": "animation.alexsmobs.kangaroo.idle",
        "breathe": "animation.alexsmobs.kangaroo.breathe",
        "walk": "animation.alexsmobs.kangaroo.walk",
        "run": "animation.alexsmobs.kangaroo.run",
        "pose_sit": "animation.alexsmobs.kangaroo.pose_sit",
        "pose_stand": "animation.alexsmobs.kangaroo.pose_stand",
        "look": "animation.alexsmobs.kangaroo.look",
        "baby": "animation.alexsmobs.kangaroo.baby",
        "eat_grass": "animation.alexsmobs.kangaroo.eat_grass",
        "kick": "animation.alexsmobs.kangaroo.kick",
        "punch_r": "animation.alexsmobs.kangaroo.punch_r",
        "punch_l": "animation.alexsmobs.kangaroo.punch_l",
        "death_0": "animation.alexsmobs.kangaroo.death_0",
        "death_1": "animation.alexsmobs.kangaroo.death_1",
        "hurt": "animation.alexsmobs.kangaroo.hurt",
        "idle_look": "animation.alexsmobs.kangaroo.idle_look",
        "idle_sniff": "animation.alexsmobs.kangaroo.idle_sniff",
        "idle_shake": "animation.alexsmobs.kangaroo.idle_shake",
        "idle_tail": "animation.alexsmobs.kangaroo.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.kangaroo.move",
        "ctrl_idles": "controller.animation.alexsmobs.kangaroo.idles",
        "ctrl_attack": "controller.animation.alexsmobs.kangaroo.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.kangaroo.hurt",
        "ctrl_death": "controller.animation.alexsmobs.kangaroo.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.8;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.45, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && !v.is_moving && q.is_on_ground;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.kangaroo"
      ],
      "spawn_egg": {
        "base_color": "#ce9d65",
        "overlay_color": "#debda0"
      },
      "enable_attachables": false
    }
  }
}
