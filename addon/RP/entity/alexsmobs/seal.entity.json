      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/seal/seal_brown_0",
        "v1": "textures/entity/alexsmobs/seal/seal_brown_1",
        "v2": "textures/entity/alexsmobs/seal/seal_arctic_0",
        "v3": "textures/entity/alexsmobs/seal/seal_arctic_1"
      },
      "geometry": {
        "default": "geometry.alexsmobs.seal"
      },
      "animations": {
        "breathe": "animation.alexsmobs.seal.breathe",
        "walk": "animation.alexsmobs.seal.walk",
        "run": "animation.alexsmobs.seal.run",
        "look": "animation.alexsmobs.seal.look",
        "baby": "animation.alexsmobs.seal.baby",
        "attack_bite": "animation.alexsmobs.seal.attack_bite",
        "death_0": "animation.alexsmobs.seal.death_0",
        "death_1": "animation.alexsmobs.seal.death_1",
        "hurt": "animation.alexsmobs.seal.hurt",
        "idle_look": "animation.alexsmobs.seal.idle_look",
        "idle_sniff": "animation.alexsmobs.seal.idle_sniff",
        "idle_shake": "animation.alexsmobs.seal.idle_shake",
        "idle_tail": "animation.alexsmobs.seal.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.seal.move",
        "ctrl_idles": "controller.animation.alexsmobs.seal.idles",
        "ctrl_attack": "controller.animation.alexsmobs.seal.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.seal.hurt",
        "ctrl_death": "controller.animation.alexsmobs.seal.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.063;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.16200000643730164, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.seal"
      ],
      "spawn_egg": {
        "base_color": "#483c32",
        "overlay_color": "#66594c"
      },
      "enable_attachables": false
    }
  }
