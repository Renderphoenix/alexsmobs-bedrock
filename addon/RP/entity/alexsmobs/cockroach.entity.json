{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:cockroach",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/cockroach"
      },
      "geometry": {
        "default": "geometry.alexsmobs.cockroach"
      },
      "animations": {
        "idle": "animation.alexsmobs.cockroach.idle",
        "breathe": "animation.alexsmobs.cockroach.breathe",
        "walk": "animation.alexsmobs.cockroach.walk",
        "run": "animation.alexsmobs.cockroach.run",
        "look": "animation.alexsmobs.cockroach.look",
        "baby": "animation.alexsmobs.cockroach.baby",
        "death_0": "animation.alexsmobs.cockroach.death_0",
        "death_1": "animation.alexsmobs.cockroach.death_1",
        "hurt": "animation.alexsmobs.cockroach.hurt",
        "idle_look": "animation.alexsmobs.cockroach.idle_look",
        "idle_sniff": "animation.alexsmobs.cockroach.idle_sniff",
        "idle_shake": "animation.alexsmobs.cockroach.idle_shake",
        "idle_wings": "animation.alexsmobs.cockroach.idle_wings",
        "air_jump": "animation.alexsmobs.cockroach.air_jump",
        "air_fall": "animation.alexsmobs.cockroach.air_fall",
        "air_land": "animation.alexsmobs.cockroach.air_land",
        "ctrl_move": "controller.animation.alexsmobs.cockroach.move",
        "ctrl_air": "controller.animation.alexsmobs.cockroach.air",
        "ctrl_idles": "controller.animation.alexsmobs.cockroach.idles",
        "ctrl_hurt": "controller.animation.alexsmobs.cockroach.hurt",
        "ctrl_death": "controller.animation.alexsmobs.cockroach.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.56;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.314999994635582, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.cockroach"
      ],
      "spawn_egg": {
        "base_color": "#0d0909",
        "overlay_color": "#42241e"
      },
      "enable_attachables": false
    }
  }
}
