{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:centipede_head",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/cave_centipede",
        "glow": "textures/entity/alexsmobs/cave_centipede_eyes"
      },
      "geometry": {
        "default": "geometry.alexsmobs.centipede_head"
      },
      "animations": {
        "idle": "animation.alexsmobs.centipede_head.idle",
        "breathe": "animation.alexsmobs.centipede_head.breathe",
        "walk": "animation.alexsmobs.centipede_head.walk",
        "run": "animation.alexsmobs.centipede_head.run",
        "look": "animation.alexsmobs.centipede_head.look",
        "baby": "animation.alexsmobs.centipede_head.baby",
        "attack_bite": "animation.alexsmobs.centipede_head.attack_bite",
        "death_0": "animation.alexsmobs.centipede_head.death_0",
        "death_1": "animation.alexsmobs.centipede_head.death_1",
        "hurt": "animation.alexsmobs.centipede_head.hurt",
        "idle_look": "animation.alexsmobs.centipede_head.idle_look",
        "idle_sniff": "animation.alexsmobs.centipede_head.idle_sniff",
        "ctrl_move": "controller.animation.alexsmobs.centipede_head.move",
        "ctrl_idles": "controller.animation.alexsmobs.centipede_head.idles",
        "ctrl_attack": "controller.animation.alexsmobs.centipede_head.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.centipede_head.hurt",
        "ctrl_death": "controller.animation.alexsmobs.centipede_head.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.077;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.1979999989271164, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.centipede_head",
        "controller.render.alexsmobs.centipede_head.glow"
      ],
      "spawn_egg": {
        "base_color": "#342b2e",
        "overlay_color": "#733449"
      },
      "enable_attachables": false
    }
  }
}
