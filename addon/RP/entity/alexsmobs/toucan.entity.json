{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:toucan",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/toucan/toucan_0",
        "v1": "textures/entity/alexsmobs/toucan/toucan_1",
        "v2": "textures/entity/alexsmobs/toucan/toucan_2",
        "v3": "textures/entity/alexsmobs/toucan/toucan_3"
      },
      "geometry": {
        "default": "geometry.alexsmobs.toucan"
      },
      "animations": {
        "idle": "animation.alexsmobs.toucan.idle",
        "breathe": "animation.alexsmobs.toucan.breathe",
        "walk": "animation.alexsmobs.toucan.walk",
        "run": "animation.alexsmobs.toucan.run",
        "fly": "animation.alexsmobs.toucan.fly",
        "look": "animation.alexsmobs.toucan.look",
        "baby": "animation.alexsmobs.toucan.baby",
        "death_0": "animation.alexsmobs.toucan.death_0",
        "death_1": "animation.alexsmobs.toucan.death_1",
        "hurt": "animation.alexsmobs.toucan.hurt",
        "idle_look": "animation.alexsmobs.toucan.idle_look",
        "idle_sniff": "animation.alexsmobs.toucan.idle_sniff",
        "idle_shake": "animation.alexsmobs.toucan.idle_shake",
        "idle_wings": "animation.alexsmobs.toucan.idle_wings",
        "idle_tail": "animation.alexsmobs.toucan.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.toucan.move",
        "ctrl_idles": "controller.animation.alexsmobs.toucan.idles",
        "ctrl_hurt": "controller.animation.alexsmobs.toucan.hurt",
        "ctrl_death": "controller.animation.alexsmobs.toucan.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.toucan"
      ],
      "spawn_egg": {
        "base_color": "#f58f33",
        "overlay_color": "#1e2133"
      },
      "enable_attachables": false
    }
  }
}
