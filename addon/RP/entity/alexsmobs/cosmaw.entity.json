        "fly": "animation.alexsmobs.cosmaw.fly",
        "attack_bite": "animation.alexsmobs.cosmaw.attack_bite",
        "death_0": "animation.alexsmobs.cosmaw.death_0",
        "death_1": "animation.alexsmobs.cosmaw.death_1",
