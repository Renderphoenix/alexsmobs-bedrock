{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:emu",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/emu",
        "v1": "textures/entity/alexsmobs/emu_blonde",
        "v2": "textures/entity/alexsmobs/emu_blue",
        "baby": "textures/entity/alexsmobs/emu_baby"
      },
      "geometry": {
        "default": "geometry.alexsmobs.emu"
      },
      "animations": {
        "pose": "animation.alexsmobs.emu.pose",
        "dodge_right": "animation.alexsmobs.emu.dodge_right",
        "dodge_left": "animation.alexsmobs.emu.dodge_left",
        "puzzled": "animation.alexsmobs.emu.puzzled",
        "peck_ground": "animation.alexsmobs.emu.peck_ground",
        "scratch": "animation.alexsmobs.emu.scratch",
        "death_0": "animation.alexsmobs.emu.death_0",
        "death_1": "animation.alexsmobs.emu.death_1",
        "hurt": "animation.alexsmobs.emu.hurt",
        "idle_look": "animation.alexsmobs.emu.idle_look",
        "idle_sniff": "animation.alexsmobs.emu.idle_sniff",
        "idle_shake": "animation.alexsmobs.emu.idle_shake",
        "idle_tail": "animation.alexsmobs.emu.idle_tail",
        "ctrl_idle": "controller.animation.alexsmobs.emu.idle",
        "ctrl_death": "controller.animation.alexsmobs.emu.death",
        "ctrl_hurt": "controller.animation.alexsmobs.emu.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 0;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && q.ground_speed < 0.05;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;"
        ],
        "animate": [
          "pose",
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.emu"
      ],
      "spawn_egg": {
        "base_color": "#665346",
        "overlay_color": "#3b3938"
      },
      "enable_attachables": false
    }
  }
}
