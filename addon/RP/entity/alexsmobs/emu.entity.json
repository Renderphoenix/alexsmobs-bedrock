{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:emu",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/emu",
        "v1": "textures/entity/alexsmobs/emu_blonde",
        "v2": "textures/entity/alexsmobs/emu_blue",
        "baby": "textures/entity/alexsmobs/emu_baby"
      },
      "geometry": {
        "default": "geometry.alexsmobs.emu"
      },
      "animations": {
        "idle": "animation.alexsmobs.emu.idle",
        "breathe": "animation.alexsmobs.emu.breathe",
        "walk": "animation.alexsmobs.emu.walk",
        "run": "animation.alexsmobs.emu.run",
        "look": "animation.alexsmobs.emu.look",
        "baby": "animation.alexsmobs.emu.baby",
        "dodge_right": "animation.alexsmobs.emu.dodge_right",
        "dodge_left": "animation.alexsmobs.emu.dodge_left",
        "puzzled": "animation.alexsmobs.emu.puzzled",
        "peck_ground": "animation.alexsmobs.emu.peck_ground",
        "scratch": "animation.alexsmobs.emu.scratch",
        "attack_bite": "animation.alexsmobs.emu.attack_bite",
        "death_0": "animation.alexsmobs.emu.death_0",
        "death_1": "animation.alexsmobs.emu.death_1",
        "hurt": "animation.alexsmobs.emu.hurt",
        "idle_look": "animation.alexsmobs.emu.idle_look",
        "idle_sniff": "animation.alexsmobs.emu.idle_sniff",
        "idle_shake": "animation.alexsmobs.emu.idle_shake",
        "idle_tail": "animation.alexsmobs.emu.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.emu.move",
        "ctrl_idles": "controller.animation.alexsmobs.emu.idles",
        "ctrl_attack": "controller.animation.alexsmobs.emu.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.emu.hurt",
        "ctrl_death": "controller.animation.alexsmobs.emu.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.56;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.314999994635582, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.emu"
      ],
      "spawn_egg": {
        "base_color": "#665346",
        "overlay_color": "#3b3938"
      },
      "enable_attachables": false
    }
  }
}
