{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:flying_fish",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/flying_fish_0",
        "v1": "textures/entity/alexsmobs/flying_fish_1",
        "v2": "textures/entity/alexsmobs/flying_fish_2"
      },
      "geometry": {
        "default": "geometry.alexsmobs.flying_fish"
      },
      "animations": {
        "idle": "animation.alexsmobs.flying_fish.idle",
        "breathe": "animation.alexsmobs.flying_fish.breathe",
        "swim": "animation.alexsmobs.flying_fish.swim",
        "fly": "animation.alexsmobs.flying_fish.fly",
        "death_0": "animation.alexsmobs.flying_fish.death_0",
        "death_1": "animation.alexsmobs.flying_fish.death_1",
        "hurt": "animation.alexsmobs.flying_fish.hurt",
        "ctrl_move": "controller.animation.alexsmobs.flying_fish.move",
        "ctrl_hurt": "controller.animation.alexsmobs.flying_fish.hurt",
        "ctrl_death": "controller.animation.alexsmobs.flying_fish.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.48;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.27000001072883606, 0.35, 2.4);",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_hurt",
          "ctrl_death"
        ],
        "scale": "0.8"
      },
      "render_controllers": [
        "controller.render.alexsmobs.flying_fish"
      ],
      "spawn_egg": {
        "base_color": "#7bbced",
        "overlay_color": "#6881b3"
      },
      "enable_attachables": false
    }
  }
}
