        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/stradpole"
      },
      "geometry": {
        "default": "geometry.alexsmobs.stradpole"
      },
      "animations": {
        "idle": "animation.alexsmobs.stradpole.idle",
        "breathe": "animation.alexsmobs.stradpole.breathe",
        "walk": "animation.alexsmobs.stradpole.walk",
        "run": "animation.alexsmobs.stradpole.run",
        "look": "animation.alexsmobs.stradpole.look",
        "death_0": "animation.alexsmobs.stradpole.death_0",
        "death_1": "animation.alexsmobs.stradpole.death_1",
        "hurt": "animation.alexsmobs.stradpole.hurt",
        "idle_shake": "animation.alexsmobs.stradpole.idle_shake",
        "idle_tail": "animation.alexsmobs.stradpole.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.stradpole.move",
        "ctrl_idles": "controller.animation.alexsmobs.stradpole.idles",
        "ctrl_hurt": "controller.animation.alexsmobs.stradpole.hurt",
        "ctrl_death": "controller.animation.alexsmobs.stradpole.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.48;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.27000001072883606, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_hurt",
          "ctrl_death"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.stradpole"
      ],
      "spawn_egg": {
        "base_color": "#5d5f6e",
        "overlay_color": "#576a8b"
      },
      "enable_attachables": false
    }
  }
