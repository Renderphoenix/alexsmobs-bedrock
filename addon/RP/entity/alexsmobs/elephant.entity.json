{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:elephant",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/elephant/elephant",
        "overlay": "textures/entity/alexsmobs/elephant/elephant_tusks"
      },
      "geometry": {
        "default": "geometry.alexsmobs.elephant"
      },
      "animations": {
        "idle": "animation.alexsmobs.elephant.idle",
        "breathe": "animation.alexsmobs.elephant.breathe",
        "walk": "animation.alexsmobs.elephant.walk",
        "run": "animation.alexsmobs.elephant.run",
        "pose_sit": "animation.alexsmobs.elephant.pose_sit",
        "pose_stand": "animation.alexsmobs.elephant.pose_stand",
        "look": "animation.alexsmobs.elephant.look",
        "baby": "animation.alexsmobs.elephant.baby",
        "trumpet_0": "animation.alexsmobs.elephant.trumpet_0",
        "trumpet_1": "animation.alexsmobs.elephant.trumpet_1",
        "charge_prepare": "animation.alexsmobs.elephant.charge_prepare",
        "stomp": "animation.alexsmobs.elephant.stomp",
        "fling": "animation.alexsmobs.elephant.fling",
        "eat": "animation.alexsmobs.elephant.eat",
        "breakleaves": "animation.alexsmobs.elephant.breakleaves",
        "lg_trumpet": "animation.alexsmobs.elephant.lg_trumpet",
        "lg_eat": "animation.alexsmobs.elephant.lg_eat",
        "death_0": "animation.alexsmobs.elephant.death_0",
        "death_1": "animation.alexsmobs.elephant.death_1",
        "hurt": "animation.alexsmobs.elephant.hurt",
        "idle_look": "animation.alexsmobs.elephant.idle_look",
        "idle_sniff": "animation.alexsmobs.elephant.idle_sniff",
        "idle_shake": "animation.alexsmobs.elephant.idle_shake",
        "idle_tail": "animation.alexsmobs.elephant.idle_tail",
        "air_jump": "animation.alexsmobs.elephant.air_jump",
        "air_fall": "animation.alexsmobs.elephant.air_fall",
        "air_land": "animation.alexsmobs.elephant.air_land",
        "ctrl_move": "controller.animation.alexsmobs.elephant.move",
        "ctrl_air": "controller.animation.alexsmobs.elephant.air",
        "ctrl_idles": "controller.animation.alexsmobs.elephant.idles",
        "ctrl_attack": "controller.animation.alexsmobs.elephant.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.elephant.hurt",
        "ctrl_death": "controller.animation.alexsmobs.elephant.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.56;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.314999994635582, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && !v.is_moving && q.is_on_ground;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ],
        "scale": "1.1"
      },
      "render_controllers": [
        "controller.render.alexsmobs.elephant",
        "controller.render.alexsmobs.elephant.overlay"
      ],
      "spawn_egg": {
        "base_color": "#8d8987",
        "overlay_color": "#ede5d1"
      },
      "enable_attachables": false
    }
  }
}
