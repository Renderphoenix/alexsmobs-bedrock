{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:anteater",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/anteater"
      },
      "geometry": {
        "default": "geometry.alexsmobs.anteater"
      },
      "animations": {
        "idle": "animation.alexsmobs.anteater.idle",
        "breathe": "animation.alexsmobs.anteater.breathe",
        "walk": "animation.alexsmobs.anteater.walk",
        "run": "animation.alexsmobs.anteater.run",
        "pose_stand": "animation.alexsmobs.anteater.pose_stand",
        "look": "animation.alexsmobs.anteater.look",
        "baby": "animation.alexsmobs.anteater.baby",
        "slash_l": "animation.alexsmobs.anteater.slash_l",
        "slash_r": "animation.alexsmobs.anteater.slash_r",
        "lg_idle_sniff": "animation.alexsmobs.anteater.lg_idle_sniff",
        "lg_idle_tongue": "animation.alexsmobs.anteater.lg_idle_tongue",
        "lg_threat": "animation.alexsmobs.anteater.lg_threat",
        "death_0": "animation.alexsmobs.anteater.death_0",
        "death_1": "animation.alexsmobs.anteater.death_1",
        "hurt": "animation.alexsmobs.anteater.hurt",
        "idle_look": "animation.alexsmobs.anteater.idle_look",
        "idle_sniff": "animation.alexsmobs.anteater.idle_sniff",
        "idle_shake": "animation.alexsmobs.anteater.idle_shake",
        "idle_tail": "animation.alexsmobs.anteater.idle_tail",
        "air_jump": "animation.alexsmobs.anteater.air_jump",
        "air_fall": "animation.alexsmobs.anteater.air_fall",
        "air_land": "animation.alexsmobs.anteater.air_land",
        "ctrl_move": "controller.animation.alexsmobs.anteater.move",
        "ctrl_air": "controller.animation.alexsmobs.anteater.air",
        "ctrl_idles": "controller.animation.alexsmobs.anteater.idles",
        "ctrl_attack": "controller.animation.alexsmobs.anteater.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.anteater.hurt",
        "ctrl_death": "controller.animation.alexsmobs.anteater.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && !v.is_moving && q.is_on_ground;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.anteater"
      ],
      "spawn_egg": {
        "base_color": "#4c3f3a",
        "overlay_color": "#ccbcb4"
      },
      "enable_attachables": false
    }
  }
}
