{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:raccoon",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/raccoon",
        "glow": "textures/entity/alexsmobs/raccoon_eyes"
      },
      "geometry": {
        "default": "geometry.alexsmobs.raccoon"
      },
      "animations": {
        "pose": "animation.alexsmobs.raccoon.pose",
        "attack": "animation.alexsmobs.raccoon.attack",
        "death_0": "animation.alexsmobs.raccoon.death_0",
        "death_1": "animation.alexsmobs.raccoon.death_1",
        "hurt": "animation.alexsmobs.raccoon.hurt",
        "idle_look": "animation.alexsmobs.raccoon.idle_look",
        "idle_sniff": "animation.alexsmobs.raccoon.idle_sniff",
        "idle_shake": "animation.alexsmobs.raccoon.idle_shake",
        "idle_tail": "animation.alexsmobs.raccoon.idle_tail",
        "ctrl_attack": "controller.animation.alexsmobs.raccoon.attack",
        "ctrl_idle": "controller.animation.alexsmobs.raccoon.idle",
        "ctrl_death": "controller.animation.alexsmobs.raccoon.death",
        "ctrl_hurt": "controller.animation.alexsmobs.raccoon.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 0;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;",
          "v.p_begprogress = math.clamp((v.p_begprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_standprogress = math.clamp((v.p_standprogress ?? 0) + ((v.am_standing) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_sitprogress = math.clamp((v.p_sitprogress ?? 0) + ((q.is_sitting) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_washprogress = math.clamp((v.p_washprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);"
        ],
        "animate": [
          "pose",
          "ctrl_attack",
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.raccoon",
        "controller.render.alexsmobs.raccoon.glow"
      ],
      "spawn_egg": {
        "base_color": "#85827e",
        "overlay_color": "#2a2726"
      },
      "enable_attachables": false
    }
  }
}
