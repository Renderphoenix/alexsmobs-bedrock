{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:raccoon",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/raccoon",
        "glow": "textures/entity/alexsmobs/raccoon_eyes"
      },
      "geometry": {
        "default": "geometry.alexsmobs.raccoon"
      },
      "animations": {
        "idle": "animation.alexsmobs.raccoon.idle",
        "breathe": "animation.alexsmobs.raccoon.breathe",
        "walk": "animation.alexsmobs.raccoon.walk",
        "run": "animation.alexsmobs.raccoon.run",
        "pose_sit": "animation.alexsmobs.raccoon.pose_sit",
        "pose_stand": "animation.alexsmobs.raccoon.pose_stand",
        "look": "animation.alexsmobs.raccoon.look",
        "baby": "animation.alexsmobs.raccoon.baby",
        "attack": "animation.alexsmobs.raccoon.attack",
        "death_0": "animation.alexsmobs.raccoon.death_0",
        "death_1": "animation.alexsmobs.raccoon.death_1",
        "hurt": "animation.alexsmobs.raccoon.hurt",
        "idle_look": "animation.alexsmobs.raccoon.idle_look",
        "idle_sniff": "animation.alexsmobs.raccoon.idle_sniff",
        "idle_shake": "animation.alexsmobs.raccoon.idle_shake",
        "idle_tail": "animation.alexsmobs.raccoon.idle_tail",
        "air_jump": "animation.alexsmobs.raccoon.air_jump",
        "air_fall": "animation.alexsmobs.raccoon.air_fall",
        "air_land": "animation.alexsmobs.raccoon.air_land",
        "ctrl_move": "controller.animation.alexsmobs.raccoon.move",
        "ctrl_air": "controller.animation.alexsmobs.raccoon.air",
        "ctrl_idles": "controller.animation.alexsmobs.raccoon.idles",
        "ctrl_attack": "controller.animation.alexsmobs.raccoon.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.raccoon.hurt",
        "ctrl_death": "controller.animation.alexsmobs.raccoon.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && !v.is_moving && q.is_on_ground;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.raccoon",
        "controller.render.alexsmobs.raccoon.glow"
      ],
      "spawn_egg": {
        "base_color": "#85827e",
        "overlay_color": "#2a2726"
      },
      "enable_attachables": false
    }
  }
}
