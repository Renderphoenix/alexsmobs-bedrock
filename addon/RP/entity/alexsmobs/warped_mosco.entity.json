        "ctrl_hurt": "controller.animation.alexsmobs.warped_mosco.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 0;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;",
          "v.p_leftflyprogress = math.clamp((v.p_leftflyprogress ?? 0) + ((v.am_flying) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_flyleftprogress = math.clamp((v.p_flyleftprogress ?? 0) + ((v.am_flying) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_flyrightprogress = math.clamp((v.p_flyrightprogress ?? 0) + ((v.am_flying) ? 1 : -1) * q.delta_time * 20, 0, 5);"
        ],
        "animate": [
          "pose",
          "ctrl_attack",
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
