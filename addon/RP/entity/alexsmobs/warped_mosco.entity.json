        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/warped_mosco",
        "glow": "textures/entity/alexsmobs/warped_mosco_glow"
      },
      "geometry": {
        "default": "geometry.alexsmobs.warped_mosco"
      },
      "animations": {
        "idle": "animation.alexsmobs.warped_mosco.idle",
        "breathe": "animation.alexsmobs.warped_mosco.breathe",
        "walk": "animation.alexsmobs.warped_mosco.walk",
        "run": "animation.alexsmobs.warped_mosco.run",
        "fly": "animation.alexsmobs.warped_mosco.fly",
        "look": "animation.alexsmobs.warped_mosco.look",
        "baby": "animation.alexsmobs.warped_mosco.baby",
        "punch_r": "animation.alexsmobs.warped_mosco.punch_r",
        "punch_l": "animation.alexsmobs.warped_mosco.punch_l",
        "slam": "animation.alexsmobs.warped_mosco.slam",
        "suck": "animation.alexsmobs.warped_mosco.suck",
        "spit": "animation.alexsmobs.warped_mosco.spit",
        "death_0": "animation.alexsmobs.warped_mosco.death_0",
        "death_1": "animation.alexsmobs.warped_mosco.death_1",
        "hurt": "animation.alexsmobs.warped_mosco.hurt",
        "idle_look": "animation.alexsmobs.warped_mosco.idle_look",
        "idle_sniff": "animation.alexsmobs.warped_mosco.idle_sniff",
        "idle_shake": "animation.alexsmobs.warped_mosco.idle_shake",
        "idle_wings": "animation.alexsmobs.warped_mosco.idle_wings",
        "air_jump": "animation.alexsmobs.warped_mosco.air_jump",
        "air_fall": "animation.alexsmobs.warped_mosco.air_fall",
        "air_land": "animation.alexsmobs.warped_mosco.air_land",
        "ctrl_move": "controller.animation.alexsmobs.warped_mosco.move",
        "ctrl_air": "controller.animation.alexsmobs.warped_mosco.air",
        "ctrl_idles": "controller.animation.alexsmobs.warped_mosco.idles",
        "ctrl_attack": "controller.animation.alexsmobs.warped_mosco.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.warped_mosco.hurt",
        "ctrl_death": "controller.animation.alexsmobs.warped_mosco.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.48;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.27, 0.35, 2.4);",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.warped_mosco",
        "controller.render.alexsmobs.warped_mosco.glow"
      ],
      "spawn_egg": {
        "base_color": "#322f58",
        "overlay_color": "#5b5ef1"
      },
      "enable_attachables": false
    }
  }
}
