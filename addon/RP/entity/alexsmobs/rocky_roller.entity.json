{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:rocky_roller",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/rocky_roller",
        "angry0": "textures/entity/alexsmobs/rocky_roller_angry"
      },
      "geometry": {
        "default": "geometry.alexsmobs.rocky_roller"
      },
      "animations": {
        "idle": "animation.alexsmobs.rocky_roller.idle",
        "breathe": "animation.alexsmobs.rocky_roller.breathe",
        "walk": "animation.alexsmobs.rocky_roller.walk",
        "run": "animation.alexsmobs.rocky_roller.run",
        "look": "animation.alexsmobs.rocky_roller.look",
        "baby": "animation.alexsmobs.rocky_roller.baby",
        "attack_bite": "animation.alexsmobs.rocky_roller.attack_bite",
        "death_0": "animation.alexsmobs.rocky_roller.death_0",
        "death_1": "animation.alexsmobs.rocky_roller.death_1",
        "hurt": "animation.alexsmobs.rocky_roller.hurt",
        "idle_look": "animation.alexsmobs.rocky_roller.idle_look",
        "idle_sniff": "animation.alexsmobs.rocky_roller.idle_sniff",
        "idle_shake": "animation.alexsmobs.rocky_roller.idle_shake",
        "idle_tail": "animation.alexsmobs.rocky_roller.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.rocky_roller.move",
        "ctrl_idles": "controller.animation.alexsmobs.rocky_roller.idles",
        "ctrl_attack": "controller.animation.alexsmobs.rocky_roller.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.rocky_roller.hurt",
        "ctrl_death": "controller.animation.alexsmobs.rocky_roller.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.rocky_roller"
      ],
      "spawn_egg": {
        "base_color": "#b0856f",
        "overlay_color": "#999184"
      },
      "enable_attachables": false
    }
  }
}
