{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:mungus",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/mungus",
        "overlay": "textures/entity/alexsmobs/mungus_shoes"
      },
      "geometry": {
        "default": "geometry.alexsmobs.mungus"
      },
      "animations": {
        "pose": "animation.alexsmobs.mungus.pose",
        "death_0": "animation.alexsmobs.mungus.death_0",
        "death_1": "animation.alexsmobs.mungus.death_1",
        "hurt": "animation.alexsmobs.mungus.hurt",
        "idle_shake": "animation.alexsmobs.mungus.idle_shake",
        "ctrl_idle": "controller.animation.alexsmobs.mungus.idle",
        "ctrl_death": "controller.animation.alexsmobs.mungus.death",
        "ctrl_hurt": "controller.animation.alexsmobs.mungus.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 0;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && q.ground_speed < 0.05;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;",
          "v.p_swellprogress = math.clamp((v.p_swellprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);"
        ],
        "animate": [
          "pose",
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.mungus",
        "controller.render.alexsmobs.mungus.overlay"
      ],
      "spawn_egg": {
        "base_color": "#836a8d",
        "overlay_color": "#45454c"
      },
      "enable_attachables": false
    }
  }
