        "baby": "textures/entity/alexsmobs/tarantula_hawk_baby"
      },
      "geometry": {
        "default": "geometry.alexsmobs.tarantula_hawk",
        "baby": "geometry.alexsmobs.tarantula_hawk.baby"
      },
      "animations": {
        "idle": "animation.alexsmobs.tarantula_hawk.idle",
        "breathe": "animation.alexsmobs.tarantula_hawk.breathe",
        "walk": "animation.alexsmobs.tarantula_hawk.walk",
        "run": "animation.alexsmobs.tarantula_hawk.run",
        "fly": "animation.alexsmobs.tarantula_hawk.fly",
        "pose_sit": "animation.alexsmobs.tarantula_hawk.pose_sit",
        "look": "animation.alexsmobs.tarantula_hawk.look",
        "attack_bite": "animation.alexsmobs.tarantula_hawk.attack_bite",
        "death_0": "animation.alexsmobs.tarantula_hawk.death_0",
        "death_1": "animation.alexsmobs.tarantula_hawk.death_1",
        "hurt": "animation.alexsmobs.tarantula_hawk.hurt",
        "idle_look": "animation.alexsmobs.tarantula_hawk.idle_look",
        "idle_sniff": "animation.alexsmobs.tarantula_hawk.idle_sniff",
        "idle_shake": "animation.alexsmobs.tarantula_hawk.idle_shake",
        "idle_wings": "animation.alexsmobs.tarantula_hawk.idle_wings",
        "ctrl_move": "controller.animation.alexsmobs.tarantula_hawk.move",
        "ctrl_idles": "controller.animation.alexsmobs.tarantula_hawk.idles",
        "ctrl_attack": "controller.animation.alexsmobs.tarantula_hawk.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.tarantula_hawk.hurt",
        "ctrl_death": "controller.animation.alexsmobs.tarantula_hawk.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.48;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.27000001072883606, 0.35, 2.4);",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.tarantula_hawk"
      ],
      "spawn_egg": {
        "base_color": "#234763",
        "overlay_color": "#e37b38"
      },
      "enable_attachables": false
    }
  }
}
