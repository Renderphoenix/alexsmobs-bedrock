{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:tarantula_hawk",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/tarantula_hawk",
        "baby": "textures/entity/alexsmobs/tarantula_hawk_baby"
      },
      "geometry": {
        "default": "geometry.alexsmobs.tarantula_hawk",
        "baby": "geometry.alexsmobs.tarantula_hawk.baby"
      },
      "animations": {
        "pose": "animation.alexsmobs.tarantula_hawk.pose",
        "pose_baby": "animation.alexsmobs.tarantula_hawk.pose_baby",
        "death_0": "animation.alexsmobs.tarantula_hawk.death_0",
        "death_1": "animation.alexsmobs.tarantula_hawk.death_1",
        "hurt": "animation.alexsmobs.tarantula_hawk.hurt",
        "idle_look": "animation.alexsmobs.tarantula_hawk.idle_look",
        "idle_sniff": "animation.alexsmobs.tarantula_hawk.idle_sniff",
        "idle_shake": "animation.alexsmobs.tarantula_hawk.idle_shake",
        "idle_wings": "animation.alexsmobs.tarantula_hawk.idle_wings",
        "ctrl_idle": "controller.animation.alexsmobs.tarantula_hawk.idle",
        "ctrl_death": "controller.animation.alexsmobs.tarantula_hawk.death",
        "ctrl_hurt": "controller.animation.alexsmobs.tarantula_hawk.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && q.ground_speed < 0.05;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;",
          "v.p_flyprogress = math.clamp((v.p_flyprogress ?? 0) + ((v.am_flying) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_dragprogress = math.clamp((v.p_dragprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_sitprogress = math.clamp((v.p_sitprogress ?? 0) + ((q.is_sitting) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_digprogress = math.clamp((v.p_digprogress ?? 0) + ((v.am_digging) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_attackprogress = math.clamp((v.p_attackprogress ?? 0) + ((q.is_angry) ? 1 : -1) * q.delta_time * 20, 0, 5);"
        ],
        "animate": [
          {
            "pose": "!q.is_baby"
          },
          {
            "pose_baby": "q.is_baby"
          },
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.tarantula_hawk"
      ],
      "spawn_egg": {
        "base_color": "#234763",
        "overlay_color": "#e37b38"
      },
      "enable_attachables": false
    }
  }
}
