{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:cachalot_whale",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/cachalot/cachalot_whale",
        "v1": "textures/entity/alexsmobs/cachalot/cachalot_whale_albino",
        "sleep0": "textures/entity/alexsmobs/cachalot/cachalot_whale_sleeping",
        "sleep1": "textures/entity/alexsmobs/cachalot/cachalot_whale_albino_sleeping"
      },
      "geometry": {
        "default": "geometry.alexsmobs.cachalot_whale"
      },
      "animations": {
        "idle": "animation.alexsmobs.cachalot_whale.idle",
        "breathe": "animation.alexsmobs.cachalot_whale.breathe",
        "swim": "animation.alexsmobs.cachalot_whale.swim",
        "pose_sleep": "animation.alexsmobs.cachalot_whale.pose_sleep",
        "look": "animation.alexsmobs.cachalot_whale.look",
        "baby": "animation.alexsmobs.cachalot_whale.baby",
        "attack_bite": "animation.alexsmobs.cachalot_whale.attack_bite",
        "death_0": "animation.alexsmobs.cachalot_whale.death_0",
        "death_1": "animation.alexsmobs.cachalot_whale.death_1",
        "hurt": "animation.alexsmobs.cachalot_whale.hurt",
        "idle_look": "animation.alexsmobs.cachalot_whale.idle_look",
        "idle_sniff": "animation.alexsmobs.cachalot_whale.idle_sniff",
        "idle_shake": "animation.alexsmobs.cachalot_whale.idle_shake",
        "idle_tail": "animation.alexsmobs.cachalot_whale.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.cachalot_whale.move",
        "ctrl_attack": "controller.animation.alexsmobs.cachalot_whale.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.cachalot_whale.hurt",
        "ctrl_death": "controller.animation.alexsmobs.cachalot_whale.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.1;",
          "v.is_sprinting = q.modified_move_speed >= 0.9;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.6, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = q.property('alexsmobs:sleeping');",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.cachalot_whale"
      ],
      "spawn_egg": {
        "base_color": "#949899",
        "overlay_color": "#5f666e"
      },
      "enable_attachables": false
    }
  }
}
