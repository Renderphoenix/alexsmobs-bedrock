{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:leafcutter_ant",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/leafcutter_ant",
        "angry0": "textures/entity/alexsmobs/leafcutter_ant_angry"
      },
      "geometry": {
        "default": "geometry.alexsmobs.leafcutter_ant"
      },
      "animations": {
        "idle": "animation.alexsmobs.leafcutter_ant.idle",
        "breathe": "animation.alexsmobs.leafcutter_ant.breathe",
        "walk": "animation.alexsmobs.leafcutter_ant.walk",
        "run": "animation.alexsmobs.leafcutter_ant.run",
        "look": "animation.alexsmobs.leafcutter_ant.look",
        "baby": "animation.alexsmobs.leafcutter_ant.baby",
        "bite": "animation.alexsmobs.leafcutter_ant.bite",
        "death_0": "animation.alexsmobs.leafcutter_ant.death_0",
        "death_1": "animation.alexsmobs.leafcutter_ant.death_1",
        "hurt": "animation.alexsmobs.leafcutter_ant.hurt",
        "idle_look": "animation.alexsmobs.leafcutter_ant.idle_look",
        "idle_sniff": "animation.alexsmobs.leafcutter_ant.idle_sniff",
        "idle_shake": "animation.alexsmobs.leafcutter_ant.idle_shake",
        "air_jump": "animation.alexsmobs.leafcutter_ant.air_jump",
        "air_fall": "animation.alexsmobs.leafcutter_ant.air_fall",
        "air_land": "animation.alexsmobs.leafcutter_ant.air_land",
        "ctrl_move": "controller.animation.alexsmobs.leafcutter_ant.move",
        "ctrl_air": "controller.animation.alexsmobs.leafcutter_ant.air",
        "ctrl_idles": "controller.animation.alexsmobs.leafcutter_ant.idles",
        "ctrl_attack": "controller.animation.alexsmobs.leafcutter_ant.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.leafcutter_ant.hurt",
        "ctrl_death": "controller.animation.alexsmobs.leafcutter_ant.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.leafcutter_ant"
      ],
      "spawn_egg": {
        "base_color": "#964023",
        "overlay_color": "#a65930"
      },
      "enable_attachables": false
    }
  }
}
