{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:devils_hole_pupfish",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/devils_hole_pupfish"
      },
      "geometry": {
        "default": "geometry.alexsmobs.devils_hole_pupfish"
      },
      "animations": {
        "pose": "animation.alexsmobs.devils_hole_pupfish.pose",
        "death_0": "animation.alexsmobs.devils_hole_pupfish.death_0",
        "death_1": "animation.alexsmobs.devils_hole_pupfish.death_1",
        "hurt": "animation.alexsmobs.devils_hole_pupfish.hurt",
        "ctrl_death": "controller.animation.alexsmobs.devils_hole_pupfish.death",
        "ctrl_hurt": "controller.animation.alexsmobs.devils_hole_pupfish.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 0;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && q.ground_speed < 0.05;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;",
          "v.p_onlandprogress = math.clamp((v.p_onlandprogress ?? 0) + ((q.is_on_ground) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_feedprogress = math.clamp((v.p_feedprogress ?? 0) + ((v.am_eating) ? 1 : -1) * q.delta_time * 20, 0, 5);"
        ],
        "animate": [
          "pose",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.devils_hole_pupfish"
      ],
      "spawn_egg": {
        "base_color": "#567bc4",
        "overlay_color": "#6c4475"
      },
      "enable_attachables": false
    }
  }
}
