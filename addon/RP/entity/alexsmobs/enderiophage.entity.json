        "run": "animation.alexsmobs.enderiophage.run",
        "fly": "animation.alexsmobs.enderiophage.fly",
        "death_0": "animation.alexsmobs.enderiophage.death_0",
        "death_1": "animation.alexsmobs.enderiophage.death_1",
        "hurt": "animation.alexsmobs.enderiophage.hurt",
        "idle_shake": "animation.alexsmobs.enderiophage.idle_shake",
        "idle_tail": "animation.alexsmobs.enderiophage.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.enderiophage.move",
        "ctrl_idles": "controller.animation.alexsmobs.enderiophage.idles",
        "ctrl_hurt": "controller.animation.alexsmobs.enderiophage.hurt",
        "ctrl_death": "controller.animation.alexsmobs.enderiophage.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.053;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.13500000536441803, 0.35, 2.4);",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_idles",
          "ctrl_hurt",
          "ctrl_death"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.enderiophage",
        "controller.render.alexsmobs.enderiophage.glow"
      ],
      "spawn_egg": {
        "base_color": "#872d83",
        "overlay_color": "#f6e2cd"
      },
      "enable_attachables": false
    }
