{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:giant_squid",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/giant_squid",
        "v1": "textures/entity/alexsmobs/giant_squid_blue"
      },
      "geometry": {
        "default": "geometry.alexsmobs.giant_squid"
      },
      "animations": {
        "idle": "animation.alexsmobs.giant_squid.idle",
        "breathe": "animation.alexsmobs.giant_squid.breathe",
        "swim": "animation.alexsmobs.giant_squid.swim",
        "look": "animation.alexsmobs.giant_squid.look",
        "baby": "animation.alexsmobs.giant_squid.baby",
        "fix": "animation.alexsmobs.giant_squid.fix",
        "attack_bite": "animation.alexsmobs.giant_squid.attack_bite",
        "death_0": "animation.alexsmobs.giant_squid.death_0",
        "death_1": "animation.alexsmobs.giant_squid.death_1",
        "hurt": "animation.alexsmobs.giant_squid.hurt",
        "idle_look": "animation.alexsmobs.giant_squid.idle_look",
        "idle_sniff": "animation.alexsmobs.giant_squid.idle_sniff",
        "ctrl_move": "controller.animation.alexsmobs.giant_squid.move",
        "ctrl_attack": "controller.animation.alexsmobs.giant_squid.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.giant_squid.hurt",
        "ctrl_death": "controller.animation.alexsmobs.giant_squid.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "fix",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.giant_squid"
      ],
      "spawn_egg": {
        "base_color": "#ab4b4d",
        "overlay_color": "#d67d6b"
      },
      "enable_attachables": false
    }
  }
}
