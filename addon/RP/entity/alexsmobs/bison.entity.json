{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:bison",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/bison",
        "v1": "textures/entity/alexsmobs/bison_snowy",
        "baby": "textures/entity/alexsmobs/bison_baby"
      },
      "geometry": {
        "default": "geometry.alexsmobs.bison"
      },
      "animations": {
        "idle": "animation.alexsmobs.bison.idle",
        "breathe": "animation.alexsmobs.bison.breathe",
        "walk": "animation.alexsmobs.bison.walk",
        "run": "animation.alexsmobs.bison.run",
        "look": "animation.alexsmobs.bison.look",
        "baby": "animation.alexsmobs.bison.baby",
        "prepare_charge": "animation.alexsmobs.bison.prepare_charge",
        "eat": "animation.alexsmobs.bison.eat",
        "attack": "animation.alexsmobs.bison.attack",
        "death_0": "animation.alexsmobs.bison.death_0",
        "death_1": "animation.alexsmobs.bison.death_1",
        "hurt": "animation.alexsmobs.bison.hurt",
        "idle_look": "animation.alexsmobs.bison.idle_look",
        "idle_sniff": "animation.alexsmobs.bison.idle_sniff",
        "idle_shake": "animation.alexsmobs.bison.idle_shake",
        "idle_tail": "animation.alexsmobs.bison.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.bison.move",
        "ctrl_idles": "controller.animation.alexsmobs.bison.idles",
        "ctrl_attack": "controller.animation.alexsmobs.bison.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.bison.hurt",
        "ctrl_death": "controller.animation.alexsmobs.bison.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.bison"
      ],
      "spawn_egg": {
        "base_color": "#4c3a2e",
        "overlay_color": "#7a6546"
      },
      "enable_attachables": false
    }
  }
}
