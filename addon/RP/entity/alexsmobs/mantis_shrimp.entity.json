        "death_0": "animation.alexsmobs.mantis_shrimp.death_0",
        "death_1": "animation.alexsmobs.mantis_shrimp.death_1",
        "hurt": "animation.alexsmobs.mantis_shrimp.hurt",
        "idle_look": "animation.alexsmobs.mantis_shrimp.idle_look",
        "idle_sniff": "animation.alexsmobs.mantis_shrimp.idle_sniff",
        "idle_shake": "animation.alexsmobs.mantis_shrimp.idle_shake",
        "idle_tail": "animation.alexsmobs.mantis_shrimp.idle_tail",
