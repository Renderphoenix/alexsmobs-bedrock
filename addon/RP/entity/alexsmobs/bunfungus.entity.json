      },
      "geometry": {
        "default": "geometry.alexsmobs.bunfungus"
      },
      "animations": {
        "idle": "animation.alexsmobs.bunfungus.idle",
        "breathe": "animation.alexsmobs.bunfungus.breathe",
        "walk": "animation.alexsmobs.bunfungus.walk",
        "run": "animation.alexsmobs.bunfungus.run",
        "pose_sleep": "animation.alexsmobs.bunfungus.pose_sleep",
        "look": "animation.alexsmobs.bunfungus.look",
        "baby": "animation.alexsmobs.bunfungus.baby",
        "eat": "animation.alexsmobs.bunfungus.eat",
        "belly": "animation.alexsmobs.bunfungus.belly",
        "slam": "animation.alexsmobs.bunfungus.slam",
        "death_0": "animation.alexsmobs.bunfungus.death_0",
        "death_1": "animation.alexsmobs.bunfungus.death_1",
        "hurt": "animation.alexsmobs.bunfungus.hurt",
        "idle_look": "animation.alexsmobs.bunfungus.idle_look",
        "idle_sniff": "animation.alexsmobs.bunfungus.idle_sniff",
        "idle_shake": "animation.alexsmobs.bunfungus.idle_shake",
        "idle_tail": "animation.alexsmobs.bunfungus.idle_tail",
        "air_jump": "animation.alexsmobs.bunfungus.air_jump",
        "air_fall": "animation.alexsmobs.bunfungus.air_fall",
        "air_land": "animation.alexsmobs.bunfungus.air_land",
        "ctrl_move": "controller.animation.alexsmobs.bunfungus.move",
        "ctrl_air": "controller.animation.alexsmobs.bunfungus.air",
        "ctrl_idles": "controller.animation.alexsmobs.bunfungus.idles",
        "ctrl_attack": "controller.animation.alexsmobs.bunfungus.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.bunfungus.hurt",
        "ctrl_death": "controller.animation.alexsmobs.bunfungus.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.073;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18899999409914017, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = q.property('alexsmobs:sleeping');",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_air",
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.bunfungus"
      ],
      "spawn_egg": {
        "base_color": "#6f6d91",
        "overlay_color": "#c92b29"
      },
      "enable_attachables": false
    }
  }
