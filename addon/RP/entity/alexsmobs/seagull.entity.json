{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:seagull",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/seagull"
      },
      "geometry": {
        "default": "geometry.alexsmobs.seagull"
      },
      "animations": {
        "idle": "animation.alexsmobs.seagull.idle",
        "breathe": "animation.alexsmobs.seagull.breathe",
        "walk": "animation.alexsmobs.seagull.walk",
        "run": "animation.alexsmobs.seagull.run",
        "fly": "animation.alexsmobs.seagull.fly",
        "pose_sit": "animation.alexsmobs.seagull.pose_sit",
        "look": "animation.alexsmobs.seagull.look",
        "baby": "animation.alexsmobs.seagull.baby",
        "attack_bite": "animation.alexsmobs.seagull.attack_bite",
        "death_0": "animation.alexsmobs.seagull.death_0",
        "death_1": "animation.alexsmobs.seagull.death_1",
        "hurt": "animation.alexsmobs.seagull.hurt",
        "idle_look": "animation.alexsmobs.seagull.idle_look",
        "idle_sniff": "animation.alexsmobs.seagull.idle_sniff",
        "idle_shake": "animation.alexsmobs.seagull.idle_shake",
        "idle_wings": "animation.alexsmobs.seagull.idle_wings",
        "idle_tail": "animation.alexsmobs.seagull.idle_tail",
        "ctrl_move": "controller.animation.alexsmobs.seagull.move",
        "ctrl_idles": "controller.animation.alexsmobs.seagull.idles",
        "ctrl_attack": "controller.animation.alexsmobs.seagull.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.seagull.hurt",
        "ctrl_death": "controller.animation.alexsmobs.seagull.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = !q.is_on_ground && !q.is_in_water;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_idles",
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.seagull"
      ],
      "spawn_egg": {
        "base_color": "#c9d2dc",
        "overlay_color": "#ffd850"
      },
      "enable_attachables": false
    }
  }
}
