{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:frilled_shark",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/frilled_shark",
        "overlay": "textures/entity/alexsmobs/frilled_shark_teeth"
      },
      "geometry": {
        "default": "geometry.alexsmobs.frilled_shark"
      },
      "animations": {
        "idle": "animation.alexsmobs.frilled_shark.idle",
        "breathe": "animation.alexsmobs.frilled_shark.breathe",
        "swim": "animation.alexsmobs.frilled_shark.swim",
        "look": "animation.alexsmobs.frilled_shark.look",
        "baby": "animation.alexsmobs.frilled_shark.baby",
        "attack": "animation.alexsmobs.frilled_shark.attack",
        "death_0": "animation.alexsmobs.frilled_shark.death_0",
        "death_1": "animation.alexsmobs.frilled_shark.death_1",
        "hurt": "animation.alexsmobs.frilled_shark.hurt",
        "idle_look": "animation.alexsmobs.frilled_shark.idle_look",
        "idle_sniff": "animation.alexsmobs.frilled_shark.idle_sniff",
        "ctrl_move": "controller.animation.alexsmobs.frilled_shark.move",
        "ctrl_attack": "controller.animation.alexsmobs.frilled_shark.attack",
        "ctrl_hurt": "controller.animation.alexsmobs.frilled_shark.hurt",
        "ctrl_death": "controller.animation.alexsmobs.frilled_shark.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.life_py = q.position(1);",
          "v.life_vy = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.07;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.18000000268220903, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;",
          "v.life_vy = math.clamp((q.position(1) - (v.life_py ?? q.position(1))) / math.max(q.delta_time, 0.01), -30, 30);",
          "v.life_py = q.position(1);"
        ],
        "animate": [
          "ctrl_move",
          {
            "look": "!v.am_sleeping && q.is_alive"
          },
          "ctrl_attack",
          "ctrl_hurt",
          "ctrl_death",
          {
            "baby": "q.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.frilled_shark",
        "controller.render.alexsmobs.frilled_shark.overlay"
      ],
      "spawn_egg": {
        "base_color": "#726b6b",
        "overlay_color": "#873d3d"
      },
      "enable_attachables": false
    }
  }
}
