{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:caiman",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/caiman"
      },
      "geometry": {
        "default": "geometry.alexsmobs.caiman"
      },
      "animations": {
        "pose": "animation.alexsmobs.caiman.pose",
        "death_0": "animation.alexsmobs.caiman.death_0",
        "death_1": "animation.alexsmobs.caiman.death_1",
        "hurt": "animation.alexsmobs.caiman.hurt",
        "idle_look": "animation.alexsmobs.caiman.idle_look",
        "idle_sniff": "animation.alexsmobs.caiman.idle_sniff",
        "idle_shake": "animation.alexsmobs.caiman.idle_shake",
        "idle_tail": "animation.alexsmobs.caiman.idle_tail",
        "ctrl_idle": "controller.animation.alexsmobs.caiman.idle",
        "ctrl_death": "controller.animation.alexsmobs.caiman.death",
        "ctrl_hurt": "controller.animation.alexsmobs.caiman.hurt"
      },
      "scripts": {
        "pre_animation": [
          "v.ls = q.modified_distance_moved;",
          "v.lsa = math.clamp(q.modified_move_speed, 0, 1);",
          "v.age = q.life_time * 20;",
          "v.yaw = math.clamp(q.target_y_rotation, -85, 85);",
          "v.pitch = math.clamp(q.target_x_rotation, -60, 60);",
          "v.idle_t = (v.idle_t ?? 0) + q.delta_time;",
          "v.am_flying = 0;",
          "v.am_running = q.modified_move_speed > 0.45;",
          "v.am_sleeping = 0;",
          "v.am_standing = q.property('alexsmobs:angry') && q.ground_speed < 0.05;",
          "v.am_eating = 0; v.am_digging = 0; v.am_rolling = 0; v.am_perching = 0; v.am_dancing = 0;",
          "v.p_swimprogress = math.clamp((v.p_swimprogress ?? 0) + ((q.is_in_water) ? 1 : -1) * q.delta_time * 20, 0, 1);",
          "v.p_holdprogress = math.clamp((v.p_holdprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_vibrateprogress = math.clamp((v.p_vibrateprogress ?? 0) + ((0) ? 1 : -1) * q.delta_time * 20, 0, 5);",
          "v.p_sitprogress = math.clamp((v.p_sitprogress ?? 0) + ((q.is_sitting) ? 1 : -1) * q.delta_time * 20, 0, 5);"
        ],
        "animate": [
          "pose",
          "ctrl_idle",
          "ctrl_death",
          "ctrl_hurt"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.caiman"
      ],
      "spawn_egg": {
        "base_color": "#5c5631",
        "overlay_color": "#bbc45c"
      },
      "enable_attachables": false
    }
  }
}
