{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "alexsmobs:blobfish",
      "materials": {
        "default": "entity_alphatest",
        "overlay": "entity_alphatest",
        "glow": "entity_alphatest"
      },
      "textures": {
        "v0": "textures/entity/alexsmobs/blobfish"
      },
      "geometry": {
        "default": "geometry.alexsmobs.blobfish"
      },
      "animations": {
        "breathe": "animation.alexsmobs.blobfish.breathe",
        "swim": "animation.alexsmobs.blobfish.swim",
        "death_0": "animation.alexsmobs.blobfish.death_0",
        "death_1": "animation.alexsmobs.blobfish.death_1",
        "hurt": "animation.alexsmobs.blobfish.hurt",
        "ctrl_move": "controller.animation.alexsmobs.blobfish.move",
        "ctrl_hurt": "controller.animation.alexsmobs.blobfish.hurt",
        "ctrl_death": "controller.animation.alexsmobs.blobfish.death"
      },
      "scripts": {
        "initialize": [
          "v.is_moving = 0;",
          "v.is_sprinting = 0;",
          "v.anim_speed = 1;",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;"
        ],
        "pre_animation": [
          "v.is_moving = q.modified_move_speed >= 0.087;",
          "v.is_sprinting = q.modified_move_speed >= 0.4;",
          "v.anim_speed = math.clamp(q.modified_move_speed / 0.225, 0.35, 2.4);",
          "v.am_flying = 0;",
          "v.am_sleeping = 0;",
          "v.am_standing = 0;",
          "v.idle_wait = v.idle_wait ?? 4;",
          "v.idle_pick = v.idle_pick ?? 0;",
          "v.atk_pick = v.atk_pick ?? 0;",
          "v.death_pick = v.death_pick ?? 0;"
        ],
        "animate": [
          "ctrl_move",
          "ctrl_hurt",
          "ctrl_death"
        ]
      },
      "render_controllers": [
        "controller.render.alexsmobs.blobfish"
      ],
      "spawn_egg": {
        "base_color": "#dbc6bd",
        "overlay_color": "#9e7a7f"
      },
      "enable_attachables": false
    }
  }
}
