{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alexsmobs.rain_frog.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle",
            "breathe"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "run": "v.is_sprinting"
            },
            {
              "walk": "v.is_moving"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "run": "v.is_sprinting"
            },
            {
              "idle": "!v.is_moving"
            }
          ]
        },
        "run": {
          "animations": [
            "run"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "idle": "!v.is_moving"
            },
            {
              "walk": "q.modified_move_speed < 0.320"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.rain_frog.idles": {
      "initial_state": "default",
      "states": {
        "default": {
          "on_entry": [
            "v.idle_wait = math.random(3, 9);"
          ],
          "transitions": [
            {
              "pick": "q.state_time > v.idle_wait && q.modified_move_speed < 0.07 && q.is_on_ground && !q.is_in_water && !v.am_sleeping && !q.is_sitting && q.is_alive && !q.has_target"
            }
          ]
        },
        "pick": {
          "on_entry": [
            "v.idle_pick = math.random_integer(0, 0);"
          ],
          "transitions": [
            {
              "a0": "v.idle_pick == 0"
            }
          ]
        },
        "a0": {
          "animations": [
            "idle_shake"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.07 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.rain_frog.hurt": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "hurt": "q.hurt_time > 0 && q.is_alive"
            }
          ]
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "blend_transition": 0.05,
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.rain_frog.death": {
      "initial_state": "default",
      "states": {
        "default": {
          "on_entry": [
            "v.death_pick = math.random_integer(0, 1);"
          ],
          "transitions": [
            {
              "dead_0": "!q.is_alive && v.death_pick == 0"
            },
            {
              "dead_1": "!q.is_alive && v.death_pick == 1"
            }
          ]
        },
        "dead_0": {
          "animations": [
            "death_0"
          ],
          "blend_transition": 0.1
        },
        "dead_1": {
          "animations": [
            "death_1"
          ],
          "blend_transition": 0.1
        }
      }
    }
  }
}
