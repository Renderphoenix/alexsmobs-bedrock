{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alexsmobs.moose.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle",
            "breathe"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "run": "v.is_sprinting"
            },
            {
              "walk": "v.is_moving"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "run": "v.is_sprinting"
            },
            {
              "idle": "!v.is_moving"
            }
          ]
        },
        "run": {
          "animations": [
            "run"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "idle": "!v.is_moving"
            },
            {
              "walk": "q.modified_move_speed < 0.320"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.moose.idles": {
      "initial_state": "default",
      "states": {
        "default": {
          "on_entry": [
            "v.idle_wait = math.random(3, 9);"
          ],
          "transitions": [
            {
              "pick": "q.state_time > v.idle_wait && q.modified_move_speed < 0.087 && q.is_on_ground && !q.is_in_water && !v.am_sleeping && !q.is_sitting && q.is_alive && !q.has_target"
            }
          ]
        },
        "pick": {
          "on_entry": [
            "v.idle_pick = math.random_integer(0, 3);"
          ],
          "transitions": [
            {
              "a0": "v.idle_pick == 0"
            },
            {
              "a1": "v.idle_pick == 1"
            },
            {
              "a2": "v.idle_pick == 2"
            },
            {
              "a3": "v.idle_pick == 3"
            }
          ]
        },
        "a0": {
          "animations": [
            "eat_grass"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.087 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a1": {
          "animations": [
            "idle_look"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.087 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a2": {
          "animations": [
            "idle_sniff"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.087 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a3": {
          "animations": [
            "idle_shake"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.087 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.moose.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "a0": "v.attack_time > 0 && q.is_alive"
            }
          ]
        },
        "a0": {
          "animations": [
            "attack"
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.moose.air": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "jump": "v.life_vy > 2 && !q.is_in_water && !v.am_sleeping"
            },
            {
              "fall": "v.life_vy < -5 && !q.is_on_ground && !q.is_in_water"
            }
          ]
        },
        "jump": {
          "animations": [
            {
              "air_jump": "q.is_baby ? 1 : 0.55"
            }
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "land": "q.state_time > 0.3 && v.life_vy <= 0.5 && q.is_on_ground"
            },
            {
              "fall": "v.life_vy < -5"
            },
            {
              "default": "q.is_in_water || q.state_time > 2"
            }
          ]
        },
        "fall": {
          "animations": [
            {
              "air_fall": "q.is_baby ? 1 : 0.55"
            }
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "land": "q.is_on_ground"
            },
            {
              "default": "q.is_in_water"
            }
          ]
        },
        "land": {
          "animations": [
            {
              "air_land": "q.is_baby ? 1 : 0.55"
            }
          ],
          "blend_transition": 0.08,
          "transitions": [
            {
              "default": "q.any_animation_finished"
            },
            {
              "jump": "v.life_vy > 2"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.moose.hurt": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "hurt": "q.hurt_time > 0 && q.is_alive"
            }
          ]
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "blend_transition": 0.05,
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.moose.death": {
      "initial_state": "default",
      "states": {
        "default": {
          "on_entry": [
            "v.death_pick = math.random_integer(0, 1);"
          ],
          "transitions": [
            {
              "dead_0": "!q.is_alive && v.death_pick == 0"
            },
            {
              "dead_1": "!q.is_alive && v.death_pick == 1"
            }
          ]
        },
        "dead_0": {
          "animations": [
            "death_0"
          ],
          "blend_transition": 0.1
        },
        "dead_1": {
          "animations": [
            "death_1"
          ],
          "blend_transition": 0.1
        }
      }
    }
  }
}
