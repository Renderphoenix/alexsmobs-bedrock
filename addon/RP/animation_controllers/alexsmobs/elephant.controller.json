{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alexsmobs.elephant.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle",
            "breathe"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "sit": "q.is_sitting && !v.am_sleeping"
            },
            {
              "stand": "v.am_standing"
            },
            {
              "run": "v.is_sprinting"
            },
            {
              "walk": "v.is_moving"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "sit": "q.is_sitting && !v.am_sleeping"
            },
            {
              "stand": "v.am_standing"
            },
            {
              "run": "v.is_sprinting"
            },
            {
              "idle": "!v.is_moving"
            }
          ]
        },
        "run": {
          "animations": [
            "run"
          ],
          "blend_transition": 0.25,
          "transitions": [
            {
              "sit": "q.is_sitting && !v.am_sleeping"
            },
            {
              "stand": "v.am_standing"
            },
            {
              "idle": "!v.is_moving"
            },
            {
              "walk": "q.modified_move_speed < 0.448"
            }
          ]
        },
        "sit": {
          "animations": [
            "pose_sit",
            "breathe"
          ],
          "blend_transition": 0.5,
          "transitions": [
            {
              "idle": "!q.is_sitting || v.am_sleeping"
            }
          ]
        },
        "stand": {
          "animations": [
            "pose_stand",
            "breathe"
          ],
          "blend_transition": 0.45,
          "transitions": [
            {
              "idle": "!v.am_standing"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.elephant.idles": {
      "initial_state": "default",
      "states": {
        "default": {
          "on_entry": [
            "v.idle_wait = math.random(3, 9);"
          ],
          "transitions": [
            {
              "pick": "q.state_time > v.idle_wait && q.modified_move_speed < 0.1 && q.is_on_ground && !q.is_in_water && !v.am_sleeping && !q.is_sitting && q.is_alive && !q.has_target"
            }
          ]
        },
        "pick": {
          "on_entry": [
            "v.idle_pick = math.random_integer(0, 7);"
          ],
          "transitions": [
            {
              "a0": "v.idle_pick == 0"
            },
            {
              "a1": "v.idle_pick == 1"
            },
            {
              "a2": "v.idle_pick == 2"
            },
            {
              "a3": "v.idle_pick == 3"
            },
            {
              "a4": "v.idle_pick == 4"
            },
            {
              "a5": "v.idle_pick == 5"
            },
            {
              "a6": "v.idle_pick == 6"
            },
            {
              "a7": "v.idle_pick == 7"
            }
          ]
        },
        "a0": {
          "animations": [
            "trumpet_0"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.1 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a1": {
          "animations": [
            "trumpet_1"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.1 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a2": {
          "animations": [
            "eat"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.1 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a3": {
          "animations": [
            "breakleaves"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.1 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a4": {
          "animations": [
            "idle_look"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.1 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a5": {
          "animations": [
            "idle_sniff"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.1 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a6": {
          "animations": [
            "idle_shake"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.1 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        },
        "a7": {
          "animations": [
            "idle_tail"
          ],
          "blend_transition": 0.35,
          "transitions": [
            {
              "default": "q.all_animations_finished || q.modified_move_speed >= 0.1 || v.am_sleeping || q.has_target || !q.is_alive"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.elephant.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "pick": "v.attack_time > 0 && q.is_alive"
            }
          ]
        },
        "pick": {
          "on_entry": [
            "v.atk_pick = math.random_integer(0, 1);"
          ],
          "transitions": [
            {
              "a0": "v.atk_pick == 0"
            },
            {
              "a1": "v.atk_pick == 1"
            }
          ]
        },
        "a0": {
          "animations": [
            "stomp"
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        },
        "a1": {
          "animations": [
            "fling"
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.elephant.hurt": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "hurt": "q.hurt_time > 0 && q.is_alive"
            }
          ]
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "blend_transition": 0.05,
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.elephant.death": {
      "initial_state": "default",
      "states": {
        "default": {
          "on_entry": [
            "v.death_pick = math.random_integer(0, 1);"
          ],
          "transitions": [
            {
              "dead_0": "!q.is_alive && v.death_pick == 0"
            },
            {
              "dead_1": "!q.is_alive && v.death_pick == 1"
            }
          ]
        },
        "dead_0": {
          "animations": [
            "death_0"
          ],
          "blend_transition": 0.1
        },
        "dead_1": {
          "animations": [
            "death_1"
          ],
          "blend_transition": 0.1
        }
      }
    }
  }
}
