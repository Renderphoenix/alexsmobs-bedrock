{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alexsmobs.skelewag.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle",
            "breathe"
          ],
          "blend_transition": 0.3,
          "transitions": [
            {
              "swim": "v.is_moving"
            }
          ]
        },
        "swim": {
          "animations": [
            "swim"
          ],
          "blend_transition": 0.4,
          "transitions": [
            {
              "idle": "!v.is_moving"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.skelewag.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "pick": "v.attack_time > 0 && q.is_alive"
            }
          ]
        },
        "pick": {
          "on_entry": [
            "v.atk_pick = math.random_integer(0, 1);"
          ],
          "transitions": [
            {
              "a0": "v.atk_pick == 0"
            },
            {
              "a1": "v.atk_pick == 1"
            }
          ]
        },
        "a0": {
          "animations": [
            "stab"
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        },
        "a1": {
          "animations": [
            "slash"
          ],
          "blend_transition": 0.12,
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.skelewag.hurt": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "hurt": "q.hurt_time > 0 && q.is_alive"
            }
          ]
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "blend_transition": 0.05,
          "transitions": [
            {
              "default": "q.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.skelewag.death": {
      "initial_state": "default",
      "states": {
        "default": {
          "on_entry": [
            "v.death_pick = math.random_integer(0, 1);"
          ],
          "transitions": [
            {
              "dead_0": "!q.is_alive && v.death_pick == 0"
            },
            {
              "dead_1": "!q.is_alive && v.death_pick == 1"
            }
          ]
        },
        "dead_0": {
          "animations": [
            "death_0"
          ],
          "blend_transition": 0.1
        },
        "dead_1": {
          "animations": [
            "death_1"
          ],
          "blend_transition": 0.1
        }
      }
    }
  }
}
