{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "alexsmobs:cachalot_whale",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "alexsmobs:angry": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "alexsmobs:sleeping": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "alexsmobs:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        },
        "minecraft:behavior.panic": {
          "priority": 1,
          "speed_multiplier": 1.4
        }
      },
      "alexsmobs:adult": {
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1.6,
          "track_target": true,
          "reach_multiplier": 3
        }
      },
      "alexsmobs:variant_0": {
        "minecraft:variant": {
          "value": 0
        }
      },
      "alexsmobs:variant_1": {
        "minecraft:variant": {
          "value": 1
        }
      },
      "alexsmobs:awake": {
        "minecraft:movement": {
          "value": 0.12
        },
        "minecraft:timer": {
          "looping": true,
          "randomInterval": true,
          "time": [20, 60],
          "time_down_event": {
            "event": "alexsmobs:try_sleep",
            "target": "self"
          }
        }
      },
      "alexsmobs:asleep": {
        "minecraft:movement": {
          "value": 0
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_daytime",
                    "value": true
                  },
                  {
                    "test": "in_water",
                    "value": true
                  },
                  {
                    "test": "has_target",
                    "value": true
                  }
                ]
              },
              "event": "alexsmobs:wake"
            }
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "event": "alexsmobs:wake",
                "target": "self"
              },
              "deals_damage": "yes"
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "cachalot_whale",
          "alexsmobs",
          "mob",
          "fish",
          "animal"
        ]
      },
      "minecraft:collision_box": {
        "width": 4,
        "height": 4
      },
      "minecraft:health": {
        "value": 160,
        "max": 160
      },
      "minecraft:attack": {
        "damage": 30
      },
      "minecraft:knockback_resistance": {
        "value": 1
      },
      "minecraft:follow_range": {
        "value": 32,
        "max": 64
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/alexsmobs/entities/cachalot_whale.json"
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 54,
          "max_distance": 128
        }
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "q.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:breathable": {
        "total_supply": 300,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": false,
        "generates_bubbles": false
      },
      "minecraft:navigation.generic": {
        "is_amphibious": true,
        "can_path_over_water": true,
        "can_swim": true,
        "can_walk": true,
        "can_breach": false,
        "can_jump": false
      },
      "minecraft:movement.basic": {},
      "minecraft:underwater_movement": {
        "value": 0.18
      },
      "minecraft:behavior.swim_up_for_breath": {
        "priority": 1
      },
      "minecraft:behavior.random_swim": {
        "priority": 7,
        "interval": 0,
        "xz_dist": 20,
        "y_dist": 4
      },
      "minecraft:behavior.swim_wander": {
        "priority": 8,
        "interval": 0.0166,
        "look_ahead": 5,
        "speed_multiplier": 0.014,
        "wander_time": 5
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 24,
        "must_see_forget_duration": 10,
        "attack_interval": 20,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "giant_squid"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "mimic_octopus"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "squid"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "glow_squid"
                }
              ]
            },
            "max_dist": 16
          }
        ]
      },
      "minecraft:on_target_acquired": {
        "event": "alexsmobs:angry",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "alexsmobs:calm",
        "target": "self"
      }
    },
    "events": {
      "alexsmobs:angry": {
        "set_property": {
          "alexsmobs:angry": true
        }
      },
      "alexsmobs:calm": {
        "set_property": {
          "alexsmobs:angry": false
        }
      },
      "alexsmobs:try_sleep": {
        "sequence": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_daytime",
                  "value": false
                },
                {
                  "test": "on_ground",
                  "value": true
                },
                {
                  "test": "in_water",
                  "value": false
                },
                {
                  "test": "has_target",
                  "value": false
                },
                {
                  "test": "is_sitting",
                  "value": false
                }
              ]
            },
            "sequence": [
              {
                "remove": {
                  "component_groups": [
                    "alexsmobs:awake"
                  ]
                }
              },
              {
                "add": {
                  "component_groups": [
                    "alexsmobs:asleep"
                  ]
                },
                "set_property": {
                  "alexsmobs:sleeping": true
                }
              }
            ]
          }
        ]
      },
      "alexsmobs:wake": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "alexsmobs:asleep"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "alexsmobs:awake"
              ]
            },
            "set_property": {
              "alexsmobs:sleeping": false
            }
          }
        ]
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:awake"
              ]
            }
          },
          {
            "randomize": [
              {
                "weight": 99,
                "add": {
                  "component_groups": [
                    "alexsmobs:variant_0"
                  ]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": [
                    "alexsmobs:variant_1"
                  ]
                }
              }
            ]
          },
          {
            "randomize": [
              {
                "weight": 90,
                "add": {
                  "component_groups": [
                    "alexsmobs:adult"
                  ]
                }
              },
              {
                "weight": 10,
                "add": {
                  "component_groups": [
                    "alexsmobs:baby"
                  ]
                }
              }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:awake",
                "alexsmobs:baby"
              ]
            }
          },
          {
            "randomize": [
              {
                "weight": 99,
                "add": {
                  "component_groups": [
                    "alexsmobs:variant_0"
                  ]
                }
              },
              {
                "weight": 1,
                "add": {
                  "component_groups": [
                    "alexsmobs:variant_1"
                  ]
                }
              }
            ]
          }
        ]
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "alexsmobs:awake",
            "alexsmobs:adult"
          ]
        }
      },
      "alexsmobs:become_baby": {
        "remove": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      }
    }
  }
}
