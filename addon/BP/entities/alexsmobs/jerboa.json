{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "alexsmobs:jerboa",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "alexsmobs:angry": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "alexsmobs:sleeping": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "alexsmobs:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "alexsmobs:maggot",
            "alexsmobs:mosquito_larva",
            "alexsmobs:leafcutter_ant_pupa"
          ],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        }
      },
      "alexsmobs:adult": {
        "minecraft:breedable": {
          "require_tame": false,
          "breed_items": [
            "alexsmobs:maggot",
            "alexsmobs:mosquito_larva",
            "alexsmobs:leafcutter_ant_pupa"
          ],
          "breeds_with": {
            "mate_type": "alexsmobs:jerboa",
            "baby_type": "alexsmobs:jerboa",
            "breed_event": {
              "event": "minecraft:entity_born",
              "target": "baby"
            }
          }
        },
        "minecraft:behavior.breed": {
          "priority": 3,
          "speed_multiplier": 1
        }
      },
      "alexsmobs:awake": {
        "minecraft:movement": {
          "value": 0.45
        },
        "minecraft:timer": {
          "looping": true,
          "randomInterval": true,
          "time": [20, 60],
          "time_down_event": {
            "event": "alexsmobs:try_sleep",
            "target": "self"
          }
        }
      },
      "alexsmobs:asleep": {
        "minecraft:movement": {
          "value": 0
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_daytime",
                    "value": false
                  },
                  {
                    "test": "in_water",
                    "value": true
                  },
                  {
                    "test": "has_target",
                    "value": true
                  }
                ]
              },
              "event": "alexsmobs:wake"
            }
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "event": "alexsmobs:wake",
                "target": "self"
              },
              "deals_damage": "yes"
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "jerboa",
          "alexsmobs",
          "mob",
          "animal"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 0.5
      },
      "minecraft:health": {
        "value": 4,
        "max": 4
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/alexsmobs/entities/jerboa.json"
      },
      "minecraft:leashable": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 54,
          "max_distance": 128
        }
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "q.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_open_doors": false
      },
      "minecraft:movement.basic": {},
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.8
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.5
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_sneaking",
                  "subject": "other",
                  "value": false
                },
                {
                  "test": "has_equipment",
                  "subject": "other",
                  "domain": "hand",
                  "operator": "!=",
                  "value": "alexsmobs:maggot"
                },
                {
                  "test": "has_equipment",
                  "subject": "other",
                  "domain": "hand",
                  "operator": "!=",
                  "value": "alexsmobs:mosquito_larva"
                },
                {
                  "test": "has_equipment",
                  "subject": "other",
                  "domain": "hand",
                  "operator": "!=",
                  "value": "alexsmobs:leafcutter_ant_pupa"
                }
              ]
            },
            "max_dist": 8,
            "walk_speed_multiplier": 1.3,
            "sprint_speed_multiplier": 1.6
          }
        ]
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.1,
        "within_radius": 10,
        "items": [
          "alexsmobs:maggot",
          "alexsmobs:mosquito_larva",
          "alexsmobs:leafcutter_ant_pupa"
        ],
        "can_tempt_vertically": false
      }
    },
    "events": {
      "alexsmobs:try_sleep": {
        "sequence": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_daytime",
                  "value": true
                },
                {
                  "test": "on_ground",
                  "value": true
                },
                {
                  "test": "in_water",
                  "value": false
                },
                {
                  "test": "has_target",
                  "value": false
                },
                {
                  "test": "is_sitting",
                  "value": false
                }
              ]
            },
            "sequence": [
              {
                "remove": {
                  "component_groups": [
                    "alexsmobs:awake"
                  ]
                }
              },
              {
                "add": {
                  "component_groups": [
                    "alexsmobs:asleep"
                  ]
                },
                "set_property": {
                  "alexsmobs:sleeping": true
                }
              }
            ]
          }
        ]
      },
      "alexsmobs:wake": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "alexsmobs:asleep"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "alexsmobs:awake"
              ]
            },
            "set_property": {
              "alexsmobs:sleeping": false
            }
          }
        ]
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:awake"
              ]
            }
          },
          {
            "randomize": [
              {
                "weight": 90,
                "add": {
                  "component_groups": [
                    "alexsmobs:adult"
                  ]
                }
              },
              {
                "weight": 10,
                "add": {
                  "component_groups": [
                    "alexsmobs:baby"
                  ]
                }
              }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:awake",
                "alexsmobs:baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "alexsmobs:awake",
            "alexsmobs:adult"
          ]
        }
      },
      "alexsmobs:become_baby": {
        "remove": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      }
    }
  }
}
