{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "alexsmobs:cockroach",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "alexsmobs:anim": {
          "type": "int",
          "range": [0, 1],
          "default": 0,
          "client_sync": true
        },
        "alexsmobs:angry": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "alexsmobs:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "minecraft:sugar"
          ],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        }
      },
      "alexsmobs:adult": {
        "minecraft:breedable": {
          "require_tame": false,
          "breed_items": [
            "minecraft:sugar"
          ],
          "breeds_with": {
            "mate_type": "alexsmobs:cockroach",
            "baby_type": "alexsmobs:cockroach",
            "breed_event": {
              "event": "minecraft:entity_born",
              "target": "baby"
            }
          }
        },
        "minecraft:behavior.breed": {
          "priority": 3,
          "speed_multiplier": 1
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "cockroach",
          "alexsmobs",
          "mob",
          "animal"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.7,
        "height": 0.3
      },
      "minecraft:health": {
        "value": 6,
        "max": 6
      },
      "minecraft:movement": {
        "value": 0.35
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/alexsmobs/entities/cockroach.json"
      },
      "minecraft:leashable": {
        "soft_distance": 4,
        "hard_distance": 6,
        "max_distance": 10
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 54,
          "max_distance": 128
        }
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "q.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_open_doors": false
      },
      "minecraft:movement.basic": {},
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.8
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:can_climb": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.5
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_sneaking",
                  "subject": "other",
                  "value": false
                },
                {
                  "test": "has_equipment",
                  "subject": "other",
                  "domain": "hand",
                  "operator": "!=",
                  "value": "minecraft:sugar"
                },
                {
                  "test": "has_equipment",
                  "subject": "other",
                  "domain": "hand",
                  "operator": "!=",
                  "value": "minecraft:bread"
                }
              ]
            },
            "max_dist": 8,
            "walk_speed_multiplier": 1.3,
            "sprint_speed_multiplier": 1.6
          }
        ]
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.1,
        "within_radius": 10,
        "items": [
          "minecraft:sugar",
          "minecraft:bread"
        ],
        "can_tempt_vertically": false
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 90,
                "add": {
                  "component_groups": [
                    "alexsmobs:adult"
                  ]
                }
              },
              {
                "weight": 10,
                "add": {
                  "component_groups": [
                    "alexsmobs:baby"
                  ]
                }
              }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      },
      "alexsmobs:become_baby": {
        "remove": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      }
    }
  }
}
