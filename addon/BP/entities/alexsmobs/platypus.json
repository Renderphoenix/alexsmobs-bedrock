{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "alexsmobs:platypus",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "alexsmobs:angry": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "alexsmobs:pregnant": {
        "minecraft:timer": {
          "looping": false,
          "randomInterval": true,
          "time": [30, 80],
          "time_down_event": {
            "event": "alexsmobs:go_lay_egg",
            "target": "self"
          }
        }
      },
      "alexsmobs:lay_egg": {
        "minecraft:behavior.lay_egg": {
          "priority": 2,
          "speed_multiplier": 1,
          "search_range": 16,
          "search_height": 4,
          "goal_radius": 1.5,
          "lay_seconds": 8,
          "egg_type": "alexsmobs:platypus_egg",
          "target_blocks": [
            "minecraft:mud",
            "minecraft:dirt",
            "minecraft:sand",
            "minecraft:grass_block",
            "minecraft:clay"
          ],
          "on_lay": {
            "event": "alexsmobs:laid_egg",
            "target": "self"
          }
        }
      },
      "alexsmobs:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "alexsmobs:lobster_tail"
          ],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        }
      },
      "alexsmobs:adult": {
        "minecraft:breedable": {
          "require_tame": false,
          "breed_items": [
            "alexsmobs:lobster_tail"
          ],
          "breeds_with": {
            "mate_type": "alexsmobs:platypus",
            "baby_type": "alexsmobs:platypus",
            "breed_event": {
              "event": "alexsmobs:become_pregnant",
              "target": "self"
            }
          },
          "causes_pregnancy": true
        },
        "minecraft:behavior.breed": {
          "priority": 3,
          "speed_multiplier": 1
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "platypus",
          "alexsmobs",
          "mob",
          "animal"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.8,
        "height": 0.5
      },
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
      "minecraft:movement": {
        "value": 0.2
      },
      "minecraft:follow_range": {
        "value": 16,
        "max": 64
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/alexsmobs/entities/platypus.json"
      },
      "minecraft:leashable": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 54,
          "max_distance": 128
        }
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "q.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:breathable": {
        "total_supply": 300,
        "suffocate_time": 0,
        "breathes_air": true,
        "breathes_water": true,
        "generates_bubbles": false
      },
      "minecraft:navigation.generic": {
        "is_amphibious": true,
        "can_path_over_water": false,
        "can_swim": true,
        "can_walk": true,
        "can_sink": false,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.amphibious": {
        "max_turn": 15
      },
      "minecraft:underwater_movement": {
        "value": 0.12
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.8,
        "interval": 100
      },
      "minecraft:behavior.random_swim": {
        "priority": 7,
        "speed_multiplier": 1,
        "xz_dist": 12,
        "y_dist": 3,
        "interval": 100
      },
      "minecraft:behavior.move_to_water": {
        "priority": 6,
        "search_range": 16,
        "search_height": 5,
        "search_count": 1,
        "goal_radius": 0.1
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.5
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.1,
        "within_radius": 10,
        "items": [
          "alexsmobs:lobster_tail",
          "minecraft:redstone",
          "minecraft:redstone_block",
          "alexsmobs:maggot",
          "alexsmobs:mosquito_larva",
          "alexsmobs:leafcutter_ant_pupa",
          "alexsmobs:blobfish",
          "alexsmobs:flying_fish",
          "alexsmobs:raw_catfish",
          "alexsmobs:cooked_catfish",
          "minecraft:cod",
          "minecraft:salmon",
          "minecraft:tropical_fish",
          "minecraft:pufferfish",
          "minecraft:cooked_cod",
          "minecraft:cooked_salmon"
        ],
        "can_tempt_vertically": false
      }
    },
    "events": {
      "alexsmobs:become_pregnant": {
        "add": {
          "component_groups": [
            "alexsmobs:pregnant"
          ]
        }
      },
      "alexsmobs:go_lay_egg": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "alexsmobs:pregnant"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "alexsmobs:lay_egg"
              ]
            }
          }
        ]
      },
      "alexsmobs:laid_egg": {
        "remove": {
          "component_groups": [
            "alexsmobs:lay_egg"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 90,
                "add": {
                  "component_groups": [
                    "alexsmobs:adult"
                  ]
                }
              },
              {
                "weight": 10,
                "add": {
                  "component_groups": [
                    "alexsmobs:baby"
                  ]
                }
              }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      },
      "alexsmobs:become_baby": {
        "remove": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      }
    }
  }
}
