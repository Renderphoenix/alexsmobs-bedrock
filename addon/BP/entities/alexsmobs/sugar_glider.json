{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "alexsmobs:sugar_glider",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "alexsmobs:angry": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "alexsmobs:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "minecraft:honeycomb"
          ],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        }
      },
      "alexsmobs:adult": {},
      "alexsmobs:wild": {
        "minecraft:tameable": {
          "probability": 0.33,
          "tame_items": [
            "minecraft:sweet_berries"
          ],
          "tame_event": {
            "event": "alexsmobs:on_tame",
            "target": "self"
          }
        }
      },
      "alexsmobs:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:sittable": {},
        "minecraft:behavior.stay_while_sitting": {
          "priority": 1
        },
        "minecraft:behavior.follow_owner": {
          "priority": 4,
          "speed_multiplier": 1.1,
          "start_distance": 10,
          "stop_distance": 3
        },
        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.owner_hurt_target": {
          "priority": 2
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "sugar_glider",
          "alexsmobs",
          "mob",
          "animal"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.8,
        "height": 0.45
      },
      "minecraft:health": {
        "value": 8,
        "max": 8
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:attack": {
        "damage": 2
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/alexsmobs/entities/sugar_glider.json"
      },
      "minecraft:leashable": {},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 54,
          "max_distance": 128
        }
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "q.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_open_doors": false
      },
      "minecraft:movement.basic": {},
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.8
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:can_climb": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.5
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_sneaking",
                  "subject": "other",
                  "value": false
                },
                {
                  "test": "has_equipment",
                  "subject": "other",
                  "domain": "hand",
                  "operator": "!=",
                  "value": "minecraft:honeycomb"
                },
                {
                  "test": "has_equipment",
                  "subject": "other",
                  "domain": "hand",
                  "operator": "!=",
                  "value": "minecraft:sweet_berries"
                }
              ]
            },
            "max_dist": 8,
            "walk_speed_multiplier": 1.3,
            "sprint_speed_multiplier": 1.6
          }
        ]
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.1,
        "within_radius": 10,
        "items": [
          "minecraft:honeycomb",
          "minecraft:sweet_berries"
        ],
        "can_tempt_vertically": false
      }
    },
    "events": {
      "alexsmobs:on_tame": {
        "remove": {
          "component_groups": [
            "alexsmobs:wild"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:tamed"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:wild"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "alexsmobs:adult"
              ]
            }
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:wild",
                "alexsmobs:baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "alexsmobs:wild",
            "alexsmobs:adult"
          ]
        }
      },
      "alexsmobs:become_baby": {
        "remove": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      }
    }
  }
}
