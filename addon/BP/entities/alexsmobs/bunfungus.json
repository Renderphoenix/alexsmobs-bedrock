{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "alexsmobs:bunfungus",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "alexsmobs:anim": {
          "type": "int",
          "range": [0, 1],
          "default": 0,
          "client_sync": true
        },
        "alexsmobs:angry": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "alexsmobs:sleeping": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "alexsmobs:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "minecraft:carrot",
            "minecraft:golden_carrot"
          ],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        },
        "minecraft:behavior.panic": {
          "priority": 1,
          "speed_multiplier": 1.4
        }
      },
      "alexsmobs:adult": {},
      "alexsmobs:awake": {
        "minecraft:movement": {
          "value": 0.21
        },
        "minecraft:timer": {
          "looping": true,
          "randomInterval": true,
          "time": [20, 60],
          "time_down_event": {
            "event": "alexsmobs:try_sleep",
            "target": "self"
          }
        }
      },
      "alexsmobs:asleep": {
        "minecraft:movement": {
          "value": 0
        },
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "filters": {
                "any_of": [
                  {
                    "test": "is_daytime",
                    "value": true
                  },
                  {
                    "test": "in_water",
                    "value": true
                  },
                  {
                    "test": "has_target",
                    "value": true
                  }
                ]
              },
              "event": "alexsmobs:wake"
            }
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "event": "alexsmobs:wake",
                "target": "self"
              },
              "deals_damage": "yes"
            }
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "bunfungus",
          "alexsmobs",
          "mob",
          "animal"
        ]
      },
      "minecraft:collision_box": {
        "width": 1.85,
        "height": 2.1
      },
      "minecraft:health": {
        "value": 80,
        "max": 80
      },
      "minecraft:attack": {
        "damage": 8
      },
      "minecraft:follow_range": {
        "value": 32,
        "max": 64
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:jump.static": {},
      "minecraft:loot": {
        "table": "loot_tables/alexsmobs/entities/bunfungus.json"
      },
      "minecraft:leashable": {
        "soft_distance": 4,
        "hard_distance": 6,
        "max_distance": 10
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 54,
          "max_distance": 128
        }
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "q.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_open_doors": false
      },
      "minecraft:movement.basic": {},
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.8
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.25,
        "track_target": true,
        "reach_multiplier": 2.22
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:on_target_acquired": {
        "event": "alexsmobs:angry",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "alexsmobs:calm",
        "target": "self"
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.1,
        "within_radius": 10,
        "items": [
          "minecraft:carrot",
          "minecraft:golden_carrot"
        ],
        "can_tempt_vertically": false
      }
    },
    "events": {
      "alexsmobs:angry": {
        "set_property": {
          "alexsmobs:angry": true
        }
      },
      "alexsmobs:calm": {
        "set_property": {
          "alexsmobs:angry": false
        }
      },
      "alexsmobs:try_sleep": {
        "sequence": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_daytime",
                  "value": false
                },
                {
                  "test": "on_ground",
                  "value": true
                },
                {
                  "test": "in_water",
                  "value": false
                },
                {
                  "test": "has_target",
                  "value": false
                },
                {
                  "test": "is_sitting",
                  "value": false
                }
              ]
            },
            "sequence": [
              {
                "remove": {
                  "component_groups": [
                    "alexsmobs:awake"
                  ]
                }
              },
              {
                "add": {
                  "component_groups": [
                    "alexsmobs:asleep"
                  ]
                },
                "set_property": {
                  "alexsmobs:sleeping": true
                }
              }
            ]
          }
        ]
      },
      "alexsmobs:wake": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "alexsmobs:asleep"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "alexsmobs:awake"
              ]
            },
            "set_property": {
              "alexsmobs:sleeping": false
            }
          }
        ]
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:awake"
              ]
            }
          },
          {
            "add": {
              "component_groups": [
                "alexsmobs:adult"
              ]
            }
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:awake",
                "alexsmobs:baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "alexsmobs:awake",
            "alexsmobs:adult"
          ]
        }
      },
      "alexsmobs:become_baby": {
        "remove": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      }
    }
  }
}
