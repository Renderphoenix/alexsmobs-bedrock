            "max_dist": 32
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "villager"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "wither_skeleton"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "soul_vulture"
                }
              ]
            },
            "max_dist": 16
          }
        ]
