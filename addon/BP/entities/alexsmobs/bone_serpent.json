    "events": {
      "alexsmobs:angry": {
        "set_property": {
          "alexsmobs:angry": true
        }
      },
      "alexsmobs:calm": {
        "set_property": {
          "alexsmobs:angry": false
        }
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:adult"
              ]
            }
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      },
      "alexsmobs:become_baby": {
        "remove": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      }
    }
