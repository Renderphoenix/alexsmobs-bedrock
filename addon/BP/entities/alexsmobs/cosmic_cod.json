        "alexsmobs:anim": {
          "type": "int",
          "range": [0, 1],
          "default": 0,
          "client_sync": true
        },
        "alexsmobs:angry": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "alexsmobs:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        }
      },
      "alexsmobs:adult": {}
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "cosmic_cod",
          "alexsmobs",
          "mob",
          "animal"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.85,
        "height": 0.4
      },
      "minecraft:health": {
        "value": 4,
        "max": 4
      },
      "minecraft:movement": {
        "value": 0.35
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:loot": {
        "table": "loot_tables/alexsmobs/entities/cosmic_cod.json"
      },
      "minecraft:leashable": {
        "soft_distance": 4,
        "hard_distance": 6,
        "max_distance": 10
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_distance": {
          "min_distance": 54,
          "max_distance": 128
        }
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "q.last_hit_by_player ? Math.Random(1,3) : 0"
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:navigation.hover": {
        "can_path_over_water": true,
        "can_sink": false,
        "can_pass_doors": false,
        "can_path_from_air": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "avoid_sun": false
      },
      "minecraft:movement.hover": {},
      "minecraft:can_fly": {},
      "minecraft:flying_speed": {
        "value": 0.42
      },
      "minecraft:behavior.random_hover": {
        "priority": 6,
        "xz_dist": 10,
        "y_dist": 6,
        "y_offset": -1,
        "interval": 1,
        "hover_height": [1, 5]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.5
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:adult"
              ]
            }
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      },
      "alexsmobs:become_baby": {
        "remove": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      }
    }
  }
}
