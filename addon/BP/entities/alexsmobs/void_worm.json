{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "alexsmobs:void_worm",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "alexsmobs:anim": {
          "type": "int",
          "range": [0, 1],
          "default": 0,
          "client_sync": true
        },
        "alexsmobs:angry": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "alexsmobs:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        },
        "minecraft:behavior.panic": {
          "priority": 1,
          "speed_multiplier": 1.4
        }
      },
      "alexsmobs:adult": {}
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "void_worm",
          "alexsmobs",
          "mob",
          "monster"
        ]
      },
      "minecraft:collision_box": {
        "width": 3.4,
        "height": 3
      },
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:attack": {
        "damage": 5
      },
      "minecraft:follow_range": {
        "value": 64,
        "max": 64
      },
      "minecraft:physics": {
        "has_gravity": false
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:loot": {
        "table": "loot_tables/alexsmobs/entities/void_worm.json"
      },
      "minecraft:fire_immune": true,
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "q.last_hit_by_player ? 5 : 0"
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": "no"
          },
          {
            "cause": "entity_attack",
            "deals_damage": "yes",
            "damage_multiplier": 0.84
          }
        ]
      },
      "minecraft:navigation.hover": {
        "can_path_over_water": true,
        "can_sink": false,
        "can_pass_doors": false,
        "can_path_from_air": true,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "avoid_sun": false
      },
      "minecraft:movement.hover": {},
      "minecraft:can_fly": {},
      "minecraft:flying_speed": {
        "value": 0.36
      },
      "minecraft:behavior.random_hover": {
        "priority": 6,
        "xz_dist": 10,
        "y_dist": 6,
        "y_offset": -1,
        "interval": 1,
        "hover_height": [1, 5]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:behavior.melee_attack": {
        "priority": 3,
        "speed_multiplier": 1.25,
        "track_target": true,
        "reach_multiplier": 3
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 24,
        "must_see_forget_duration": 10,
        "attack_interval": 0,
        "entity_types": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                },
                {
                  "test": "is_creative",
                  "subject": "other",
                  "operator": "!=",
                  "value": true
                }
              ]
            },
            "max_dist": 48
          },
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "ender_dragon"
                }
              ]
            },
            "max_dist": 16
          }
        ]
      },
      "minecraft:on_target_acquired": {
        "event": "alexsmobs:angry",
        "target": "self"
      },
      "minecraft:on_target_escape": {
        "event": "alexsmobs:calm",
        "target": "self"
      }
    },
    "events": {
      "alexsmobs:angry": {
        "set_property": {
          "alexsmobs:angry": true
        }
      },
      "alexsmobs:calm": {
        "set_property": {
          "alexsmobs:angry": false
        }
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:adult"
              ]
            }
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "alexsmobs:baby"
              ]
            }
          }
        ]
      },
      "minecraft:entity_transformed": {
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      },
      "alexsmobs:become_baby": {
        "remove": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        }
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "alexsmobs:baby"
          ]
        },
        "add": {
          "component_groups": [
            "alexsmobs:adult"
          ]
        }
      }
    }
  }
}
