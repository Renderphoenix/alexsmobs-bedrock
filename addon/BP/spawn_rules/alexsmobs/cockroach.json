            },
            {
              "test": "has_biome_tag",
              "operator": "!=",
              "value": "mooshroom_island"
            },
            {
              "test": "has_biome_tag",
              "operator": "!=",
              "value": "deep_dark"
            }
          ]
        }
      }
    ]
