{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.anteater_peter.move":  {
                                                                                   "initial_state":  "idle",
                                                                                   "states":  {
                                                                                                  "idle":  {
                                                                                                               "animations":  [
                                                                                                                                  "idle"
                                                                                                                              ],
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "walk":  "query.modified_move_speed > 0.05 && query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking"
                                                                                                                                   },
                                                                                                                                   {
                                                                                                                                       "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.2
                                                                                                           },
                                                                                                  "walk":  {
                                                                                                               "animations":  [
                                                                                                                                  "walk"
                                                                                                                              ],
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                   },
                                                                                                                                   {
                                                                                                                                       "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.2
                                                                                                           },
                                                                                                  "run":  {
                                                                                                              "animations":  [
                                                                                                                                 "run"
                                                                                                                             ],
                                                                                                              "transitions":  [
                                                                                                                                  {
                                                                                                                                      "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                  },
                                                                                                                                  {
                                                                                                                                      "walk":  "query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking && query.modified_move_speed > 0.05"
                                                                                                                                  }
                                                                                                                              ],
                                                                                                              "blend_transition":  0.2
                                                                                                          }
                                                                                              }
                                                                               },
                                  "controller.animation.anteater_peter.action":  {
                                                                                     "initial_state":  "default",
                                                                                     "states":  {
                                                                                                    "default":  {
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.5 && query.modified_move_speed < 0.25)"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "threat":  "query.has_target && query.target_distance >= 2.5 && query.target_distance < 6.0 && query.modified_move_speed < 0.25"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "sniff":  "query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 16.0) > 12.0"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "tongue":  "query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 16.0) > 7.0 && math.mod(query.life_time, 16.0) <= 9.5"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.15
                                                                                                                },
                                                                                                    "attack":  {
                                                                                                                   "animations":  [
                                                                                                                                      "attack"
                                                                                                                                  ],
                                                                                                                   "transitions":  [
                                                                                                                                       {
                                                                                                                                           "default":  "query.state_time >= 0.8"
                                                                                                                                       }
                                                                                                                                   ],
                                                                                                                   "blend_transition":  0.15
                                                                                                               },
                                                                                                    "threat":  {
                                                                                                                   "animations":  [
                                                                                                                                      "threat"
                                                                                                                                  ],
                                                                                                                   "transitions":  [
                                                                                                                                       {
                                                                                                                                           "default":  "!query.has_target || query.target_distance < 2.5 || query.modified_move_speed >= 0.25 || query.state_time >= 2.0"
                                                                                                                                       }
                                                                                                                                   ],
                                                                                                                   "blend_transition":  0.2
                                                                                                               },
                                                                                                    "hurt":  {
                                                                                                                 "animations":  [
                                                                                                                                    "hurt"
                                                                                                                                ],
                                                                                                                 "transitions":  [
                                                                                                                                     {
                                                                                                                                         "default":  "query.state_time >= 0.45"
                                                                                                                                     }
                                                                                                                                 ],
                                                                                                                 "blend_transition":  0.1
                                                                                                             },
                                                                                                    "sniff":  {
                                                                                                                  "animations":  [
                                                                                                                                     "idle_sniff"
                                                                                                                                 ],
                                                                                                                  "transitions":  [
                                                                                                                                      {
                                                                                                                                          "default":  "query.modified_move_speed > 0.02 || query.has_target || query.state_time >= 3.0"
                                                                                                                                      }
                                                                                                                                  ],
                                                                                                                  "blend_transition":  0.2
                                                                                                              },
                                                                                                    "tongue":  {
                                                                                                                   "animations":  [
                                                                                                                                      "idle_tongue"
                                                                                                                                  ],
                                                                                                                   "transitions":  [
                                                                                                                                       {
                                                                                                                                           "default":  "query.modified_move_speed > 0.02 || query.has_target || query.state_time >= 2.5"
                                                                                                                                       }
                                                                                                                                   ],
                                                                                                                   "blend_transition":  0.2
                                                                                                               }
                                                                                                }
                                                                                 }
                              }
}