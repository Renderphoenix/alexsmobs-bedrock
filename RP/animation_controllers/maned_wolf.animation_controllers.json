{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.maned_wolf.move":  {
                                                                               "initial_state":  "idle",
                                                                               "states":  {
                                                                                              "idle":  {
                                                                                                           "animations":  [
                                                                                                                              "idle"
                                                                                                                          ],
                                                                                                           "transitions":  [
                                                                                                                               {
                                                                                                                                   "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                               },
                                                                                                                               {
                                                                                                                                   "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                               }
                                                                                                                           ],
                                                                                                           "blend_transition":  0.2
                                                                                                       },
                                                                                              "walk":  {
                                                                                                           "animations":  [
                                                                                                                              "walk"
                                                                                                                          ],
                                                                                                           "transitions":  [
                                                                                                                               {
                                                                                                                                   "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                               },
                                                                                                                               {
                                                                                                                                   "run":  "query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0"
                                                                                                                               }
                                                                                                                           ],
                                                                                                           "blend_transition":  0.2
                                                                                                       },
                                                                                              "run":  {
                                                                                                          "animations":  [
                                                                                                                             "run"
                                                                                                                         ],
                                                                                                          "transitions":  [
                                                                                                                              {
                                                                                                                                  "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "walk":  "!query.has_target && !query.is_panicking && !query.is_sprinting && query.ground_speed <= 2.0 && math.mod(query.life_time + query.entity_id, 10.0) <= 6.0"
                                                                                                                              }
                                                                                                                          ],
                                                                                                          "blend_transition":  0.2
                                                                                                      }
                                                                                          }
                                                                           },
                                  "controller.animation.maned_wolf.action":  {
                                                                                 "initial_state":  "default",
                                                                                 "states":  {
                                                                                                "default":  {
                                                                                                                "transitions":  [
                                                                                                                                    {
                                                                                                                                        "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                    },
                                                                                                                                    {
                                                                                                                                        "pounce":  "(variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 4.0 && query.target_distance >= 2.0)) && (query.is_moving || query.ground_speed > 0.2)"
                                                                                                                                    },
                                                                                                                                    {
                                                                                                                                        "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.0)"
                                                                                                                                    },
                                                                                                                                    {
                                                                                                                                        "howl":  "!query.is_moving && query.ground_speed <= 0.05 && math.mod(query.life_time * 0.1 + query.entity_id, 30.0) > 25.0"
                                                                                                                                    },
                                                                                                                                    {
                                                                                                                                        "sniff":  "!query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time * 0.2 + query.entity_id, 14.0) > 10.0"
                                                                                                                                    }
                                                                                                                                ],
                                                                                                                "blend_transition":  0.15
                                                                                                            },
                                                                                                "hurt":  {
                                                                                                             "animations":  [
                                                                                                                                "hurt"
                                                                                                                            ],
                                                                                                             "transitions":  [
                                                                                                                                 {
                                                                                                                                     "default":  "query.state_time >= 0.4"
                                                                                                                                 }
                                                                                                                             ],
                                                                                                             "blend_transition":  0.1
                                                                                                         },
                                                                                                "attack":  {
                                                                                                               "animations":  [
                                                                                                                                  "attack"
                                                                                                                              ],
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "default":  "query.state_time >= 0.5"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.15
                                                                                                           },
                                                                                                "pounce":  {
                                                                                                               "animations":  [
                                                                                                                                  "pounce"
                                                                                                                              ],
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "default":  "query.state_time >= 0.8"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.15
                                                                                                           },
                                                                                                "howl":  {
                                                                                                             "animations":  [
                                                                                                                                "idle_howl"
                                                                                                                            ],
                                                                                                             "transitions":  [
                                                                                                                                 {
                                                                                                                                     "default":  "query.state_time >= 3.0 || query.is_moving || query.is_hurt"
                                                                                                                                 }
                                                                                                                             ],
                                                                                                             "blend_transition":  0.2
                                                                                                         },
                                                                                                "sniff":  {
                                                                                                              "animations":  [
                                                                                                                                 "idle_sniff"
                                                                                                                             ],
                                                                                                              "transitions":  [
                                                                                                                                  {
                                                                                                                                      "default":  "query.state_time >= 2.0 || query.is_moving || query.has_target || query.is_hurt"
                                                                                                                                  }
                                                                                                                              ],
                                                                                                              "blend_transition":  0.2
                                                                                                          }
                                                                                            }
                                                                             }
                              }
}