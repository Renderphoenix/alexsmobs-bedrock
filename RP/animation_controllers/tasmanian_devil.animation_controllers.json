{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.tasmanian_devil.move":  {
                                                                                    "initial_state":  "idle",
                                                                                    "states":  {
                                                                                                   "idle":  {
                                                                                                                "animations":  [
                                                                                                                                   "idle"
                                                                                                                               ],
                                                                                                                "transitions":  [
                                                                                                                                    {
                                                                                                                                        "walk":  "query.modified_move_speed > 0.05 && query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking"
                                                                                                                                    },
                                                                                                                                    {
                                                                                                                                        "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                    }
                                                                                                                                ],
                                                                                                                "blend_transition":  0.2
                                                                                                            },
                                                                                                   "walk":  {
                                                                                                                "animations":  [
                                                                                                                                   "walk"
                                                                                                                               ],
                                                                                                                "transitions":  [
                                                                                                                                    {
                                                                                                                                        "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                    },
                                                                                                                                    {
                                                                                                                                        "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                    }
                                                                                                                                ],
                                                                                                                "blend_transition":  0.2
                                                                                                            },
                                                                                                   "run":  {
                                                                                                               "animations":  [
                                                                                                                                  "run"
                                                                                                                              ],
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                   },
                                                                                                                                   {
                                                                                                                                       "walk":  "query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking && query.modified_move_speed > 0.05"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.2
                                                                                                           }
                                                                                               }
                                                                                },
                                  "controller.animation.tasmanian_devil.action":  {
                                                                                      "initial_state":  "default",
                                                                                      "states":  {
                                                                                                     "default":  {
                                                                                                                     "transitions":  [
                                                                                                                                         {
                                                                                                                                             "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                         },
                                                                                                                                         {
                                                                                                                                             "spin":  "(query.has_target || query.is_panicking) && (query.modified_move_speed > 0.3 || variable.spin == 1)"
                                                                                                                                         },
                                                                                                                                         {
                                                                                                                                             "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.0)"
                                                                                                                                         },
                                                                                                                                         {
                                                                                                                                             "yawn":  "query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 20.0) > 16.0"
                                                                                                                                         },
                                                                                                                                         {
                                                                                                                                             "sniff":  "query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 20.0) > 8.0 && math.mod(query.life_time, 20.0) <= 12.0"
                                                                                                                                         }
                                                                                                                                     ],
                                                                                                                     "blend_transition":  0.15
                                                                                                                 },
                                                                                                     "attack":  {
                                                                                                                    "animations":  [
                                                                                                                                       "attack"
                                                                                                                                   ],
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "default":  "query.state_time >= 0.55"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.15
                                                                                                                },
                                                                                                     "spin":  {
                                                                                                                  "animations":  [
                                                                                                                                     "spin"
                                                                                                                                 ],
                                                                                                                  "transitions":  [
                                                                                                                                      {
                                                                                                                                          "default":  "query.state_time >= 1.2 || (!query.has_target && !query.is_panicking)"
                                                                                                                                      }
                                                                                                                                  ],
                                                                                                                  "blend_transition":  0.15
                                                                                                              },
                                                                                                     "hurt":  {
                                                                                                                  "animations":  [
                                                                                                                                     "hurt"
                                                                                                                                 ],
                                                                                                                  "transitions":  [
                                                                                                                                      {
                                                                                                                                          "default":  "query.state_time >= 0.4"
                                                                                                                                      }
                                                                                                                                  ],
                                                                                                                  "blend_transition":  0.1
                                                                                                              },
                                                                                                     "sniff":  {
                                                                                                                   "animations":  [
                                                                                                                                      "idle_sniff"
                                                                                                                                  ],
                                                                                                                   "transitions":  [
                                                                                                                                       {
                                                                                                                                           "default":  "query.modified_move_speed > 0.02 || query.has_target || query.state_time >= 2.0"
                                                                                                                                       }
                                                                                                                                   ],
                                                                                                                   "blend_transition":  0.2
                                                                                                               },
                                                                                                     "yawn":  {
                                                                                                                  "animations":  [
                                                                                                                                     "idle_yawn"
                                                                                                                                 ],
                                                                                                                  "transitions":  [
                                                                                                                                      {
                                                                                                                                          "default":  "query.state_time >= 2.0"
                                                                                                                                      }
                                                                                                                                  ],
                                                                                                                  "blend_transition":  0.2
                                                                                                              }
                                                                                                 }
                                                                                  }
                              }
}