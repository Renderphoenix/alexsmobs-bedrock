{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.tiger_white_sleeping.move":  {
                                                                                         "initial_state":  "idle",
                                                                                         "states":  {
                                                                                                        "idle":  {
                                                                                                                     "animations":  [
                                                                                                                                        "idle"
                                                                                                                                    ],
                                                                                                                     "transitions":  [
                                                                                                                                         {
                                                                                                                                             "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                                         },
                                                                                                                                         {
                                                                                                                                             "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                                         },
                                                                                                                                         {
                                                                                                                                             "sit":  "query.is_sitting || (!query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time * 0.12 + query.entity_id, 20.0) > 13.0)"
                                                                                                                                         }
                                                                                                                                     ],
                                                                                                                     "blend_transition":  0.2
                                                                                                                 },
                                                                                                        "walk":  {
                                                                                                                     "animations":  [
                                                                                                                                        "walk"
                                                                                                                                    ],
                                                                                                                     "transitions":  [
                                                                                                                                         {
                                                                                                                                             "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                         },
                                                                                                                                         {
                                                                                                                                             "run":  "query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0"
                                                                                                                                         }
                                                                                                                                     ],
                                                                                                                     "blend_transition":  0.2
                                                                                                                 },
                                                                                                        "run":  {
                                                                                                                    "animations":  [
                                                                                                                                       "run"
                                                                                                                                   ],
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "walk":  "!query.has_target && !query.is_panicking && !query.is_sprinting && query.ground_speed <= 2.0 && math.mod(query.life_time + query.entity_id, 10.0) <= 6.0"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.2
                                                                                                                },
                                                                                                        "sit":  {
                                                                                                                    "animations":  [
                                                                                                                                       "idle_sit"
                                                                                                                                   ],
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "idle":  "!query.is_sitting && (query.state_time >= 7.0 || query.has_target || query.is_hurt)"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.3
                                                                                                                }
                                                                                                    }
                                                                                     },
                                  "controller.animation.tiger_white_sleeping.action":  {
                                                                                           "initial_state":  "default",
                                                                                           "states":  {
                                                                                                          "default":  {
                                                                                                                          "transitions":  [
                                                                                                                                              {
                                                                                                                                                  "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                              },
                                                                                                                                              {
                                                                                                                                                  "pounce":  "(variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 4.5 && query.target_distance >= 2.0)) && (query.is_moving || query.ground_speed > 0.2)"
                                                                                                                                              },
                                                                                                                                              {
                                                                                                                                                  "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.0)"
                                                                                                                                              },
                                                                                                                                              {
                                                                                                                                                  "roar":  "query.has_target && query.target_distance >= 3.0 && (!query.is_moving || query.ground_speed < 0.1) && math.mod(query.life_time, 12.0) > 9.0"
                                                                                                                                              },
                                                                                                                                              {
                                                                                                                                                  "stalk":  "query.has_target && query.target_distance >= 2.5 && (query.is_moving || query.ground_speed > 0.1)"
                                                                                                                                              }
                                                                                                                                          ],
                                                                                                                          "blend_transition":  0.15
                                                                                                                      },
                                                                                                          "hurt":  {
                                                                                                                       "animations":  [
                                                                                                                                          "hurt"
                                                                                                                                      ],
                                                                                                                       "transitions":  [
                                                                                                                                           {
                                                                                                                                               "default":  "query.state_time >= 0.45"
                                                                                                                                           }
                                                                                                                                       ],
                                                                                                                       "blend_transition":  0.1
                                                                                                                   },
                                                                                                          "attack":  {
                                                                                                                         "animations":  [
                                                                                                                                            "attack"
                                                                                                                                        ],
                                                                                                                         "transitions":  [
                                                                                                                                             {
                                                                                                                                                 "default":  "query.state_time >= 0.7"
                                                                                                                                             }
                                                                                                                                         ],
                                                                                                                         "blend_transition":  0.15
                                                                                                                     },
                                                                                                          "pounce":  {
                                                                                                                         "animations":  [
                                                                                                                                            "pounce"
                                                                                                                                        ],
                                                                                                                         "transitions":  [
                                                                                                                                             {
                                                                                                                                                 "default":  "query.state_time >= 1.0"
                                                                                                                                             }
                                                                                                                                         ],
                                                                                                                         "blend_transition":  0.15
                                                                                                                     },
                                                                                                          "roar":  {
                                                                                                                       "animations":  [
                                                                                                                                          "idle_roar"
                                                                                                                                      ],
                                                                                                                       "transitions":  [
                                                                                                                                           {
                                                                                                                                               "default":  "query.state_time >= 2.2 || query.is_hurt"
                                                                                                                                           }
                                                                                                                                       ],
                                                                                                                       "blend_transition":  0.2
                                                                                                                   },
                                                                                                          "stalk":  {
                                                                                                                        "animations":  [
                                                                                                                                           "idle_stalk"
                                                                                                                                       ],
                                                                                                                        "transitions":  [
                                                                                                                                            {
                                                                                                                                                "default":  "!query.has_target || query.target_distance < 2.5 || query.ground_speed > 2.0 || (!query.is_moving && query.ground_speed <= 0.05)"
                                                                                                                                            }
                                                                                                                                        ],
                                                                                                                        "blend_transition":  0.2
                                                                                                                    }
                                                                                                      }
                                                                                       }
                              }
}