{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.crocodile.move":  {
                                                                              "initial_state":  "idle",
                                                                              "states":  {
                                                                                             "idle":  {
                                                                                                          "animations":  [
                                                                                                                             "idle"
                                                                                                                         ],
                                                                                                          "transitions":  [
                                                                                                                              {
                                                                                                                                  "swim":  "query.is_in_water && (query.is_moving || query.ground_speed > 0.05)"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "bask":  "!query.is_in_water && !query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time * 0.1 + query.entity_id, 24.0) > 15.0"
                                                                                                                              }
                                                                                                                          ],
                                                                                                          "blend_transition":  0.2
                                                                                                      },
                                                                                             "walk":  {
                                                                                                          "animations":  [
                                                                                                                             "walk"
                                                                                                                         ],
                                                                                                          "transitions":  [
                                                                                                                              {
                                                                                                                                  "swim":  "query.is_in_water"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "run":  "query.has_target || query.is_panicking || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0"
                                                                                                                              }
                                                                                                                          ],
                                                                                                          "blend_transition":  0.2
                                                                                                      },
                                                                                             "run":  {
                                                                                                         "animations":  [
                                                                                                                            "run"
                                                                                                                        ],
                                                                                                         "transitions":  [
                                                                                                                             {
                                                                                                                                 "swim":  "query.is_in_water"
                                                                                                                             },
                                                                                                                             {
                                                                                                                                 "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                             },
                                                                                                                             {
                                                                                                                                 "walk":  "!query.has_target && !query.is_panicking && query.ground_speed <= 2.0 && math.mod(query.life_time + query.entity_id, 10.0) <= 6.0"
                                                                                                                             }
                                                                                                                         ],
                                                                                                         "blend_transition":  0.2
                                                                                                     },
                                                                                             "swim":  {
                                                                                                          "animations":  [
                                                                                                                             "swim"
                                                                                                                         ],
                                                                                                          "transitions":  [
                                                                                                                              {
                                                                                                                                  "idle":  "!query.is_in_water && !query.is_moving && query.ground_speed <= 0.05"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "walk":  "!query.is_in_water && query.is_moving"
                                                                                                                              }
                                                                                                                          ],
                                                                                                          "blend_transition":  0.2
                                                                                                      },
                                                                                             "bask":  {
                                                                                                          "animations":  [
                                                                                                                             "idle_bask"
                                                                                                                         ],
                                                                                                          "transitions":  [
                                                                                                                              {
                                                                                                                                  "swim":  "query.is_in_water"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.ground_speed > 2.0)"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                              },
                                                                                                                              {
                                                                                                                                  "idle":  "query.state_time >= 8.0 || query.has_target || query.is_hurt"
                                                                                                                              }
                                                                                                                          ],
                                                                                                          "blend_transition":  0.3
                                                                                                      }
                                                                                         }
                                                                          },
                                  "controller.animation.crocodile.action":  {
                                                                                "initial_state":  "default",
                                                                                "states":  {
                                                                                               "default":  {
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                   },
                                                                                                                                   {
                                                                                                                                       "death_roll":  "(query.has_target && query.target_distance < 3.0) && query.is_in_water"
                                                                                                                                   },
                                                                                                                                   {
                                                                                                                                       "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.5)"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.15
                                                                                                           },
                                                                                               "hurt":  {
                                                                                                            "animations":  [
                                                                                                                               "hurt"
                                                                                                                           ],
                                                                                                            "transitions":  [
                                                                                                                                {
                                                                                                                                    "default":  "query.state_time >= 0.4"
                                                                                                                                }
                                                                                                                            ],
                                                                                                            "blend_transition":  0.1
                                                                                                        },
                                                                                               "attack":  {
                                                                                                              "animations":  [
                                                                                                                                 "attack"
                                                                                                                             ],
                                                                                                              "transitions":  [
                                                                                                                                  {
                                                                                                                                      "default":  "query.state_time >= 0.6"
                                                                                                                                  }
                                                                                                                              ],
                                                                                                              "blend_transition":  0.15
                                                                                                          },
                                                                                               "death_roll":  {
                                                                                                                  "animations":  [
                                                                                                                                     "death_roll"
                                                                                                                                 ],
                                                                                                                  "transitions":  [
                                                                                                                                      {
                                                                                                                                          "default":  "query.state_time >= 1.5 || !query.is_in_water"
                                                                                                                                      }
                                                                                                                                  ],
                                                                                                                  "blend_transition":  0.2
                                                                                                              }
                                                                                           }
                                                                            }
                              }
}