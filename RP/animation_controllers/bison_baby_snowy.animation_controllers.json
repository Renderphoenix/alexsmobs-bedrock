{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.bison_baby_snowy.move":  {
                                                                                     "initial_state":  "idle",
                                                                                     "states":  {
                                                                                                    "idle":  {
                                                                                                                 "animations":  [
                                                                                                                                    "idle"
                                                                                                                                ],
                                                                                                                 "transitions":  [
                                                                                                                                     {
                                                                                                                                         "walk":  "query.modified_move_speed > 0.05 && query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking"
                                                                                                                                     },
                                                                                                                                     {
                                                                                                                                         "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                     }
                                                                                                                                 ],
                                                                                                                 "blend_transition":  0.2
                                                                                                             },
                                                                                                    "walk":  {
                                                                                                                 "animations":  [
                                                                                                                                    "walk"
                                                                                                                                ],
                                                                                                                 "transitions":  [
                                                                                                                                     {
                                                                                                                                         "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                     },
                                                                                                                                     {
                                                                                                                                         "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                     }
                                                                                                                                 ],
                                                                                                                 "blend_transition":  0.2
                                                                                                             },
                                                                                                    "run":  {
                                                                                                                "animations":  [
                                                                                                                                   "run"
                                                                                                                               ],
                                                                                                                "transitions":  [
                                                                                                                                    {
                                                                                                                                        "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                    },
                                                                                                                                    {
                                                                                                                                        "walk":  "query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking && query.modified_move_speed > 0.05"
                                                                                                                                    }
                                                                                                                                ],
                                                                                                                "blend_transition":  0.2
                                                                                                            }
                                                                                                }
                                                                                 },
                                  "controller.animation.bison_baby_snowy.action":  {
                                                                                       "initial_state":  "default",
                                                                                       "states":  {
                                                                                                      "default":  {
                                                                                                                      "transitions":  [
                                                                                                                                          {
                                                                                                                                              "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 3.0 && query.modified_move_speed < 0.3)"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "shake":  "query.is_shaking || (query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 24.0) > 22.0)"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "graze":  "query.is_grazing || (query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 20.0) > 14.0)"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "look":  "query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 20.0) > 6.0 && math.mod(query.life_time, 20.0) <= 9.0"
                                                                                                                                          }
                                                                                                                                      ],
                                                                                                                      "blend_transition":  0.15
                                                                                                                  },
                                                                                                      "attack":  {
                                                                                                                     "animations":  [
                                                                                                                                        "attack"
                                                                                                                                    ],
                                                                                                                     "transitions":  [
                                                                                                                                         {
                                                                                                                                             "default":  "query.state_time >= 1.1"
                                                                                                                                         }
                                                                                                                                     ],
                                                                                                                     "blend_transition":  0.15
                                                                                                                 },
                                                                                                      "shake":  {
                                                                                                                    "animations":  [
                                                                                                                                       "shake"
                                                                                                                                   ],
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "default":  "query.state_time >= 1.4"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.15
                                                                                                                },
                                                                                                      "hurt":  {
                                                                                                                   "animations":  [
                                                                                                                                      "hurt"
                                                                                                                                  ],
                                                                                                                   "transitions":  [
                                                                                                                                       {
                                                                                                                                           "default":  "query.state_time >= 0.4"
                                                                                                                                       }
                                                                                                                                   ],
                                                                                                                   "blend_transition":  0.1
                                                                                                               },
                                                                                                      "look":  {
                                                                                                                   "animations":  [
                                                                                                                                      "idle_look"
                                                                                                                                  ],
                                                                                                                   "transitions":  [
                                                                                                                                       {
                                                                                                                                           "default":  "query.modified_move_speed > 0.02 || query.has_target || query.state_time >= 3.0"
                                                                                                                                       }
                                                                                                                                   ],
                                                                                                                   "blend_transition":  0.2
                                                                                                               },
                                                                                                      "graze":  {
                                                                                                                    "animations":  [
                                                                                                                                       "idle_graze"
                                                                                                                                   ],
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "default":  "query.modified_move_speed > 0.02 || query.has_target || query.state_time >= 4.0"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.2
                                                                                                                }
                                                                                                  }
                                                                                   }
                              }
}