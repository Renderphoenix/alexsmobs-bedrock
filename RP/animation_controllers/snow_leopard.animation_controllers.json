{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.snow_leopard.move":  {
                                                                                 "initial_state":  "idle",
                                                                                 "states":  {
                                                                                                "idle":  {
                                                                                                             "animations":  [
                                                                                                                                "idle"
                                                                                                                            ],
                                                                                                             "transitions":  [
                                                                                                                                 {
                                                                                                                                     "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                                 },
                                                                                                                                 {
                                                                                                                                     "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                                 },
                                                                                                                                 {
                                                                                                                                     "sleep":  "query.is_sitting || (!query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time * 0.12 + query.entity_id, 20.0) > 13.0)"
                                                                                                                                 }
                                                                                                                             ],
                                                                                                             "blend_transition":  0.2
                                                                                                         },
                                                                                                "walk":  {
                                                                                                             "animations":  [
                                                                                                                                "walk"
                                                                                                                            ],
                                                                                                             "transitions":  [
                                                                                                                                 {
                                                                                                                                     "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                 },
                                                                                                                                 {
                                                                                                                                     "run":  "query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0"
                                                                                                                                 }
                                                                                                                             ],
                                                                                                             "blend_transition":  0.2
                                                                                                         },
                                                                                                "run":  {
                                                                                                            "animations":  [
                                                                                                                               "run"
                                                                                                                           ],
                                                                                                            "transitions":  [
                                                                                                                                {
                                                                                                                                    "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "walk":  "!query.has_target && !query.is_panicking && !query.is_sprinting && query.ground_speed <= 2.0 && math.mod(query.life_time + query.entity_id, 10.0) <= 6.0"
                                                                                                                                }
                                                                                                                            ],
                                                                                                            "blend_transition":  0.2
                                                                                                        },
                                                                                                "sleep":  {
                                                                                                              "animations":  [
                                                                                                                                 "idle_sleep"
                                                                                                                             ],
                                                                                                              "transitions":  [
                                                                                                                                  {
                                                                                                                                      "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                                  },
                                                                                                                                  {
                                                                                                                                      "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                                  },
                                                                                                                                  {
                                                                                                                                      "idle":  "query.state_time >= 8.0 || query.has_target || query.is_hurt"
                                                                                                                                  }
                                                                                                                              ],
                                                                                                              "blend_transition":  0.3
                                                                                                          }
                                                                                            }
                                                                             },
                                  "controller.animation.snow_leopard.action":  {
                                                                                   "initial_state":  "default",
                                                                                   "states":  {
                                                                                                  "default":  {
                                                                                                                  "transitions":  [
                                                                                                                                      {
                                                                                                                                          "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                      },
                                                                                                                                      {
                                                                                                                                          "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.5)"
                                                                                                                                      },
                                                                                                                                      {
                                                                                                                                          "crouch":  "query.has_target && query.target_distance >= 2.5 && query.target_distance < 7.0 && (!query.is_moving || query.ground_speed < 0.1)"
                                                                                                                                      },
                                                                                                                                      {
                                                                                                                                          "tail_hold":  "!query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time * 0.15 + query.entity_id, 20.0) > 15.0"
                                                                                                                                      }
                                                                                                                                  ],
                                                                                                                  "blend_transition":  0.15
                                                                                                              },
                                                                                                  "hurt":  {
                                                                                                               "animations":  [
                                                                                                                                  "hurt"
                                                                                                                              ],
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "default":  "query.state_time >= 0.4"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.1
                                                                                                           },
                                                                                                  "attack":  {
                                                                                                                 "animations":  [
                                                                                                                                    "attack"
                                                                                                                                ],
                                                                                                                 "transitions":  [
                                                                                                                                     {
                                                                                                                                         "default":  "query.state_time >= 0.6"
                                                                                                                                     }
                                                                                                                                 ],
                                                                                                                 "blend_transition":  0.15
                                                                                                             },
                                                                                                  "crouch":  {
                                                                                                                 "animations":  [
                                                                                                                                    "idle_crouch"
                                                                                                                                ],
                                                                                                                 "transitions":  [
                                                                                                                                     {
                                                                                                                                         "default":  "!query.has_target || query.target_distance < 2.5 || query.ground_speed > 0.2"
                                                                                                                                     }
                                                                                                                                 ],
                                                                                                                 "blend_transition":  0.2
                                                                                                             },
                                                                                                  "tail_hold":  {
                                                                                                                    "animations":  [
                                                                                                                                       "idle_tail_hold"
                                                                                                                                   ],
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "default":  "query.state_time >= 3.0 || query.is_moving || query.has_target || query.is_hurt"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.2
                                                                                                                }
                                                                                              }
                                                                               }
                              }
}