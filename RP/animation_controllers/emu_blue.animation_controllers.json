{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.emu_blue.move":  {
                                                                             "initial_state":  "idle",
                                                                             "states":  {
                                                                                            "idle":  {
                                                                                                         "animations":  [
                                                                                                                            "idle"
                                                                                                                        ],
                                                                                                         "transitions":  [
                                                                                                                             {
                                                                                                                                 "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 1.2 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                             },
                                                                                                                             {
                                                                                                                                 "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                             }
                                                                                                                         ],
                                                                                                         "blend_transition":  0.2
                                                                                                     },
                                                                                            "walk":  {
                                                                                                         "animations":  [
                                                                                                                            "walk"
                                                                                                                        ],
                                                                                                         "transitions":  [
                                                                                                                             {
                                                                                                                                 "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                             },
                                                                                                                             {
                                                                                                                                 "run":  "query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 1.2 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0"
                                                                                                                             }
                                                                                                                         ],
                                                                                                         "blend_transition":  0.2
                                                                                                     },
                                                                                            "run":  {
                                                                                                        "animations":  [
                                                                                                                           "run"
                                                                                                                       ],
                                                                                                        "transitions":  [
                                                                                                                            {
                                                                                                                                "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                            },
                                                                                                                            {
                                                                                                                                "walk":  "!query.has_target && !query.is_panicking && !query.is_sprinting && query.ground_speed <= 1.2 && math.mod(query.life_time + query.entity_id, 10.0) <= 6.0"
                                                                                                                            }
                                                                                                                        ],
                                                                                                        "blend_transition":  0.2
                                                                                                    }
                                                                                        }
                                                                         },
                                  "controller.animation.emu_blue.action":  {
                                                                               "initial_state":  "default",
                                                                               "states":  {
                                                                                              "default":  {
                                                                                                              "transitions":  [
                                                                                                                                  {
                                                                                                                                      "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                  },
                                                                                                                                  {
                                                                                                                                      "kick":  "query.is_delayed_attacking && (query.is_moving || query.ground_speed > 0.1 || math.mod(query.life_time, 2.0) > 1.0)"
                                                                                                                                  },
                                                                                                                                  {
                                                                                                                                      "peck":  "query.is_delayed_attacking"
                                                                                                                                  },
                                                                                                                                  {
                                                                                                                                      "peck_idle":  "!query.is_delayed_attacking && !query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time, 15.0) > 11.5"
                                                                                                                                  }
                                                                                                                              ],
                                                                                                              "blend_transition":  0.15
                                                                                                          },
                                                                                              "hurt":  {
                                                                                                           "animations":  [
                                                                                                                              "hurt"
                                                                                                                          ],
                                                                                                           "transitions":  [
                                                                                                                               {
                                                                                                                                   "default":  "query.state_time >= 0.4"
                                                                                                                               }
                                                                                                                           ],
                                                                                                           "blend_transition":  0.1
                                                                                                       },
                                                                                              "peck":  {
                                                                                                           "animations":  [
                                                                                                                              "peck"
                                                                                                                          ],
                                                                                                           "transitions":  [
                                                                                                                               {
                                                                                                                                   "default":  "query.state_time >= 0.45 || !query.is_delayed_attacking"
                                                                                                                               }
                                                                                                                           ],
                                                                                                           "blend_transition":  0.15
                                                                                                       },
                                                                                              "kick":  {
                                                                                                           "animations":  [
                                                                                                                              "kick"
                                                                                                                          ],
                                                                                                           "transitions":  [
                                                                                                                               {
                                                                                                                                   "default":  "query.state_time >= 0.6 || !query.is_delayed_attacking"
                                                                                                                               }
                                                                                                                           ],
                                                                                                           "blend_transition":  0.15
                                                                                                       },
                                                                                              "peck_idle":  {
                                                                                                                "animations":  [
                                                                                                                                   "idle_peck"
                                                                                                                               ],
                                                                                                                "transitions":  [
                                                                                                                                    {
                                                                                                                                        "default":  "(query.state_time >= 2.5 || query.is_moving || query.ground_speed > 0.05 || query.has_target || query.is_hurt) || query.is_moving || query.is_delayed_attacking || query.is_hurt"
                                                                                                                                    }
                                                                                                                                ],
                                                                                                                "blend_transition":  0.2
                                                                                                            }
                                                                                          }
                                                                           }
                              }
}