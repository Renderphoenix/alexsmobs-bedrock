{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.gorilla.move":  {
                                                                            "initial_state":  "idle",
                                                                            "states":  {
                                                                                           "idle":  {
                                                                                                        "animations":  [
                                                                                                                           "idle"
                                                                                                                       ],
                                                                                                        "transitions":  [
                                                                                                                            {
                                                                                                                                "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 1.2 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                            },
                                                                                                                            {
                                                                                                                                "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                            },
                                                                                                                            {
                                                                                                                                "sit":  "query.is_sitting || (!query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time * 0.12 + query.entity_id, 20.0) > 13.0)"
                                                                                                                            }
                                                                                                                        ],
                                                                                                        "blend_transition":  0.2
                                                                                                    },
                                                                                           "walk":  {
                                                                                                        "animations":  [
                                                                                                                           "walk"
                                                                                                                       ],
                                                                                                        "transitions":  [
                                                                                                                            {
                                                                                                                                "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                            },
                                                                                                                            {
                                                                                                                                "run":  "query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 1.2 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0"
                                                                                                                            }
                                                                                                                        ],
                                                                                                        "blend_transition":  0.2
                                                                                                    },
                                                                                           "run":  {
                                                                                                       "animations":  [
                                                                                                                          "run"
                                                                                                                      ],
                                                                                                       "transitions":  [
                                                                                                                           {
                                                                                                                               "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "walk":  "!query.has_target && !query.is_panicking && !query.is_sprinting && query.ground_speed <= 1.2 && math.mod(query.life_time + query.entity_id, 10.0) <= 6.0"
                                                                                                                           }
                                                                                                                       ],
                                                                                                       "blend_transition":  0.2
                                                                                                   },
                                                                                           "sit":  {
                                                                                                       "animations":  [
                                                                                                                          "idle_sit"
                                                                                                                      ],
                                                                                                       "transitions":  [
                                                                                                                           {
                                                                                                                               "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "idle":  "!query.is_sitting && (query.state_time >= 7.0 || query.has_target || query.is_hurt)"
                                                                                                                           }
                                                                                                                       ],
                                                                                                       "blend_transition":  0.3
                                                                                                   }
                                                                                       }
                                                                        },
                                  "controller.animation.gorilla.action":  {
                                                                              "initial_state":  "default",
                                                                              "states":  {
                                                                                             "default":  {
                                                                                                             "transitions":  [
                                                                                                                                 {
                                                                                                                                     "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                 },
                                                                                                                                 {
                                                                                                                                     "attack":  "query.is_delayed_attacking"
                                                                                                                                 },
                                                                                                                                 {
                                                                                                                                     "chest_beat":  "!query.is_delayed_attacking && !query.is_moving && query.ground_speed <= 0.05 && math.mod(query.life_time, 30.0) > 26.0"
                                                                                                                                 }
                                                                                                                             ],
                                                                                                             "blend_transition":  0.15
                                                                                                         },
                                                                                             "hurt":  {
                                                                                                          "animations":  [
                                                                                                                             "hurt"
                                                                                                                         ],
                                                                                                          "transitions":  [
                                                                                                                              {
                                                                                                                                  "default":  "query.state_time >= 0.4"
                                                                                                                              }
                                                                                                                          ],
                                                                                                          "blend_transition":  0.1
                                                                                                      },
                                                                                             "attack":  {
                                                                                                            "animations":  [
                                                                                                                               "attack"
                                                                                                                           ],
                                                                                                            "transitions":  [
                                                                                                                                {
                                                                                                                                    "default":  "query.state_time >= 1 || !query.is_delayed_attacking"
                                                                                                                                }
                                                                                                                            ],
                                                                                                            "blend_transition":  0.15
                                                                                                        },
                                                                                             "chest_beat":  {
                                                                                                                "animations":  [
                                                                                                                                   "chest_beat"
                                                                                                                               ],
                                                                                                                "transitions":  [
                                                                                                                                    {
                                                                                                                                        "default":  "(query.state_time >= 2.0 || query.is_hurt) || query.is_moving || query.is_delayed_attacking || query.is_hurt"
                                                                                                                                    }
                                                                                                                                ],
                                                                                                                "blend_transition":  0.2
                                                                                                            }
                                                                                         }
                                                                          }
                              }
}