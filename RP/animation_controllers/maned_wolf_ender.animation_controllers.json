{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.maned_wolf_ender.move":  {
                                                                                     "initial_state":  "idle",
                                                                                     "states":  {
                                                                                                    "idle":  {
                                                                                                                 "animations":  [
                                                                                                                                    "idle"
                                                                                                                                ],
                                                                                                                 "transitions":  [
                                                                                                                                     {
                                                                                                                                         "walk":  "query.modified_move_speed > 0.05 && query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking"
                                                                                                                                     },
                                                                                                                                     {
                                                                                                                                         "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                     }
                                                                                                                                 ],
                                                                                                                 "blend_transition":  0.2
                                                                                                             },
                                                                                                    "walk":  {
                                                                                                                 "animations":  [
                                                                                                                                    "walk"
                                                                                                                                ],
                                                                                                                 "transitions":  [
                                                                                                                                     {
                                                                                                                                         "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                     },
                                                                                                                                     {
                                                                                                                                         "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                     }
                                                                                                                                 ],
                                                                                                                 "blend_transition":  0.2
                                                                                                             },
                                                                                                    "run":  {
                                                                                                                "animations":  [
                                                                                                                                   "run"
                                                                                                                               ],
                                                                                                                "transitions":  [
                                                                                                                                    {
                                                                                                                                        "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                    },
                                                                                                                                    {
                                                                                                                                        "walk":  "query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking && query.modified_move_speed > 0.05"
                                                                                                                                    }
                                                                                                                                ],
                                                                                                                "blend_transition":  0.2
                                                                                                            }
                                                                                                }
                                                                                 },
                                  "controller.animation.maned_wolf_ender.action":  {
                                                                                       "initial_state":  "default",
                                                                                       "states":  {
                                                                                                      "default":  {
                                                                                                                      "transitions":  [
                                                                                                                                          {
                                                                                                                                              "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "pounce":  "(variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 4.0 && query.target_distance >= 2.0)) && query.modified_move_speed > 0.2"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.0)"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "howl":  "query.is_howling || (query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 30.0) > 26.0)"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "sniff":  "query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 18.0) > 13.0"
                                                                                                                                          }
                                                                                                                                      ],
                                                                                                                      "blend_transition":  0.15
                                                                                                                  },
                                                                                                      "attack":  {
                                                                                                                     "animations":  [
                                                                                                                                        "attack"
                                                                                                                                    ],
                                                                                                                     "transitions":  [
                                                                                                                                         {
                                                                                                                                             "default":  "query.state_time >= 0.5"
                                                                                                                                         }
                                                                                                                                     ],
                                                                                                                     "blend_transition":  0.15
                                                                                                                 },
                                                                                                      "howl":  {
                                                                                                                   "animations":  [
                                                                                                                                      "idle_howl"
                                                                                                                                  ],
                                                                                                                   "transitions":  [
                                                                                                                                       {
                                                                                                                                           "default":  "query.state_time >= 2.4"
                                                                                                                                       }
                                                                                                                                   ],
                                                                                                                   "blend_transition":  0.2
                                                                                                               },
                                                                                                      "pounce":  {
                                                                                                                     "animations":  [
                                                                                                                                        "pounce"
                                                                                                                                    ],
                                                                                                                     "transitions":  [
                                                                                                                                         {
                                                                                                                                             "default":  "query.state_time >= 1.0"
                                                                                                                                         }
                                                                                                                                     ],
                                                                                                                     "blend_transition":  0.15
                                                                                                                 },
                                                                                                      "hurt":  {
                                                                                                                   "animations":  [
                                                                                                                                      "hurt"
                                                                                                                                  ],
                                                                                                                   "transitions":  [
                                                                                                                                       {
                                                                                                                                           "default":  "query.state_time >= 0.4"
                                                                                                                                       }
                                                                                                                                   ],
                                                                                                                   "blend_transition":  0.1
                                                                                                               },
                                                                                                      "sniff":  {
                                                                                                                    "animations":  [
                                                                                                                                       "idle_sniff"
                                                                                                                                   ],
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "default":  "query.modified_move_speed > 0.02 || query.has_target || query.state_time >= 2.5"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.2
                                                                                                                }
                                                                                                  }
                                                                                   }
                              }
}