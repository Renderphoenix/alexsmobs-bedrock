{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.elephant.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walk": "query.modified_move_speed > 0.05 && query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking"
            },
            {
              "run": "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
            }
          ],
          "blend_transition": 0.2
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed <= 0.05"
            },
            {
              "run": "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
            }
          ],
          "blend_transition": 0.2
        },
        "run": {
          "animations": [
            "run"
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed <= 0.05"
            },
            {
              "walk": "query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking && query.modified_move_speed > 0.05"
            }
          ],
          "blend_transition": 0.2
        }
      }
    },
    "controller.animation.elephant.action": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "hurt": "query.is_hurt || (query.hurt_time > 0)"
            },
            {
              "attack": "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 3.5 && query.modified_move_speed < 0.25)"
            },
            {
              "trumpet": "variable.trumpet == 1"
            },
            {
              "eat": "query.is_eating"
            }
          ],
          "blend_transition": 0.15
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "transitions": [
            {
              "default": "query.state_time >= 0.45"
            }
          ],
          "blend_transition": 0.1
        },
        "attack": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "default": "query.state_time >= 1.2"
            }
          ],
          "blend_transition": 0.15
        },
        "trumpet": {
          "animations": [
            "trumpet"
          ],
          "transitions": [
            {
              "default": "query.state_time >= 2.2"
            }
          ],
          "blend_transition": 0.2
        },
        "eat": {
          "animations": [
            "eat"
          ],
          "transitions": [
            {
              "default": "!query.is_eating || query.state_time >= 3.0"
            }
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}