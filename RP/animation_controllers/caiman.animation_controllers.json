{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.caiman.move":  {
                                                                           "initial_state":  "idle",
                                                                           "states":  {
                                                                                          "idle":  {
                                                                                                       "animations":  [
                                                                                                                          "idle"
                                                                                                                      ],
                                                                                                       "transitions":  [
                                                                                                                           {
                                                                                                                               "swim":  "query.is_in_water"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "walk":  "query.modified_move_speed > 0.05 && query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                           }
                                                                                                                       ],
                                                                                                       "blend_transition":  0.2
                                                                                                   },
                                                                                          "walk":  {
                                                                                                       "animations":  [
                                                                                                                          "walk"
                                                                                                                      ],
                                                                                                       "transitions":  [
                                                                                                                           {
                                                                                                                               "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "swim":  "query.is_in_water"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                           }
                                                                                                                       ],
                                                                                                       "blend_transition":  0.2
                                                                                                   },
                                                                                          "run":  {
                                                                                                      "animations":  [
                                                                                                                         "run"
                                                                                                                     ],
                                                                                                      "transitions":  [
                                                                                                                          {
                                                                                                                              "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                          },
                                                                                                                          {
                                                                                                                              "swim":  "query.is_in_water"
                                                                                                                          },
                                                                                                                          {
                                                                                                                              "walk":  "query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking && query.modified_move_speed > 0.05"
                                                                                                                          }
                                                                                                                      ],
                                                                                                      "blend_transition":  0.2
                                                                                                  },
                                                                                          "swim":  {
                                                                                                       "animations":  [
                                                                                                                          "swim"
                                                                                                                      ],
                                                                                                       "transitions":  [
                                                                                                                           {
                                                                                                                               "idle":  "!query.is_in_water && query.modified_move_speed <= 0.05"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "walk":  "!query.is_in_water && query.modified_move_speed > 0.05 && query.modified_move_speed <= 0.4"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "run":  "!query.is_in_water && (query.modified_move_speed > 0.4 || query.has_target || query.is_panicking)"
                                                                                                                           }
                                                                                                                       ],
                                                                                                       "blend_transition":  0.2
                                                                                                   }
                                                                                      }
                                                                       },
                                  "controller.animation.caiman.action":  {
                                                                             "initial_state":  "default",
                                                                             "states":  {
                                                                                            "default":  {
                                                                                                            "transitions":  [
                                                                                                                                {
                                                                                                                                    "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "death_roll":  "query.is_in_water && (variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.5))"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "attack":  "!query.is_in_water && (variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.5))"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "bask":  "!query.is_in_water && query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 20.0) > 12.0"
                                                                                                                                }
                                                                                                                            ],
                                                                                                            "blend_transition":  0.15
                                                                                                        },
                                                                                            "attack":  {
                                                                                                           "animations":  [
                                                                                                                              "attack"
                                                                                                                          ],
                                                                                                           "transitions":  [
                                                                                                                               {
                                                                                                                                   "default":  "query.state_time >= 0.6"
                                                                                                                               }
                                                                                                                           ],
                                                                                                           "blend_transition":  0.15
                                                                                                       },
                                                                                            "hurt":  {
                                                                                                         "animations":  [
                                                                                                                            "hurt"
                                                                                                                        ],
                                                                                                         "transitions":  [
                                                                                                                             {
                                                                                                                                 "default":  "query.state_time >= 0.4"
                                                                                                                             }
                                                                                                                         ],
                                                                                                         "blend_transition":  0.1
                                                                                                     },
                                                                                            "death_roll":  {
                                                                                                               "animations":  [
                                                                                                                                  "death_roll"
                                                                                                                              ],
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "default":  "query.state_time >= 0.6"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.15
                                                                                                           },
                                                                                            "bask":  {
                                                                                                         "animations":  [
                                                                                                                            "idle_bask"
                                                                                                                        ],
                                                                                                         "transitions":  [
                                                                                                                             {
                                                                                                                                 "default":  "query.modified_move_speed > 0.02 || query.has_target || query.is_in_water || query.state_time >= 5.0"
                                                                                                                             }
                                                                                                                         ],
                                                                                                         "blend_transition":  0.2
                                                                                                     }
                                                                                        }
                                                                         }
                              }
}