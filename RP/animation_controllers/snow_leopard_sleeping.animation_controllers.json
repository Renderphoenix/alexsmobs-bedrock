{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.snow_leopard_sleeping.move":  {
                                                                                          "initial_state":  "idle",
                                                                                          "states":  {
                                                                                                         "idle":  {
                                                                                                                      "animations":  [
                                                                                                                                         "idle"
                                                                                                                                     ],
                                                                                                                      "transitions":  [
                                                                                                                                          {
                                                                                                                                              "walk":  "query.modified_move_speed > 0.05 && query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                          }
                                                                                                                                      ],
                                                                                                                      "blend_transition":  0.2
                                                                                                                  },
                                                                                                         "walk":  {
                                                                                                                      "animations":  [
                                                                                                                                         "walk"
                                                                                                                                     ],
                                                                                                                      "transitions":  [
                                                                                                                                          {
                                                                                                                                              "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "run":  "query.modified_move_speed > 0.4 || query.has_target || query.is_panicking"
                                                                                                                                          }
                                                                                                                                      ],
                                                                                                                      "blend_transition":  0.2
                                                                                                                  },
                                                                                                         "run":  {
                                                                                                                     "animations":  [
                                                                                                                                        "run"
                                                                                                                                    ],
                                                                                                                     "transitions":  [
                                                                                                                                         {
                                                                                                                                             "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                         },
                                                                                                                                         {
                                                                                                                                             "walk":  "query.modified_move_speed <= 0.4 && !query.has_target && !query.is_panicking && query.modified_move_speed > 0.05"
                                                                                                                                         }
                                                                                                                                     ],
                                                                                                                     "blend_transition":  0.2
                                                                                                                 }
                                                                                                     }
                                                                                      },
                                  "controller.animation.snow_leopard_sleeping.action":  {
                                                                                            "initial_state":  "default",
                                                                                            "states":  {
                                                                                                           "default":  {
                                                                                                                           "transitions":  [
                                                                                                                                               {
                                                                                                                                                   "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                               },
                                                                                                                                               {
                                                                                                                                                   "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.5)"
                                                                                                                                               },
                                                                                                                                               {
                                                                                                                                                   "crouch":  "query.has_target && query.target_distance >= 2.5 && query.target_distance < 7.0 && query.modified_move_speed < 0.25"
                                                                                                                                               },
                                                                                                                                               {
                                                                                                                                                   "sleep":  "query.is_sleeping"
                                                                                                                                               },
                                                                                                                                               {
                                                                                                                                                   "tail_hold":  "query.modified_move_speed <= 0.02 && !query.has_target && math.mod(query.life_time, 20.0) > 15.0"
                                                                                                                                               }
                                                                                                                                           ],
                                                                                                                           "blend_transition":  0.15
                                                                                                                       },
                                                                                                           "attack":  {
                                                                                                                          "animations":  [
                                                                                                                                             "attack"
                                                                                                                                         ],
                                                                                                                          "transitions":  [
                                                                                                                                              {
                                                                                                                                                  "default":  "query.state_time >= 0.7"
                                                                                                                                              }
                                                                                                                                          ],
                                                                                                                          "blend_transition":  0.15
                                                                                                                      },
                                                                                                           "sleep":  {
                                                                                                                         "animations":  [
                                                                                                                                            "idle_sleep"
                                                                                                                                        ],
                                                                                                                         "transitions":  [
                                                                                                                                             {
                                                                                                                                                 "default":  "!query.is_sleeping || query.modified_move_speed > 0.05"
                                                                                                                                             }
                                                                                                                                         ],
                                                                                                                         "blend_transition":  0.2
                                                                                                                     },
                                                                                                           "tail_hold":  {
                                                                                                                             "animations":  [
                                                                                                                                                "idle_tail_hold"
                                                                                                                                            ],
                                                                                                                             "transitions":  [
                                                                                                                                                 {
                                                                                                                                                     "default":  "query.modified_move_speed > 0.02 || query.has_target || query.state_time >= 3.0"
                                                                                                                                                 }
                                                                                                                                             ],
                                                                                                                             "blend_transition":  0.2
                                                                                                                         },
                                                                                                           "hurt":  {
                                                                                                                        "animations":  [
                                                                                                                                           "hurt"
                                                                                                                                       ],
                                                                                                                        "transitions":  [
                                                                                                                                            {
                                                                                                                                                "default":  "query.state_time >= 0.45"
                                                                                                                                            }
                                                                                                                                        ],
                                                                                                                        "blend_transition":  0.1
                                                                                                                    },
                                                                                                           "crouch":  {
                                                                                                                          "animations":  [
                                                                                                                                             "idle_crouch"
                                                                                                                                         ],
                                                                                                                          "transitions":  [
                                                                                                                                              {
                                                                                                                                                  "default":  "!query.has_target || query.target_distance < 2.5 || query.modified_move_speed >= 0.25"
                                                                                                                                              }
                                                                                                                                          ],
                                                                                                                          "blend_transition":  0.2
                                                                                                                      }
                                                                                                       }
                                                                                        }
                              }
}