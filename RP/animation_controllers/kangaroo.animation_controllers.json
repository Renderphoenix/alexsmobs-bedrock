{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.kangaroo.move": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        "idle"
                    ],
                    "transitions": [
                        {
                            "run": "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.ground_speed > 1.2 || math.mod(query.life_time + query.entity_id, 12.0) > 8.0)"
                        },
                        {
                            "walk": "query.is_moving || query.ground_speed > 0.1"
                        },
                        {
                            "graze": "!query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time * 0.15 + query.entity_id, 16.0) > 11.0"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "walk": {
                    "animations": [
                        "walk"
                    ],
                    "transitions": [
                        {
                            "idle": "!query.is_moving && query.ground_speed <= 0.05"
                        },
                        {
                            "run": "query.has_target || query.is_panicking || query.ground_speed > 1.2 || (query.is_moving && math.mod(query.life_time + query.entity_id, 12.0) > 8.0)"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "run": {
                    "animations": [
                        "run"
                    ],
                    "transitions": [
                        {
                            "idle": "!query.is_moving && query.ground_speed <= 0.05"
                        },
                        {
                            "walk": "!query.has_target && !query.is_panicking && query.ground_speed <= 1.2 && math.mod(query.life_time + query.entity_id, 12.0) <= 8.0"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "graze": {
                    "animations": [
                        "idle_graze"
                    ],
                    "transitions": [
                        {
                            "run": "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.ground_speed > 1.2)"
                        },
                        {
                            "walk": "query.is_moving || query.ground_speed > 0.1"
                        },
                        {
                            "idle": "query.state_time >= 4.0 || query.has_target || query.is_hurt"
                        }
                    ],
                    "blend_transition": 0.25
                }
            }
        },
        "controller.animation.kangaroo.action": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "hurt": "query.is_hurt || (query.hurt_time > 0)"
                        },
                        {
                            "dropkick": "query.is_delayed_attacking && (query.is_moving || query.ground_speed > 1.0 || query.is_jumping)"
                        },
                        {
                            "box": "query.is_delayed_attacking"
                        }
                    ],
                    "blend_transition": 0.15
                },
                "hurt": {
                    "animations": [
                        "hurt"
                    ],
                    "transitions": [
                        {
                            "default": "query.state_time >= 0.4"
                        }
                    ],
                    "blend_transition": 0.1
                },
                "box": {
                    "animations": [
                        "box"
                    ],
                    "transitions": [
                        {
                            "default": "!query.is_delayed_attacking || query.state_time >= 0.6"
                        }
                    ],
                    "blend_transition": 0.15
                },
                "dropkick": {
                    "animations": [
                        "dropkick"
                    ],
                    "transitions": [
                        {
                            "default": "!query.is_delayed_attacking || query.state_time >= 0.8"
                        }
                    ],
                    "blend_transition": 0.15
                }
            }
        }
    }
}
