{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.alligator_snapping_turtle_moss.move":  {
                                                                                                   "initial_state":  "idle",
                                                                                                   "states":  {
                                                                                                                  "idle":  {
                                                                                                                               "animations":  [
                                                                                                                                                  "idle"
                                                                                                                                              ],
                                                                                                                               "transitions":  [
                                                                                                                                                   {
                                                                                                                                                       "swim":  "query.is_in_water"
                                                                                                                                                   },
                                                                                                                                                   {
                                                                                                                                                       "walk":  "query.modified_move_speed > 0.05"
                                                                                                                                                   }
                                                                                                                                               ],
                                                                                                                               "blend_transition":  0.2
                                                                                                                           },
                                                                                                                  "walk":  {
                                                                                                                               "animations":  [
                                                                                                                                                  "walk"
                                                                                                                                              ],
                                                                                                                               "transitions":  [
                                                                                                                                                   {
                                                                                                                                                       "idle":  "query.modified_move_speed <= 0.05"
                                                                                                                                                   },
                                                                                                                                                   {
                                                                                                                                                       "swim":  "query.is_in_water"
                                                                                                                                                   }
                                                                                                                                               ],
                                                                                                                               "blend_transition":  0.2
                                                                                                                           },
                                                                                                                  "swim":  {
                                                                                                                               "animations":  [
                                                                                                                                                  "swim"
                                                                                                                                              ],
                                                                                                                               "transitions":  [
                                                                                                                                                   {
                                                                                                                                                       "idle":  "!query.is_in_water && query.modified_move_speed <= 0.05"
                                                                                                                                                   },
                                                                                                                                                   {
                                                                                                                                                       "walk":  "!query.is_in_water && query.modified_move_speed > 0.05"
                                                                                                                                                   }
                                                                                                                                               ],
                                                                                                                               "blend_transition":  0.2
                                                                                                                           }
                                                                                                              }
                                                                                               },
                                  "controller.animation.alligator_snapping_turtle_moss.action":  {
                                                                                                     "initial_state":  "default",
                                                                                                     "states":  {
                                                                                                                    "default":  {
                                                                                                                                    "transitions":  [
                                                                                                                                                        {
                                                                                                                                                            "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                                        },
                                                                                                                                                        {
                                                                                                                                                            "attack":  "variable.attack_time > 0 || query.is_delayed_attacking || (query.has_target && query.target_distance < 2.5 && query.modified_move_speed < 0.25)"
                                                                                                                                                        },
                                                                                                                                                        {
                                                                                                                                                            "retract":  "query.health <= 6 || query.is_sitting"
                                                                                                                                                        },
                                                                                                                                                        {
                                                                                                                                                            "lure":  "query.modified_move_speed <= 0.01 && !query.has_target && math.mod(query.life_time, 14.0) > 8.0"
                                                                                                                                                        }
                                                                                                                                                    ],
                                                                                                                                    "blend_transition":  0.15
                                                                                                                                },
                                                                                                                    "attack":  {
                                                                                                                                   "animations":  [
                                                                                                                                                      "attack"
                                                                                                                                                  ],
                                                                                                                                   "transitions":  [
                                                                                                                                                       {
                                                                                                                                                           "default":  "query.state_time >= 0.5"
                                                                                                                                                       }
                                                                                                                                                   ],
                                                                                                                                   "blend_transition":  0.15
                                                                                                                               },
                                                                                                                    "lure":  {
                                                                                                                                 "animations":  [
                                                                                                                                                    "idle_lure"
                                                                                                                                                ],
                                                                                                                                 "transitions":  [
                                                                                                                                                     {
                                                                                                                                                         "default":  "query.modified_move_speed > 0.01 || query.has_target || math.mod(query.life_time, 14.0) <= 8.0"
                                                                                                                                                     }
                                                                                                                                                 ],
                                                                                                                                 "blend_transition":  0.2
                                                                                                                             },
                                                                                                                    "hurt":  {
                                                                                                                                 "animations":  [
                                                                                                                                                    "hurt"
                                                                                                                                                ],
                                                                                                                                 "transitions":  [
                                                                                                                                                     {
                                                                                                                                                         "default":  "query.state_time >= 0.4"
                                                                                                                                                     }
                                                                                                                                                 ],
                                                                                                                                 "blend_transition":  0.1
                                                                                                                             },
                                                                                                                    "retract":  {
                                                                                                                                    "animations":  [
                                                                                                                                                       "retract"
                                                                                                                                                   ],
                                                                                                                                    "transitions":  [
                                                                                                                                                        {
                                                                                                                                                            "default":  "!(query.health <= 6 || query.is_sitting) || query.modified_move_speed > 0.05"
                                                                                                                                                        }
                                                                                                                                                    ],
                                                                                                                                    "blend_transition":  0.2
                                                                                                                                }
                                                                                                                }
                                                                                                 }
                              }
}