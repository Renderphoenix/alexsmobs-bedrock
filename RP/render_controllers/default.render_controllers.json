{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.default": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    },
    "controller.render.variant": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.textures[query.variant]"
      ]
    },
    "controller.render.bison": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Texture.baby : (query.is_sheared ? Texture.sheared : Texture.default)"
      ]
    }
  }
}