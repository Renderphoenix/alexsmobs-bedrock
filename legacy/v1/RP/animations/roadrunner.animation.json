{
  "format_version": "1.8.0",
  "animations": {
    "animation.roadrunner.walk": {
      "anim_time_update": "query.modified_distance_moved",
      "loop": true,
      "bones": {
        "left_leg": {
          "rotation": [
            "(math.cos(query.anim_time * 38.17) * 40.0)",
            0,
            0
          ]
        },
        "right_leg": {
          "rotation": [
            "-(math.cos(query.anim_time * 38.17) * 40.0)",
            0,
            0
          ]
        },
        "tail": {
          "rotation": [
            0,
            "(math.cos(query.anim_time * 38.17) * 18.0)",
            0
          ]
        },
        "left_wing": {
          "rotation": [
            0,
            0,
            "(math.cos(query.anim_time * 45.0) * 35.0)"
          ]
        },
        "right_wing": {
          "rotation": [
            0,
            0,
            "-(math.cos(query.anim_time * 45.0) * 35.0)"
          ]
        }
      }
    },
    "animation.roadrunner.idle": {
      "loop": true,
      "bones": {
        "neck": {
          "rotation": [
            "math.clamp(query.target_x_rotation, -30.0, 30.0) + (math.sin(query.anim_time * 20.0) * 1.5)",
            "math.clamp(query.target_y_rotation, -45.0, 45.0)",
            0
          ]
        }
      }
    }
  }
}