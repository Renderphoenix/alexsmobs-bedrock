{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.alligator_snapping_turtle.move":  {
                                                                                              "initial_state":  "idle",
                                                                                              "states":  {
                                                                                                             "idle":  {
                                                                                                                          "animations":  [
                                                                                                                                             "idle"
                                                                                                                                         ],
                                                                                                                          "transitions":  [
                                                                                                                                              {
                                                                                                                                                  "swim":  "query.is_in_water && (query.is_moving || query.ground_speed > 0.05)"
                                                                                                                                              },
                                                                                                                                              {
                                                                                                                                                  "walk":  "query.is_moving || query.ground_speed > 0.05"
                                                                                                                                              },
                                                                                                                                              {
                                                                                                                                                  "retract":  "!query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time * 0.1 + query.entity_id, 20.0) > 14.0"
                                                                                                                                              }
                                                                                                                                          ],
                                                                                                                          "blend_transition":  0.2
                                                                                                                      },
                                                                                                             "walk":  {
                                                                                                                          "animations":  [
                                                                                                                                             "walk"
                                                                                                                                         ],
                                                                                                                          "transitions":  [
                                                                                                                                              {
                                                                                                                                                  "swim":  "query.is_in_water"
                                                                                                                                              },
                                                                                                                                              {
                                                                                                                                                  "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                              }
                                                                                                                                          ],
                                                                                                                          "blend_transition":  0.2
                                                                                                                      },
                                                                                                             "swim":  {
                                                                                                                          "animations":  [
                                                                                                                                             "swim"
                                                                                                                                         ],
                                                                                                                          "transitions":  [
                                                                                                                                              {
                                                                                                                                                  "idle":  "!query.is_in_water && !query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                              },
                                                                                                                                              {
                                                                                                                                                  "walk":  "!query.is_in_water && query.is_moving"
                                                                                                                                              }
                                                                                                                                          ],
                                                                                                                          "blend_transition":  0.2
                                                                                                                      },
                                                                                                             "retract":  {
                                                                                                                             "animations":  [
                                                                                                                                                "retract"
                                                                                                                                            ],
                                                                                                                             "transitions":  [
                                                                                                                                                 {
                                                                                                                                                     "swim":  "query.is_in_water && query.is_moving"
                                                                                                                                                 },
                                                                                                                                                 {
                                                                                                                                                     "walk":  "query.is_moving || query.ground_speed > 0.05"
                                                                                                                                                 },
                                                                                                                                                 {
                                                                                                                                                     "idle":  "query.state_time >= 6.0 || query.has_target || query.is_hurt"
                                                                                                                                                 }
                                                                                                                                             ],
                                                                                                                             "blend_transition":  0.2
                                                                                                                         }
                                                                                                         }
                                                                                          },
                                  "controller.animation.alligator_snapping_turtle.action":  {
                                                                                                "initial_state":  "default",
                                                                                                "states":  {
                                                                                                               "default":  {
                                                                                                                               "transitions":  [
                                                                                                                                                   {
                                                                                                                                                       "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                                   },
                                                                                                                                                   {
                                                                                                                                                       "attack":  "query.is_delayed_attacking"
                                                                                                                                                   },
                                                                                                                                                   {
                                                                                                                                                       "lure":  "!query.is_delayed_attacking && !query.is_moving && query.ground_speed <= 0.05 && math.mod(query.life_time, 20.0) > 16.0"
                                                                                                                                                   }
                                                                                                                                               ],
                                                                                                                               "blend_transition":  0.15
                                                                                                                           },
                                                                                                               "hurt":  {
                                                                                                                            "animations":  [
                                                                                                                                               "hurt"
                                                                                                                                           ],
                                                                                                                            "transitions":  [
                                                                                                                                                {
                                                                                                                                                    "default":  "query.state_time >= 0.4"
                                                                                                                                                }
                                                                                                                                            ],
                                                                                                                            "blend_transition":  0.1
                                                                                                                        },
                                                                                                               "attack":  {
                                                                                                                              "animations":  [
                                                                                                                                                 "attack"
                                                                                                                                             ],
                                                                                                                              "transitions":  [
                                                                                                                                                  {
                                                                                                                                                      "default":  "query.state_time >= 0.5 || !query.is_delayed_attacking"
                                                                                                                                                  }
                                                                                                                                              ],
                                                                                                                              "blend_transition":  0.15
                                                                                                                          },
                                                                                                               "lure":  {
                                                                                                                            "animations":  [
                                                                                                                                               "idle_lure"
                                                                                                                                           ],
                                                                                                                            "transitions":  [
                                                                                                                                                {
                                                                                                                                                    "default":  "(query.state_time >= 3.0 || query.is_moving || query.has_target || query.is_hurt) || query.is_moving || query.is_delayed_attacking || query.is_hurt"
                                                                                                                                                }
                                                                                                                                            ],
                                                                                                                            "blend_transition":  0.2
                                                                                                                        }
                                                                                                           }
                                                                                            }
                              }
}