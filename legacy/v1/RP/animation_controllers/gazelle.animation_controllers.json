{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.gazelle.move":  {
                                                                            "initial_state":  "idle",
                                                                            "states":  {
                                                                                           "idle":  {
                                                                                                        "animations":  [
                                                                                                                           "idle"
                                                                                                                       ],
                                                                                                        "transitions":  [
                                                                                                                            {
                                                                                                                                "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                            },
                                                                                                                            {
                                                                                                                                "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                            },
                                                                                                                            {
                                                                                                                                "graze":  "!query.is_moving && query.ground_speed <= 0.05 && !query.has_target && math.mod(query.life_time * 0.15 + query.entity_id, 16.0) > 10.0"
                                                                                                                            }
                                                                                                                        ],
                                                                                                        "blend_transition":  0.2
                                                                                                    },
                                                                                           "walk":  {
                                                                                                        "animations":  [
                                                                                                                           "walk"
                                                                                                                       ],
                                                                                                        "transitions":  [
                                                                                                                            {
                                                                                                                                "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                            },
                                                                                                                            {
                                                                                                                                "run":  "query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0"
                                                                                                                            }
                                                                                                                        ],
                                                                                                        "blend_transition":  0.2
                                                                                                    },
                                                                                           "run":  {
                                                                                                       "animations":  [
                                                                                                                          "run"
                                                                                                                      ],
                                                                                                       "transitions":  [
                                                                                                                           {
                                                                                                                               "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                           },
                                                                                                                           {
                                                                                                                               "walk":  "!query.has_target && !query.is_panicking && !query.is_sprinting && query.ground_speed <= 2.0 && math.mod(query.life_time + query.entity_id, 10.0) <= 6.0"
                                                                                                                           }
                                                                                                                       ],
                                                                                                       "blend_transition":  0.2
                                                                                                   },
                                                                                           "graze":  {
                                                                                                         "animations":  [
                                                                                                                            "idle_graze"
                                                                                                                        ],
                                                                                                         "transitions":  [
                                                                                                                             {
                                                                                                                                 "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                             },
                                                                                                                             {
                                                                                                                                 "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                             },
                                                                                                                             {
                                                                                                                                 "idle":  "query.state_time >= 5.0 || query.has_target || query.is_hurt"
                                                                                                                             }
                                                                                                                         ],
                                                                                                         "blend_transition":  0.25
                                                                                                     }
                                                                                       }
                                                                        },
                                  "controller.animation.gazelle.action":  {
                                                                              "initial_state":  "default",
                                                                              "states":  {
                                                                                             "default":  {
                                                                                                             "transitions":  [
                                                                                                                                 {
                                                                                                                                     "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                 },
                                                                                                                                 {
                                                                                                                                     "alert":  "query.has_target || (!query.is_moving && query.ground_speed <= 0.05 && math.mod(query.life_time * 0.15 + query.entity_id, 16.0) > 12.0)"
                                                                                                                                 }
                                                                                                                             ],
                                                                                                             "blend_transition":  0.15
                                                                                                         },
                                                                                             "hurt":  {
                                                                                                          "animations":  [
                                                                                                                             "hurt"
                                                                                                                         ],
                                                                                                          "transitions":  [
                                                                                                                              {
                                                                                                                                  "default":  "query.state_time >= 0.4"
                                                                                                                              }
                                                                                                                          ],
                                                                                                          "blend_transition":  0.1
                                                                                                      },
                                                                                             "alert":  {
                                                                                                           "animations":  [
                                                                                                                              "idle_alert"
                                                                                                                          ],
                                                                                                           "transitions":  [
                                                                                                                               {
                                                                                                                                   "default":  "query.state_time >= 2.5 || query.is_moving || query.is_hurt"
                                                                                                                               }
                                                                                                                           ],
                                                                                                           "blend_transition":  0.2
                                                                                                       }
                                                                                         }
                                                                          }
                              }
}