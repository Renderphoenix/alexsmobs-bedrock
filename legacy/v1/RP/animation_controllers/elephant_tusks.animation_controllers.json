{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.elephant_tusks.move":  {
                                                                                   "initial_state":  "idle",
                                                                                   "states":  {
                                                                                                  "idle":  {
                                                                                                               "animations":  [
                                                                                                                                  "idle"
                                                                                                                              ],
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                                   },
                                                                                                                                   {
                                                                                                                                       "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.2
                                                                                                           },
                                                                                                  "walk":  {
                                                                                                               "animations":  [
                                                                                                                                  "walk"
                                                                                                                              ],
                                                                                                               "transitions":  [
                                                                                                                                   {
                                                                                                                                       "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                   },
                                                                                                                                   {
                                                                                                                                       "run":  "query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 2.0 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0"
                                                                                                                                   }
                                                                                                                               ],
                                                                                                               "blend_transition":  0.2
                                                                                                           },
                                                                                                  "run":  {
                                                                                                              "animations":  [
                                                                                                                                 "run"
                                                                                                                             ],
                                                                                                              "transitions":  [
                                                                                                                                  {
                                                                                                                                      "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                  },
                                                                                                                                  {
                                                                                                                                      "walk":  "!query.has_target && !query.is_panicking && !query.is_sprinting && query.ground_speed <= 2.0 && math.mod(query.life_time + query.entity_id, 10.0) <= 6.0"
                                                                                                                                  }
                                                                                                                              ],
                                                                                                              "blend_transition":  0.2
                                                                                                          }
                                                                                              }
                                                                               },
                                  "controller.animation.elephant_tusks.action":  {
                                                                                     "initial_state":  "default",
                                                                                     "states":  {
                                                                                                    "default":  {
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "attack":  "query.is_delayed_attacking"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "trumpet":  "!query.is_delayed_attacking && !query.is_moving && query.ground_speed <= 0.05 && math.mod(query.life_time, 60.0) > 57.0"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.15
                                                                                                                },
                                                                                                    "hurt":  {
                                                                                                                 "animations":  [
                                                                                                                                    "hurt"
                                                                                                                                ],
                                                                                                                 "transitions":  [
                                                                                                                                     {
                                                                                                                                         "default":  "query.state_time >= 0.4"
                                                                                                                                     }
                                                                                                                                 ],
                                                                                                                 "blend_transition":  0.1
                                                                                                             },
                                                                                                    "attack":  {
                                                                                                                   "animations":  [
                                                                                                                                      "attack"
                                                                                                                                  ],
                                                                                                                   "transitions":  [
                                                                                                                                       {
                                                                                                                                           "default":  "query.state_time >= 1.2 || (!query.is_delayed_attacking && query.state_time >= 0.5)"
                                                                                                                                       }
                                                                                                                                   ],
                                                                                                                   "blend_transition":  0.15
                                                                                                               },
                                                                                                    "trumpet":  {
                                                                                                                    "animations":  [
                                                                                                                                       "trumpet"
                                                                                                                                   ],
                                                                                                                    "transitions":  [
                                                                                                                                        {
                                                                                                                                            "default":  "query.state_time >= 2.0 || query.is_moving || query.is_hurt"
                                                                                                                                        }
                                                                                                                                    ],
                                                                                                                    "blend_transition":  0.2
                                                                                                                },
                                                                                                    "eat":  {
                                                                                                                "animations":  [
                                                                                                                                   "eat"
                                                                                                                               ],
                                                                                                                "transitions":  [
                                                                                                                                    {
                                                                                                                                        "default":  "query.state_time >= 1.5"
                                                                                                                                    }
                                                                                                                                ],
                                                                                                                "blend_transition":  0.15
                                                                                                            }
                                                                                                }
                                                                                 }
                              }
}
