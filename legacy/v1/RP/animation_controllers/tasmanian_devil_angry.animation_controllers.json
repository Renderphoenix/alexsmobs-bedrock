{
    "format_version":  "1.10.0",
    "animation_controllers":  {
                                  "controller.animation.tasmanian_devil_angry.move":  {
                                                                                          "initial_state":  "idle",
                                                                                          "states":  {
                                                                                                         "idle":  {
                                                                                                                      "animations":  [
                                                                                                                                         "idle"
                                                                                                                                     ],
                                                                                                                      "transitions":  [
                                                                                                                                          {
                                                                                                                                              "run":  "(query.is_moving || query.ground_speed > 0.1) && (query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 1.2 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0)"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "walk":  "query.is_moving || query.ground_speed > 0.1"
                                                                                                                                          }
                                                                                                                                      ],
                                                                                                                      "blend_transition":  0.2
                                                                                                                  },
                                                                                                         "walk":  {
                                                                                                                      "animations":  [
                                                                                                                                         "walk"
                                                                                                                                     ],
                                                                                                                      "transitions":  [
                                                                                                                                          {
                                                                                                                                              "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                          },
                                                                                                                                          {
                                                                                                                                              "run":  "query.has_target || query.is_panicking || query.is_sprinting || query.ground_speed > 1.2 || math.mod(query.life_time + query.entity_id, 10.0) > 6.0"
                                                                                                                                          }
                                                                                                                                      ],
                                                                                                                      "blend_transition":  0.2
                                                                                                                  },
                                                                                                         "run":  {
                                                                                                                     "animations":  [
                                                                                                                                        "run"
                                                                                                                                    ],
                                                                                                                     "transitions":  [
                                                                                                                                         {
                                                                                                                                             "idle":  "!query.is_moving && query.ground_speed <= 0.05"
                                                                                                                                         },
                                                                                                                                         {
                                                                                                                                             "walk":  "!query.has_target && !query.is_panicking && !query.is_sprinting && query.ground_speed <= 1.2 && math.mod(query.life_time + query.entity_id, 10.0) <= 6.0"
                                                                                                                                         }
                                                                                                                                     ],
                                                                                                                     "blend_transition":  0.2
                                                                                                                 }
                                                                                                     }
                                                                                      },
                                  "controller.animation.tasmanian_devil_angry.action":  {
                                                                                            "initial_state":  "default",
                                                                                            "states":  {
                                                                                                           "default":  {
                                                                                                                           "transitions":  [
                                                                                                                                               {
                                                                                                                                                   "hurt":  "query.is_hurt || (query.hurt_time > 0)"
                                                                                                                                               },
                                                                                                                                               {
                                                                                                                                                   "spin":  "!query.is_delayed_attacking && !query.is_moving && query.ground_speed <= 0.05 && math.mod(query.life_time, 25.0) > 22.0"
                                                                                                                                               },
                                                                                                                                               {
                                                                                                                                                   "attack":  "query.is_delayed_attacking"
                                                                                                                                               },
                                                                                                                                               {
                                                                                                                                                   "yawn":  "!query.is_delayed_attacking && !query.is_moving && query.ground_speed <= 0.05 && math.mod(query.life_time, 35.0) > 31.0"
                                                                                                                                               },
                                                                                                                                               {
                                                                                                                                                   "sniff":  "!query.is_delayed_attacking && !query.is_moving && query.ground_speed <= 0.05 && math.mod(query.life_time, 25.0) > 21.0"
                                                                                                                                               }
                                                                                                                                           ],
                                                                                                                           "blend_transition":  0.15
                                                                                                                       },
                                                                                                           "hurt":  {
                                                                                                                        "animations":  [
                                                                                                                                           "hurt"
                                                                                                                                       ],
                                                                                                                        "transitions":  [
                                                                                                                                            {
                                                                                                                                                "default":  "query.state_time >= 0.4"
                                                                                                                                            }
                                                                                                                                        ],
                                                                                                                        "blend_transition":  0.1
                                                                                                                    },
                                                                                                           "attack":  {
                                                                                                                          "animations":  [
                                                                                                                                             "attack"
                                                                                                                                         ],
                                                                                                                          "transitions":  [
                                                                                                                                              {
                                                                                                                                                  "default":  "query.state_time >= 0.55 || !query.is_delayed_attacking"
                                                                                                                                              }
                                                                                                                                          ],
                                                                                                                          "blend_transition":  0.15
                                                                                                                      },
                                                                                                           "spin":  {
                                                                                                                        "animations":  [
                                                                                                                                           "spin"
                                                                                                                                       ],
                                                                                                                        "transitions":  [
                                                                                                                                            {
                                                                                                                                                "default":  "(query.state_time >= 1.2 || query.is_hurt) || query.is_moving || query.is_delayed_attacking || query.is_hurt"
                                                                                                                                            }
                                                                                                                                        ],
                                                                                                                        "blend_transition":  0.15
                                                                                                                    },
                                                                                                           "yawn":  {
                                                                                                                        "animations":  [
                                                                                                                                           "idle_yawn"
                                                                                                                                       ],
                                                                                                                        "transitions":  [
                                                                                                                                            {
                                                                                                                                                "default":  "(query.state_time >= 2.0 || query.is_moving || query.has_target || query.is_hurt) || query.is_moving || query.is_delayed_attacking || query.is_hurt"
                                                                                                                                            }
                                                                                                                                        ],
                                                                                                                        "blend_transition":  0.2
                                                                                                                    },
                                                                                                           "sniff":  {
                                                                                                                         "animations":  [
                                                                                                                                            "idle_sniff"
                                                                                                                                        ],
                                                                                                                         "transitions":  [
                                                                                                                                             {
                                                                                                                                                 "default":  "(query.state_time >= 1.8 || query.is_moving || query.has_target || query.is_hurt) || query.is_moving || query.is_delayed_attacking || query.is_hurt"
                                                                                                                                             }
                                                                                                                                         ],
                                                                                                                         "blend_transition":  0.2
                                                                                                                     }
                                                                                                       }
                                                                                        }
                              }
}